            "state": "translated",
            "value": "Nama maksimum 80 aksara. Token tamat tempoh 90 hari selepas dicipta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam mag maximaal 80 tekens bevatten. Het token verloopt 90 dagen na aanmaken."
          }
        }
      }
