        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état de connexion a changé. Fermez ce brouillon, puis rouvrez-le."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado de login mudou. Feche este rascunho e abra novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status masuk telah berubah. Tutup draf ini, lalu buka kembali."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
