    "將從「%@」建立新群組，不會覆寫現有群組。": {
      "comment": "native.tripDataToolsView.restoreName. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將從「%1$@」建立新群組，不會覆寫現有群組。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new group will be created from “%1$@”. Existing groups will not be overwritten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」から新しいグループを作成します。既存のグループは上書きしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’에서 새 그룹을 만들며 기존 그룹은 덮어쓰지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” से नया समूह बनेगा; मौजूदा समूह के ऊपर नहीं लिखा जाएगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se creará un grupo nuevo a partir de «%1$@», sin sobrescribir los grupos existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau groupe sera créé à partir de « %1$@ », sans écraser les groupes existants."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo grupo será criado a partir de “%1$@”, sem sobrescrever os grupos existentes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup baru akan dibuat dari “%1$@” tanpa menimpa grup yang ada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus „%1$@“ wird eine neue Gruppe erstellt. Vorhandene Gruppen werden nicht überschrieben."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ tạo nhóm mới từ “%1$@”, không ghi đè nhóm hiện có."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” yedeğinden yeni grup oluşturulacak; mevcut grupların üzerine yazılmayacak."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagawa ng bagong grupo mula sa “%1$@” nang hindi pinapatungan ang umiiral na grupo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะสร้างกลุ่มใหม่จาก “%1$@” โดยไม่เขียนทับกลุ่มที่มีอยู่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà creato un nuovo gruppo da «%1$@», senza sovrascrivere i gruppi esistenti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z „%1$@” zostanie utworzona nowa grupa, bez nadpisania istniejących grup."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpulan baharu akan dicipta daripada “%1$@” tanpa menulis ganti kumpulan sedia ada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een nieuwe groep gemaakt vanuit ‘%1$@’. Bestaande groepen worden niet overschreven."
          }
        }
      }
    },
