          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanggang 10 tag lamang, na hanggang 24 karakter bawat isa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแท็กได้ไม่เกิน 10 แท็ก แต่ละแท็กไม่เกิน 24 ตัวอักษร"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo 10 etichette, ciascuna di massimo 24 caratteri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozwolone jest najwyżej 10 etykiet, każda o długości do 24 znaków."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimum 10 tag, setiap satu maksimum 24 aksara."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal 10 labels, elk maximaal 24 tekens."
          }
        }
      }
    },
    "已移除不存在的分攤成員。請選擇有效付款人並手動修正分攤金額；未自動重分配。": {
      "comment": "native.expenseEditorState.missingParticipantsRemoved. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除不存在的分攤成員。請選擇有效付款人並手動修正分攤金額；未自動重分配。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing split participants have been removed. Select a valid payer and correct split amounts manually. No automatic redistribution was made."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "存在しない分担者を削除しました。有効な支払者を選び、分担金額を手動で修正してください。自動の再配分はしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "존재하지 않는 분담 구성원을 제거했습니다. 유효한 결제자를 선택하고 분담 금액을 직접 수정하세요. 자동 재분배는 하지 않았습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूद न होने वाले हिस्सेदार हटाए गए। मान्य भुगतानकर्ता चुनें और हिस्सों की राशियाँ खुद सुधारें; अपने आप दोबारा बाँटी नहीं गई हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado del reparto los miembros inexistentes. Selecciona un pagador válido y corrige manualmente los importes del reparto; no se han redistribuido automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres inexistants ont été retirés du partage. Choisissez un payeur valide et corrigez manuellement les montants du partage ; aucune redistribution automatique n’a été effectuée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os membros inexistentes foram removidos do rateio. Selecione um pagador válido e corrija manualmente os valores do rateio; não houve redistribuição automática."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggota pembagian yang tidak ada telah dihapus. Pilih pembayar yang valid dan koreksi jumlah pembagian secara manual; tidak ada pembagian ulang otomatis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht mehr vorhandene Teilnehmer wurden aus der Aufteilung entfernt. Wähle einen gültigen Zahler und korrigiere die Anteile manuell. Es erfolgte keine automatische Neuverteilung."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa thành viên chia khoản chi không còn tồn tại. Hãy chọn người trả hợp lệ và tự sửa số tiền chia; không tự phân chia lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut olmayan paylaşan üyeler kaldırıldı. Geçerli bir ödeyen seçin ve paylaşım tutarlarını elle düzeltin; otomatik yeniden dağıtım yapılmadı."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naalis ang mga kabahaging wala na. Pumili ng wastong nagbayad at manu-manong itama ang mga bahagi; hindi awtomatikong muling ipinamahagi ang mga ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำผู้ร่วมแบ่งที่ไม่มีอยู่ออกแล้ว โปรดเลือกผู้จ่ายที่มีอยู่และแก้ไขส่วนแบ่งด้วยตนเอง ยังไม่มีการแบ่งใหม่โดยอัตโนมัติ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I partecipanti inesistenti sono stati rimossi dalla divisione. Scegli un pagatore valido e correggi manualmente gli importi. Non è stata eseguita alcuna ridistribuzione automatica."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto nieistniejące osoby z podziału. Wybierz poprawnego płatnika i ręcznie popraw kwoty podziału. Nie przeprowadzono automatycznego ponownego podziału."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahli perkongsian yang tidak wujud telah dialih keluar. Pilih pembayar yang sah dan betulkan amaun perkongsian secara manual; tiada pengagihan semula automatik dilakukan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet-bestaande deelnemers zijn uit de verdeling verwijderd. Kies een geldige betaler en corrigeer de bedragen handmatig. Er is niet automatisch herverdeeld."
          }
        }
      }
    },
    "已儲存的分攤設定不適用於目前成員，改用目前成員平均分攤。幣別已保留。": {
      "comment": "native.expenseEditorState.defaultsAdjusted. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的分攤設定不適用於目前成員，改用目前成員平均分攤。幣別已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved split settings do not apply to the current members. An equal split among current members is used instead. The currency has been retained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの分担設定は現在のメンバーには適用できないため、現在のメンバーでの均等分担に変更しました。通貨は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 분담 설정을 현재 구성원에게 적용할 수 없어 현재 구성원의 균등 분담으로 변경했습니다. 통화는 유지했습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई बाँटने की सेटिंग वर्तमान सदस्यों के लिए लागू नहीं है, इसलिए वर्तमान सदस्यों में बराबर बाँटा गया है। मुद्रा रखी गई है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración guardada del reparto no es válida para los miembros actuales. Se ha cambiado a un reparto a partes iguales entre ellos. Se ha conservado la moneda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres de partage enregistrés ne conviennent pas aux membres actuels. Le partage à parts égales entre les membres actuels est utilisé à la place. La devise est conservée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração de rateio salva não se aplica aos membros atuais. Foi usado o rateio em partes iguais entre os membros atuais. A moeda foi mantida."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan pembagian tersimpan tidak berlaku untuk anggota saat ini. Pembagian rata digunakan untuk anggota saat ini. Mata uang dipertahankan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Aufteilung passt nicht zu den aktuellen Mitgliedern. Stattdessen wird gleichmäßig unter den aktuellen Mitgliedern aufgeteilt. Die Währung wurde beibehalten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt chia đã lưu không phù hợp với thành viên hiện tại, nên đã chuyển sang chia đều cho thành viên hiện tại. Tiền tệ được giữ nguyên."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı paylaşım ayarları mevcut üyeler için geçerli değil. Mevcut üyeler arasında eşit paylaşım kullanıldı. Para birimi korundu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naaangkop sa kasalukuyang mga miyembro ang naka-save na paghahati, kaya ginamit ang pantay na paghahati sa kasalukuyang mga miyembro. Pinanatili ang salapi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าการแบ่งที่บันทึกไว้ใช้กับสมาชิกปัจจุบันไม่ได้ จึงเปลี่ยนเป็นแบ่งเท่ากันระหว่างสมาชิกปัจจุบัน โดยคงสกุลเงินเดิมไว้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La divisione salvata non è applicabile ai membri attuali. Verrà usata una divisione in parti uguali tra i membri attuali. La valuta è stata mantenuta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane ustawienia podziału nie pasują do obecnych członków. Zastosowano równy podział między obecnych członków. Zachowano walutę."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan perkongsian tersimpan tidak sesuai untuk ahli semasa. Perkongsian sama rata digunakan untuk ahli semasa. Mata wang dikekalkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen verdeling past niet bij de huidige leden. Er wordt gelijk verdeeld over de huidige leden. De valuta is behouden."
          }
        }
      }
    },
    "已清除本機預設值；目前表單不變。": {
      "comment": "native.expenseEditorState.defaultsCleared. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已清除本機預設值；目前表單不變。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local defaults cleared. The current form is unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの既定値を消去しました。現在のフォームは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 기본값을 지웠습니다. 현재 양식은 변경되지 않았습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय डिफ़ॉल्ट हटाए गए; वर्तमान फ़ॉर्म नहीं बदला है।"
