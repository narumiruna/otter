    "登入狀態已變更。請關閉並重新開啟修改紀錄。": {
      "comment": "native.expenseHistoryView.sessionChanged. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入狀態已變更。請關閉並重新開啟修改紀錄。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in state has changed. Close and reopen change history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン状態が変わりました。変更履歴を閉じて開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 상태가 변경되었습니다. 변경 기록을 닫았다가 다시 여세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन की स्थिति बदल गई है। बदलाव का इतिहास बंद करके फिर खोलें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado de inicio de sesión ha cambiado. Cierra y vuelve a abrir el historial de cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état de connexion a changé. Fermez l’historique des modifications, puis rouvrez-le."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado de login mudou. Feche e abra novamente o histórico de alterações."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status masuk telah berubah. Tutup dan buka kembali riwayat perubahan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anmeldestatus hat sich geändert. Schließe den Änderungsverlauf und öffne ihn erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái đăng nhập đã thay đổi. Hãy đóng và mở lại lịch sử thay đổi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş durumu değişti. Değişiklik geçmişini kapatıp yeniden açın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang katayuan ng pag-sign in. Isara at buksan muli ang kasaysayan ng pagbabago."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะการลงชื่อเข้าใช้เปลี่ยนแล้ว โปรดปิดประวัติการแก้ไขแล้วเปิดใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato di accesso è cambiato. Chiudi e riapri la cronologia delle modifiche."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan logowania uległ zmianie. Zamknij historię zmian i otwórz ją ponownie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Status log masuk telah berubah. Tutup dan buka semula sejarah perubahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmeldstatus is gewijzigd. Sluit de wijzigingsgeschiedenis en open deze opnieuw."
          }
        }
      }
    },
    "目前權限不允許讀取修改紀錄。唯讀分享不提供此功能。": {
      "comment": "native.expenseHistoryView.permissionDenied. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前權限不允許讀取修改紀錄。唯讀分享不提供此功能。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current permissions do not allow reading change history. Read-only sharing does not provide this feature."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の権限では変更履歴を読み取れません。読み取り専用の共有ではこの機能は提供されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 권한으로 변경 기록을 읽을 수 없습니다. 읽기 전용 공유에서는 이 기능을 제공하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान अधिकार बदलाव का इतिहास पढ़ने की अनुमति नहीं देते। केवल पढ़ने वाले साझाकरण में यह सुविधा नहीं है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los permisos actuales no permiten consultar el historial de cambios. Esta función no está disponible en el acceso compartido de solo lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les droits actuels ne permettent pas de consulter l’historique des modifications. Cette fonction n’est pas disponible en partage en lecture seule."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As permissões atuais não permitem consultar o histórico de alterações. Esta função não está disponível no compartilhamento somente leitura."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin saat ini tidak mengizinkan membaca riwayat perubahan. Berbagi hanya-baca tidak menyediakan fitur ini."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuellen Berechtigungen erlauben keinen Zugriff auf den Änderungsverlauf. Schreibgeschützte Freigaben bieten diese Funktion nicht."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền hiện tại không cho phép đọc lịch sử thay đổi. Chia sẻ chỉ đọc không cung cấp tính năng này."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut yetkiler değişiklik geçmişini okumaya izin vermiyor. Salt okunur paylaşım bu özelliği sunmaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pinapayagan ng kasalukuyang karapatan ang pagbasa ng kasaysayan ng pagbabago. Wala ang tampok na ito sa read-only na pagbabahagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ปัจจุบันไม่อนุญาตให้อ่านประวัติการแก้ไข การแชร์แบบอ่านอย่างเดียวไม่มีฟังก์ชันนี้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I permessi attuali non consentono di leggere la cronologia delle modifiche. La condivisione in sola lettura non offre questa funzione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżące uprawnienia nie pozwalają odczytać historii zmian. Udostępnianie tylko do odczytu nie zapewnia tej funkcji."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebenaran semasa tidak membenarkan pembacaan sejarah perubahan. Perkongsian baca sahaja tidak menyediakan ciri ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige rechten staan het lezen van de wijzigingsgeschiedenis niet toe. Delen met alleen-lezen biedt deze functie niet."
          }
        }
      }
    },
    "群組已封存。可以讀取紀錄，但不能還原。": {
      "comment": "native.expenseHistoryView.archivedNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組已封存。可以讀取紀錄，但不能還原。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group is archived. You can read history, but cannot restore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループはアーカイブ済みです。履歴は読み取れますが、復元はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 그룹입니다. 기록은 읽을 수 있지만 복원할 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह संग्रहित है। रिकॉर्ड पढ़ सकते हैं, लेकिन वापस नहीं ला सकते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo está archivado. Puedes consultar el historial, pero no restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe est archivé. Vous pouvez consulter l’historique, mais pas restaurer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O grupo foi arquivado. É possível consultar o histórico, mas não restaurar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup telah diarsipkan. Riwayat dapat dibaca, tetapi pemulihan tidak dapat dilakukan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe ist archiviert. Einträge können gelesen, aber nicht wiederhergestellt werden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm đã lưu trữ. Có thể đọc bản ghi nhưng không thể khôi phục."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup arşivlendi. Geçmiş okunabilir ancak geri yükleme yapılamaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-archive ang grupo. Maaaring basahin ang mga tala, pero hindi ibalik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
