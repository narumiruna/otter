        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi binawi (saklaw pa rin ng oras ng pag-expire)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่เพิกถอน (ยังอยู่ภายใต้เวลาหมดอายุ)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
