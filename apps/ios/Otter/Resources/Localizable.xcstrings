    "請僅在登入提示欄位輸入 API key。金鑰不會保存在此裝置。": {
      "comment": "native.aiSettingsView.keyInputNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請僅在登入提示欄位輸入 API key。金鑰不會保存在此裝置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the API key only in the sign-in prompt field. The key will not be saved on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API keyはログイン時の入力欄にのみ入力してください。キーはこのデバイスに保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API key는 로그인 안내의 입력란에만 입력하세요. 키는 이 기기에 저장되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API key केवल साइन इन के प्रॉम्प्ट वाले फ़ील्ड में डालें। कुंजी इस डिवाइस पर नहीं सहेजी जाएगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la API key solo en el campo de la solicitud de inicio de sesión. La clave no se guardará en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’API key uniquement dans le champ de la demande de connexion. La clé ne sera pas enregistrée sur cet appareil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira a API key apenas no campo da solicitação de login. A chave não será salva neste dispositivo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan API key hanya di kolom permintaan masuk. Kunci tidak akan disimpan di perangkat ini."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den API key nur im Eingabefeld der Anmeldeaufforderung ein. Der Schlüssel wird nicht auf diesem Gerät gespeichert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ nhập API key trong trường lời nhắc đăng nhập. Khóa sẽ không được lưu trên thiết bị này."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API key değerini yalnızca giriş istemindeki alana girin. Anahtar bu cihazda kaydedilmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay lamang ang API key sa field ng prompt sa pag-sign in. Hindi ise-save ang susi sa device na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดป้อน API key ในช่องพรอมต์ลงชื่อเข้าใช้เท่านั้น คีย์จะไม่ถูกบันทึกไว้ในอุปกรณ์นี้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci l'API key solo nel campo della richiesta di accesso. La chiave non verrà salvata su questo dispositivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz API key wyłącznie w polu monitu logowania. Klucz nie zostanie zapisany na tym urządzeniu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan API key hanya dalam medan gesaan log masuk. Kunci tidak akan disimpan pada peranti ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de API key alleen in het invoerveld van het aanmeldverzoek in. De sleutel wordt niet op dit apparaat opgeslagen."
          }
        }
      }
    },
    "新連線成功前，原有連線會保持不變。模型偏好不會自動變更。": {
      "comment": "native.aiSettingsView.replacementNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新連線成功前，原有連線會保持不變。模型偏好不會自動變更。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The existing connection stays unchanged until the new connection succeeds. Model preferences will not change automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい接続が成功するまで、既存の接続は変更されません。モデルの設定は自動では変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 연결이 성공할 때까지 기존 연결은 변경되지 않습니다. 모델 환경설정은 자동으로 변경되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया कनेक्शन सफल होने तक पुराना कनेक्शन नहीं बदलेगा। मॉडल की प्राथमिकताएँ अपने आप नहीं बदलेंगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión existente no cambiará hasta que la nueva conexión se complete correctamente. Las preferencias del modelo no cambiarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion existante restera inchangée tant que la nouvelle connexion n’aura pas réussi. Les préférences du modèle ne changeront pas automatiquement."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão existente permanecerá inalterada até que a nova conexão seja concluída com sucesso. As preferências do modelo não mudarão automaticamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi lama tetap tidak berubah sampai koneksi baru berhasil. Preferensi model tidak berubah secara otomatis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bisherige Verbindung bleibt unverändert, bis die neue Verbindung erfolgreich hergestellt wurde. Modelleinstellungen werden nicht automatisch geändert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối cũ sẽ không thay đổi cho đến khi kết nối mới thành công. Tùy chọn mô hình sẽ không tự động thay đổi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bağlantı kurulana kadar mevcut bağlantı değişmez. Model tercihleri otomatik olarak değişmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mananatili ang dating koneksyon hanggang magtagumpay ang bago. Hindi awtomatikong magbabago ang mga kagustuhan sa modelo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อเดิมจะคงอยู่จนกว่าการเชื่อมต่อใหม่จะสำเร็จ การตั้งค่าโมเดลจะไม่เปลี่ยนโดยอัตโนมัติ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione esistente resta invariata finché la nuova connessione non riesce. Le preferenze del modello non cambiano automaticamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotychczasowe połączenie pozostanie bez zmian, dopóki nowe połączenie nie zostanie nawiązane. Preferencje modelu nie zmienią się automatycznie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan asal kekal tidak berubah sehingga sambungan baharu berjaya. Keutamaan model tidak akan berubah secara automatik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestaande verbinding blijft ongewijzigd totdat de nieuwe verbinding is geslaagd. Modelvoorkeuren worden niet automatisch gewijzigd."
          }
        }
      }
    },
