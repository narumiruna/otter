            "value": "복원할 내용"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापस लाई जाने वाली सामग्री"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido que se restaurará"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu à restaurer"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo que será restaurado"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten yang akan dipulihkan"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherzustellender Inhalt"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung sẽ khôi phục"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yüklenecek içerik"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilalamang ibabalik"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลที่จะกู้คืน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenuti da ripristinare"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treść do przywrócenia"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandungan yang akan dipulihkan"
          }
        },
        "nl": {
