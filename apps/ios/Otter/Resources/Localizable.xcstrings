    "匯率必須是大於零的有限數值。": {
      "comment": "native.groupManagementRules.invalidRate, native.groupSettingsView.invalidRate. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯率必須是大於零的有限數值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exchange rate must be a finite number greater than zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "為替レートはゼロより大きい有限の数値にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환율은 0보다 큰 유한한 수여야 합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विनिमय दर शून्य से अधिक सीमित संख्या होनी चाहिए।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de cambio debe ser un número finito mayor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de change doit être un nombre fini supérieur à zéro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de câmbio deve ser um número finito maior que zero."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs harus berupa angka terbatas yang lebih dari nol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechselkurs muss eine endliche Zahl größer als null sein."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tỷ giá phải là số hữu hạn lớn hơn không."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döviz kuru sıfırdan büyük, sonlu bir sayı olmalıdır."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat ay may hangganan at higit sa zero ang halaga ng palitan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตราแลกเปลี่ยนต้องเป็นจำนวนจำกัดที่มากกว่าศูนย์"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cambio deve essere un numero finito maggiore di zero."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs musi być skończoną liczbą większą od zera."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar tukaran mesti nombor terhingga yang melebihi sifar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wisselkoers moet een eindig getal groter dan nul zijn."
          }
        }
      }
    },
    "伺服器回傳的匯率快照無效，未變更設定。": {
      "comment": "native.groupManagementRules.invalidSnapshot. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器回傳的匯率快照無效，未變更設定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server returned an invalid exchange rate snapshot. Settings were not changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから無効な為替レートのスナップショットが返されました。設定は変更していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 반환한 환율 스냅샷이 유효하지 않아 설정을 변경하지 않았습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर से मिला विनिमय दर स्नैपशॉट अमान्य है; सेटिंग नहीं बदली गई।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instantánea del tipo de cambio devuelta por el servidor no es válida. No se ha cambiado la configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’instantané du taux de change renvoyé par le serveur est invalide. Les paramètres n’ont pas été modifiés."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro da taxa de câmbio retornado pelo servidor é inválido. As configurações não foram alteradas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman kurs yang dikembalikan server tidak valid. Pengaturan tidak diubah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vom Server gelieferte Wechselkurs-Momentaufnahme ist ungültig. Einstellungen wurden nicht geändert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chụp tỷ giá máy chủ trả về không hợp lệ, cài đặt chưa thay đổi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunun döndürdüğü kur anlık görüntüsü geçersiz; ayarlar değiştirilmedi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi wasto ang snapshot ng palitan na ibinalik ng server; hindi binago ang mga setting."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพรวมอัตราแลกเปลี่ยนที่เซิร์ฟเวอร์ส่งกลับไม่ถูกต้อง ยังไม่ได้เปลี่ยนการตั้งค่า"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'istantanea del cambio restituita dal server non è valida. Le impostazioni non sono cambiate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer zwrócił nieprawidłowy zapis kursu. Ustawień nie zmieniono."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petikan kadar tukaran yang dikembalikan pelayan tidak sah. Tetapan tidak diubah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wisselkoersmomentopname van de server is ongeldig. Instellingen zijn niet gewijzigd."
          }
        }
      }
    },
    "另一項群組操作仍在處理中，請稍後再試。": {
      "comment": "native.groupManagementState.operationBusy. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一項群組操作仍在處理中，請稍後再試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another group operation is still in progress. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のグループ操作を処理中です。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 그룹 작업이 아직 처리 중입니다. 나중에 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह की एक और कार्रवाई अभी जारी है। बाद में फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún se está procesando otra operación del grupo. Reinténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre opération sur le groupe est encore en cours. Réessayez plus tard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra operação do grupo ainda está sendo processada. Tente novamente mais tarde."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi grup lain masih diproses. Coba lagi nanti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Gruppenvorgang wird noch verarbeitet. Versuche es später erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thao tác nhóm khác vẫn đang xử lý. Vui lòng thử lại sau."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir grup işlemi hâlâ sürüyor. Daha sonra yeniden deneyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinoproseso pa ang ibang pagkilos sa grupo. Subukan muli mamaya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการกลุ่มอื่นยังอยู่ระหว่างประมวลผล โปรดลองอีกครั้งภายหลัง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra operazione sul gruppo è ancora in corso. Riprova più tardi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna operacja grupy jest nadal przetwarzana. Spróbuj później."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi kumpulan lain masih diproses. Cuba lagi kemudian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere groepsbewerking wordt nog verwerkt. Probeer het later opnieuw."
          }
        }
      }
    },
    "群組已封存。無法修改名稱、幣別、匯率、Visa 設定或日常資料。擁有者仍可管理存取權、API 寫入、複製、還原及刪除群組。": {
      "comment": "native.groupSettingsView.archivedNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組已封存。無法修改名稱、幣別、匯率、Visa 設定或日常資料。擁有者仍可管理存取權、API 寫入、複製、還原及刪除群組。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group is archived. Its name, currencies, exchange rates, Visa settings, and everyday data cannot be changed. Owners can still manage access and API writes, copy, restore, and delete the group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループはアーカイブ済みです。名前、通貨、為替レート、Visa設定、日常のデータは変更できません。所有者は引き続きアクセス権とAPI書き込みの管理、グループのコピー、復元、削除ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 그룹입니다. 이름, 통화, 환율, Visa 설정 또는 일상 데이터를 수정할 수 없습니다. 소유자는 접근 권한과 API 쓰기를 관리하고 그룹을 복사, 복원, 삭제할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह संग्रहित है। नाम, मुद्रा, विनिमय दर, Visa सेटिंग या रोज़मर्रा का डेटा नहीं बदल सकते। स्वामी अब भी पहुँच अधिकार, API लेखन, समूह की कॉपी, वापसी और हटाने का प्रबंधन कर सकता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo está archivado. No se pueden modificar el nombre, las monedas, los tipos de cambio, la configuración Visa ni los datos cotidianos. El propietario aún puede gestionar el acceso y la escritura por API, copiar, restaurar y eliminar el grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe est archivé. Le nom, les devises, les taux de change, les paramètres Visa et les données courantes ne peuvent pas être modifiés. Le propriétaire peut toujours gérer l’accès et l’écriture par API, copier, restaurer et supprimer le groupe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O grupo foi arquivado. Não é possível modificar nome, moedas, taxas de câmbio, configurações Visa ou dados cotidianos. O proprietário ainda pode gerenciar o acesso e a gravação por API, copiar, restaurar e excluir o grupo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup telah diarsipkan. Nama, mata uang, kurs, pengaturan Visa, dan data sehari-hari tidak dapat diubah. Pemilik masih dapat mengelola hak akses dan penulisan API, serta menyalin, memulihkan, dan menghapus grup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe ist archiviert. Name, Währungen, Wechselkurse, Visa-Einstellungen und Alltagsdaten können nicht geändert werden. Eigentümer können weiterhin Zugriffsrechte und API-Schreibzugriff verwalten sowie die Gruppe kopieren, wiederherstellen und löschen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm đã lưu trữ. Không thể sửa tên, tiền tệ, tỷ giá, cài đặt Visa hoặc dữ liệu hằng ngày. Chủ sở hữu vẫn có thể quản lý quyền truy cập, quyền ghi API, sao chép, khôi phục và xóa nhóm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup arşivlendi. Ad, para birimi, döviz kuru, Visa ayarları veya günlük veriler değiştirilemez. Sahip, erişimi ve API yazma yetkisini yönetmeye, grubu kopyalamaya, geri yüklemeye ve silmeye devam edebilir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-archive ang grupo. Hindi mababago ang pangalan, salapi, palitan, mga setting ng Visa o pang-araw-araw na datos. Maaari pa ring pamahalaan ng may-ari ang pag-access, pagsulat sa API, pagkopya, pagpapanumbalik at pagbura ng grupo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บกลุ่มเข้าคลังแล้ว เปลี่ยนชื่อ สกุลเงิน อัตราแลกเปลี่ยน การตั้งค่า Visa หรือข้อมูลประจำวันไม่ได้ เจ้าของยังจัดการสิทธิ์เข้าถึง การเขียนผ่าน API การคัดลอก การกู้คืน และการลบกลุ่มได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo è archiviato. Non puoi modificare nome, valute, cambi, impostazioni Visa o dati ordinari. Il proprietario può ancora gestire accesso e scrittura API, copiare, ripristinare ed eliminare il gruppo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupa jest zarchiwizowana. Nie można zmieniać nazwy, walut, kursów, ustawień Visa ani bieżących danych. Właściciel nadal może zarządzać dostępem i zapisem przez API oraz kopiować, przywracać i usuwać grupę."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpulan telah diarkibkan. Nama, mata wang, kadar tukaran, tetapan Visa dan data harian tidak boleh diubah. Pemilik masih boleh mengurus hak akses dan penulisan API, serta menyalin, memulihkan dan memadam kumpulan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De groep is gearchiveerd. Naam, valuta's, wisselkoersen, Visa-instellingen en gewone gegevens kunnen niet worden gewijzigd. De eigenaar kan nog toegang en API-schrijftoegang beheren en de groep kopiëren, herstellen en verwijderen."
          }
        }
      }
    },
    "您可以檢視設定，但只有具備權限的擁有者可以修改群組偏好。編輯者不能執行擁有者操作。": {
      "comment": "native.groupSettingsView.ownerOnlyNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以檢視設定，但只有具備權限的擁有者可以修改群組偏好。編輯者不能執行擁有者操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can view settings, but only an owner with the required permissions can change group preferences. Editors cannot perform owner operations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定は閲覧できますが、グループの設定を変更できるのは権限を持つ所有者のみです。編集者は所有者専用の操作を実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정은 볼 수 있지만 권한이 있는 소유자만 그룹 환경설정을 변경할 수 있습니다. 편집자는 소유자 전용 작업을 할 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सेटिंग देख सकते हैं, लेकिन केवल अधिकृत स्वामी समूह की प्राथमिकताएँ बदल सकता है। संपादक स्वामी की कार्रवाइयाँ नहीं कर सकते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ver la configuración, pero solo el propietario con permisos puede modificar las preferencias del grupo. Los editores no pueden realizar operaciones del propietario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez consulter les paramètres, mais seul le propriétaire disposant des droits requis peut modifier les préférences du groupe. Les éditeurs ne peuvent pas effectuer les opérations du propriétaire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode visualizar as configurações, mas somente o proprietário com permissão pode modificar as preferências do grupo. Editores não podem realizar operações do proprietário."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat melihat pengaturan, tetapi hanya pemilik yang berwenang dapat mengubah preferensi grup. Penyunting tidak dapat melakukan operasi pemilik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Einstellungen ansehen. Nur berechtigte Eigentümer können Gruppeneinstellungen ändern. Bearbeiter können keine Eigentümeraktionen ausführen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xem cài đặt, nhưng chỉ chủ sở hữu có quyền mới có thể sửa tùy chọn nhóm. Người chỉnh sửa không thể thực hiện thao tác của chủ sở hữu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları görebilirsiniz ancak yalnızca yetkili sahip grup tercihlerini değiştirebilir. Düzenleyiciler sahibe özel işlemleri yapamaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaari mong tingnan ang mga setting, pero tanging may-aring may karapatan ang makakabago ng mga kagustuhan ng grupo. Hindi magagawa ng tagapag-edit ang mga pagkilos ng may-ari."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณดูการตั้งค่าได้ แต่เฉพาะเจ้าของที่มีสิทธิ์เท่านั้นที่แก้ไขการตั้งค่ากลุ่มได้ ผู้แก้ไขทำรายการที่สงวนไว้สำหรับเจ้าของไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi visualizzare le impostazioni, ma solo il proprietario con i permessi necessari può modificare le preferenze del gruppo. Gli editor non possono eseguire operazioni riservate al proprietario."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wyświetlać ustawienia, ale tylko uprawniony właściciel może zmieniać preferencje grupy. Edytor nie może wykonywać operacji właściciela."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh melihat tetapan, tetapi hanya pemilik yang diberi kebenaran boleh mengubah keutamaan kumpulan. Penyunting tidak boleh melakukan operasi pemilik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt instellingen bekijken, maar alleen een eigenaar met de juiste rechten kan groepsvoorkeuren wijzigen. Bewerkers kunnen geen eigenaarsbewerkingen uitvoeren."
          }
        }
      }
    },
