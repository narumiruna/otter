    "此處只記錄已完成的付款，不會進行實際轉帳。": {
      "comment": "native.overviewView.noTransferNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處只記錄已完成的付款，不會進行實際轉帳。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only records completed payments. It does not make actual transfers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは完了した支払いのみを記録します。実際の送金は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 완료된 결제만 기록하며 실제 이체는 하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ केवल पूरे हो चुके भुगतान दर्ज होते हैं; वास्तविक धन हस्तांतरण नहीं होता।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo se registran pagos ya realizados; no se efectúan transferencias reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les paiements déjà effectués sont enregistrés ici ; aucun virement réel n’est exécuté."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui são registrados apenas pagamentos já realizados; nenhuma transferência real é feita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di sini hanya mencatat pembayaran yang telah selesai, tanpa melakukan transfer sebenarnya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden nur abgeschlossene Zahlungen erfasst. Es erfolgt keine tatsächliche Überweisung."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở đây chỉ ghi nhận thanh toán đã hoàn tất, không thực hiện chuyển khoản thực tế."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada yalnızca tamamlanmış ödemeler kaydedilir; gerçek banka transferi yapılmaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naitatala lamang dito ang mga natapos na bayad; walang aktuwal na paglilipat ng pera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่นี่บันทึกเฉพาะการชำระเงินที่เสร็จแล้ว จะไม่โอนเงินจริง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui si registrano solo pagamenti già completati. Non viene eseguito alcun trasferimento reale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj zapisuje się tylko dokonane płatności. Nie wykonuje się rzeczywistych przelewów."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di sini hanya merekodkan pembayaran yang telah selesai, tanpa membuat pindahan sebenar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier worden alleen voltooide betalingen geregistreerd. Er vindt geen werkelijke overboeking plaats."
          }
        }
      }
    },
    "尚無成員餘額。": {
      "comment": "native.overviewView.noBalances. Application-owned text.",
