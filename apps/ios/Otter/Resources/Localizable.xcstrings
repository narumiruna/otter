            "value": "Hindi maitala ang bayad: %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการชำระเงินไม่ได้: %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare il pagamento: %1$@"
          }
        },
        "pl": {
