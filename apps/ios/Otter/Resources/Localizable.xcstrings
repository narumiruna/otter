    "已載入臺灣銀行即期中價快照：%@。尚未儲存。": {
      "comment": "native.groupSettingsView.loadedBankSnapshot. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已載入臺灣銀行即期中價快照：%1$@。尚未儲存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank of Taiwan spot midpoint rate snapshot loaded: %1$@. Not yet saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank of Taiwanの直物仲値のスナップショットを読み込みました：%1$@。まだ保存していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank of Taiwan 현물 중간 환율 스냅샷을 불러왔습니다: %1$@. 아직 저장하지 않았습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank of Taiwan की हाज़िर मध्य दर का स्नैपशॉट लोड हुआ: %1$@। अभी सहेजा नहीं गया।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantánea del tipo de cambio medio al contado de Bank of Taiwan cargada: %1$@. Aún no se ha guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantané du cours moyen au comptant de Bank of Taiwan chargé : %1$@. Pas encore enregistré."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro da taxa média à vista do Bank of Taiwan carregado: %1$@. Ainda não foi salvo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman kurs tengah spot Bank of Taiwan telah dimuat: %1$@. Belum disimpan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentaufnahme des Devisenkassamittelkurses von Bank of Taiwan geladen: %1$@. Noch nicht gespeichert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tải bản chụp tỷ giá giao ngay trung bình của Bank of Taiwan: %1$@. Chưa lưu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank of Taiwan spot orta kur anlık görüntüsü yüklendi: %1$@. Henüz kaydedilmedi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-load ang snapshot ng gitnang spot rate ng Bank of Taiwan: %1$@. Hindi pa na-save."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดภาพรวมอัตรากลางสปอตของ Bank of Taiwan แล้ว: %1$@ ยังไม่ได้บันทึก"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Istantanea del cambio medio a pronti di Bank of Taiwan caricata: %1$@. Non ancora salvata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytano zapis średniego kursu spot Bank of Taiwan: %1$@. Jeszcze go nie zapisano."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petikan kadar tengah semerta Bank of Taiwan telah dimuatkan: %1$@. Belum disimpan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentopname van de spotmiddenkoers van Bank of Taiwan geladen: %1$@. Nog niet opgeslagen."
          }
        }
      }
    },
