        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰을 안전하게 생성할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टोकन सुरक्षित रूप से नहीं बन सका। बाद में फिर कोशिश करें।"
          }
