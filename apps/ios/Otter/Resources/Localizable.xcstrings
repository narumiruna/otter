    "未撤銷（仍受到期時間限制）": {
      "comment": "native.accessSettingsView.notRevoked. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未撤銷（仍受到期時間限制）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not revoked (expiration still applies)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未取り消し（有効期限は適用されます）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소되지 않음(만료 시간은 적용됨)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द नहीं हुआ (समाप्ति का समय अब भी लागू है)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No revocado (sigue sujeto a la fecha de caducidad)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non révoqué (reste soumis à la date d’expiration)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não revogado (ainda sujeito à data de expiração)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dicabut (tetap tunduk pada waktu kedaluwarsa)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht widerrufen (Ablaufdatum gilt weiterhin)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thu hồi (vẫn chịu giới hạn thời gian hết hạn)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
