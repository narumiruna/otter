    "目前支出不存在；確認後將還原已刪除的支出。": {
      "comment": "native.expenseHistoryView.restoreDeleted. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前支出不存在；確認後將還原已刪除的支出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expense does not currently exist. Confirming will restore the deleted expense."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、支出は存在しません。確定すると削除済みの支出を復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 지출이 존재하지 않습니다. 확인하면 삭제된 지출을 복원합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान खर्च मौजूद नहीं है; पुष्टि के बाद हटाया गया खर्च वापस आएगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto actual no existe; al confirmar se restaurará el gasto eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dépense actuelle n’existe pas ; la confirmation restaurera la dépense supprimée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A despesa atual não existe; a confirmação restaurará a despesa excluída."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran saat ini tidak ada; setelah dikonfirmasi, pengeluaran yang dihapus akan dipulihkan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe ist derzeit nicht vorhanden. Nach der Bestätigung wird die gelöschte Ausgabe wiederhergestellt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoản chi hiện tại không tồn tại; sau khi xác nhận sẽ khôi phục khoản chi đã xóa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gider şu anda mevcut değil; onaylandıktan sonra silinen gider geri yüklenir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala ang kasalukuyang gastos; ibabalik ang naburang gastos pagkatapos kumpirmahin."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายจ่ายปัจจุบันไม่มีอยู่ เมื่อยืนยันแล้วจะกู้คืนรายจ่ายที่ลบไป"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La spesa attualmente non esiste. Dopo la conferma verrà ripristinata la spesa eliminata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatek obecnie nie istnieje. Po potwierdzeniu usunięty wydatek zostanie przywrócony."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbelanjaan semasa tidak wujud; selepas pengesahan, perbelanjaan yang dipadam akan dipulihkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgave bestaat momenteel niet. Na bevestiging wordt de verwijderde uitgave hersteld."
          }
        }
      }
    },
    "將還原的內容": {
      "comment": "native.expenseHistoryView.targetSnapshot. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
