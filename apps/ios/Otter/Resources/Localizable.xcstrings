    "只有您正在操作的用戶端「%@」才應獲得授權。": {
      "comment": "native.deviceApprovalView.clientAuthorizationNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有您正在操作的用戶端「%1$@」才應獲得授權。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorize the client “%1$@” only if you are operating it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身が操作しているクライアント「%1$@」にのみ認可を与えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 사용 중인 클라이언트 ‘%1$@’에만 권한을 부여하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आपके द्वारा इस्तेमाल किए जा रहे क्लाइंट “%1$@” को ही अधिकृत करना चाहिए।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo debes autorizar al cliente «%1$@» si lo estás usando tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le client « %1$@ » que vous utilisez doit être autorisé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o cliente “%1$@” que você está usando deve ser autorizado."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya klien “%1$@” yang sedang Anda operasikan yang seharusnya diberi otorisasi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der von dir gerade verwendete Client „%1$@“ sollte autorisiert werden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ nên cấp quyền cho ứng dụng khách “%1$@” mà bạn đang sử dụng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kullanmakta olduğunuz “%1$@” istemcisine yetki verilmelidir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang kliyenteng “%1$@” na kasalukuyan mong ginagamit lamang ang dapat pahintulutan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควรอนุญาตเฉพาะไคลเอนต์ “%1$@” ที่คุณกำลังใช้งานเท่านั้น"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizza solo il client «%1$@» che stai usando."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoryzację powinien otrzymać tylko klient „%1$@”, którego właśnie używasz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya klien “%1$@” yang sedang anda kendalikan patut diberi kebenaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de client ‘%1$@’ die je zelf gebruikt, mag worden geautoriseerd."
          }
        }
      }
    },
    "請輸入此伺服器的裝置登入網址或裝置代碼。": {
