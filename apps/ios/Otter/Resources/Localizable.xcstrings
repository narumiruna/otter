    "至少需要一位參與者，無法刪除最後一人。": {
      "comment": "native.peopleView.lastParticipant. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要一位參與者，無法刪除最後一人。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one participant is required. The last participant cannot be deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者は少なくとも1人必要です。最後の1人は削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여자가 한 명 이상 필요하므로 마지막 참여자는 삭제할 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम एक सहभागी चाहिए; आखिरी व्यक्ति नहीं हटा सकते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere al menos un participante; no se puede eliminar al último."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins un participant est requis ; le dernier ne peut pas être supprimé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário pelo menos um participante; não é possível excluir o último."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setidaknya satu peserta diperlukan; peserta terakhir tidak dapat dihapus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens ein Teilnehmer ist erforderlich. Der letzte kann nicht gelöscht werden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần ít nhất một người tham gia, không thể xóa người cuối cùng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az bir katılımcı gerekir; son kişi silinemez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng kahit isang kalahok, kaya hindi mabubura ang huli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีผู้ร่วมรายจ่ายอย่างน้อยหนึ่งคน จึงลบคนสุดท้ายไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve almeno un partecipante. Non puoi eliminare l'ultimo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagany jest co najmniej jeden uczestnik. Nie można usunąć ostatniej osoby."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekurang-kurangnya seorang peserta diperlukan; peserta terakhir tidak boleh dipadamkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is minstens één deelnemer nodig. De laatste kan niet worden verwijderd."
          }
        }
      }
    },
    "此人已有付款或分攤的支出，不能刪除。可使用合併保留資料。": {
      "comment": "native.peopleView.hasExpenses. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此人已有付款或分攤的支出，不能刪除。可使用合併保留資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This person has paid or shared expenses and cannot be deleted. Use merging to retain the data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人には支払いや分担をした支出があるため、削除できません。統合するとデータを保持できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람은 결제하거나 분담한 지출이 있어 삭제할 수 없습니다. 병합 기능으로 데이터를 유지할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस व्यक्ति के चुकाए या हिस्से वाले खर्च हैं, इसलिए नहीं हटा सकते। डेटा रखने के लिए मिलाने की सुविधा इस्तेमाल कर सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta persona ya ha pagado gastos o participa en su reparto y no se puede eliminar. Puedes fusionarla para conservar los datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne a déjà payé ou partagé des dépenses et ne peut pas être supprimée. Utilisez la fusion pour conserver les données."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pessoa já pagou despesas ou participa do rateio e não pode ser excluída. Use a mesclagem para manter os dados."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang ini memiliki pengeluaran yang dibayar atau dibagi, sehingga tidak dapat dihapus. Gunakan penggabungan untuk mempertahankan data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Person hat bereits Ausgaben bezahlt oder geteilt und kann nicht gelöscht werden. Verwende Zusammenführen, um Daten zu behalten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người này đã trả hoặc chia khoản chi, không thể xóa. Có thể dùng gộp để giữ dữ liệu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişinin ödediği veya paylaştığı giderler var; silinemez. Verileri korumak için birleştirmeyi kullanabilirsiniz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May mga gastos nang binayaran o kabahagi ang taong ito, kaya hindi maaaring burahin. Gamitin ang pagsasama upang mapanatili ang datos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บุคคลนี้มีรายจ่ายที่จ่ายหรือร่วมแบ่งแล้ว จึงลบไม่ได้ คุณใช้การรวมเพื่อเก็บข้อมูลไว้ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa persona ha già pagato o condiviso spese e non può essere eliminata. Usa l'unione per conservare i dati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta osoba ma już wydatki jako płatnik lub uczestnik podziału i nie można jej usunąć. Użyj scalenia, aby zachować dane."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang ini mempunyai perbelanjaan yang dibayar atau dikongsi, jadi tidak boleh dipadamkan. Gunakan penggabungan untuk mengekalkan data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze persoon heeft al uitgaven betaald of gedeeld en kan niet worden verwijderd. Gebruik samenvoegen om gegevens te behouden."
          }
        }
      }
    },
    "此人已有結算付款紀錄，不能刪除。可使用合併功能。": {
      "comment": "native.peopleView.hasPayments. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此人已有結算付款紀錄，不能刪除。可使用合併功能。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This person has settlement payment records and cannot be deleted. You can use merging."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人には精算の支払い記録があるため、削除できません。統合機能を使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람은 정산 결제 기록이 있어 삭제할 수 없습니다. 병합 기능을 사용할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस व्यक्ति के निपटान भुगतान रिकॉर्ड हैं, इसलिए नहीं हटा सकते। मिलाने की सुविधा इस्तेमाल कर सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta persona ya tiene registros de pagos de liquidación y no se puede eliminar. Puedes usar la función de fusión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne a déjà des enregistrements de paiement de règlement et ne peut pas être supprimée. Vous pouvez utiliser la fusion."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pessoa já tem registros de pagamentos de acerto e não pode ser excluída. Você pode usar a mesclagem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang ini memiliki catatan pembayaran penyelesaian dan tidak dapat dihapus. Gunakan fitur penggabungan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Person hat bereits erfasste Ausgleichszahlungen und kann nicht gelöscht werden. Du kannst die Zusammenführung verwenden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người này có bản ghi thanh toán quyết toán, không thể xóa. Có thể dùng tính năng gộp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişinin hesaplaşma ödeme kayıtları var; silinemez. Birleştirme özelliğini kullanabilirsiniz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May tala na ng bayad sa pag-aayos ang taong ito, kaya hindi maaaring burahin. Maaaring gamitin ang pagsasama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บุคคลนี้มีบันทึกการชำระยอดแล้ว จึงลบไม่ได้ คุณใช้ฟังก์ชันรวมได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa persona ha già pagamenti di saldo registrati e non può essere eliminata. Puoi usare l'unione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta osoba ma już zapisy płatności rozliczeniowych i nie można jej usunąć. Możesz użyć funkcji scalenia."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang ini mempunyai rekod pembayaran penyelesaian dan tidak boleh dipadamkan. Gunakan ciri penggabungan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze persoon heeft al geregistreerde verrekenbetalingen en kan niet worden verwijderd. Je kunt samenvoegen gebruiken."
          }
        }
      }
    },
    "付款明細不可用，無法確認是否可刪除。請重新載入完整群組資料。": {
      "comment": "native.peopleView.deletionUnknown. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款明細不可用，無法確認是否可刪除。請重新載入完整群組資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment details are unavailable, so deletion eligibility cannot be confirmed. Reload the full group data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いの明細を取得できないため、削除可能か確認できません。完全なグループデータを再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 내역을 사용할 수 없어 삭제 가능 여부를 확인할 수 없습니다. 전체 그룹 데이터를 다시 불러오세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान का विवरण उपलब्ध नहीं है; हटाने की अनुमति की पुष्टि नहीं हो सकती। समूह का पूरा डेटा दोबारा लोड करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles de pagos no están disponibles; no se puede confirmar si se puede eliminar. Vuelve a cargar los datos completos del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails des paiements sont indisponibles ; impossible de confirmer si la suppression est possible. Rechargez les données complètes du groupe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os detalhes dos pagamentos estão indisponíveis; não é possível confirmar se a exclusão é permitida. Recarregue os dados completos do grupo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rincian pembayaran tidak tersedia, sehingga izin penghapusan tidak dapat dipastikan. Muat ulang data grup lengkap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungsdetails sind nicht verfügbar. Es lässt sich nicht bestätigen, ob Löschen möglich ist. Lade die vollständigen Gruppendaten erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có chi tiết thanh toán, không thể xác nhận có được xóa hay không. Hãy tải lại dữ liệu nhóm đầy đủ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme ayrıntıları kullanılamıyor; silinip silinemeyeceği doğrulanamıyor. Tam grup verilerini yeniden yükleyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang detalye ng bayad, kaya hindi matiyak kung maaaring burahin. I-load muli ang buong datos ng grupo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายละเอียดการชำระเงิน จึงยืนยันไม่ได้ว่าลบได้หรือไม่ โปรดโหลดข้อมูลกลุ่มทั้งหมดใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dettagli dei pagamenti non disponibili. Impossibile confermare se l'eliminazione è consentita. Ricarica tutti i dati del gruppo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szczegóły płatności są niedostępne. Nie można potwierdzić, czy usunięcie jest możliwe. Wczytaj ponownie pełne dane grupy."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butiran pembayaran tidak tersedia, jadi pemadaman tidak dapat disahkan. Muat semula data kumpulan penuh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalingsdetails ontbreken. Kan niet bevestigen of verwijderen mogelijk is. Laad de volledige groepsgegevens opnieuw."
          }
        }
      }
    },
