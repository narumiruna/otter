    "%@\n%@\n刪除後會重新計算結算建議，不會撤回實際轉帳。": {
      "comment": "native.overviewView.deletePaymentNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\n刪除後會重新計算結算建議，不會撤回實際轉帳。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nDeleting will recalculate settlement suggestions. It will not reverse an actual transfer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\n削除後に精算案を再計算します。実際の送金は取り消されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\n삭제 후 정산 제안을 다시 계산하며 실제 이체는 취소하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nहटाने के बाद निपटान के सुझावों की फिर गणना होगी; वास्तविक धन हस्तांतरण वापस नहीं होगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nLa eliminación recalculará las sugerencias de liquidación, pero no revertirá la transferencia real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nLa suppression recalculera les suggestions de règlement, sans annuler le virement réel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nA exclusão recalculará as sugestões de acerto, sem desfazer a transferência real."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nSetelah dihapus, saran penyelesaian dihitung ulang; transfer yang sebenarnya tidak dibatalkan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nNach dem Löschen werden Ausgleichsvorschläge neu berechnet. Eine tatsächliche Überweisung wird nicht rückgängig gemacht."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nSau khi xóa sẽ tính lại đề xuất quyết toán, không thu hồi chuyển khoản thực tế."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nSilindikten sonra hesaplaşma önerileri yeniden hesaplanır; gerçek banka transferi geri alınmaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nKakalkulahin muli ang mga mungkahi sa pag-aayos matapos burahin; hindi nito babawiin ang aktuwal na paglipat ng pera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nหลังลบจะคำนวณคำแนะนำการชำระยอดใหม่ แต่จะไม่เรียกคืนเงินที่โอนจริง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nDopo l'eliminazione i suggerimenti di saldo verranno ricalcolati. Il trasferimento reale non verrà annullato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nPo usunięciu sugestie rozliczenia zostaną przeliczone. Rzeczywisty przelew nie zostanie cofnięty."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nSelepas dipadam, cadangan penyelesaian dikira semula; pindahan sebenar tidak dibatalkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n%2$@\nNa verwijdering worden verrekenvoorstellen opnieuw berekend. Een werkelijke overboeking wordt niet teruggedraaid."
          }
        }
      }
    },
