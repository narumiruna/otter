    "僅修改本機佇列草稿，不會在此表單送出支出或收據。": {
      "comment": "native.expenseEditorQueuedView.localOnly. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅修改本機佇列草稿，不會在此表單送出支出或收據。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the local queued draft is changed. This form does not submit expenses or receipts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのキュー内の下書きのみを変更します。このフォームでは支出や領収書を送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 대기열의 초안만 수정합니다. 이 양식에서는 지출이나 영수증을 제출하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल स्थानीय कतार का ड्राफ़्ट बदलेगा। इस फ़ॉर्म से खर्च या रसीद नहीं भेजी जाएगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se modifica el borrador de la cola local; este formulario no envía gastos ni recibos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le brouillon de la file locale est modifié ; ce formulaire n’envoie ni dépense ni reçu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o rascunho da fila local será modificado; este formulário não envia despesas nem recibos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya mengubah draf antrean lokal. Formulir ini tidak mengirim pengeluaran atau tanda terima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der lokale Warteschlangenentwurf wird geändert. Dieses Formular sendet keine Ausgaben oder Belege."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ sửa bản nháp trong hàng đợi cục bộ. Biểu mẫu này không gửi khoản chi hoặc biên lai."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yerel kuyruk taslağı değiştirilir. Bu formdan gider veya makbuz gönderilmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal na draft sa pila lamang ang babaguhin. Hindi magsusumite ng gastos o resibo ang form na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขเฉพาะฉบับร่างในคิวของอุปกรณ์ แบบฟอร์มนี้จะไม่ส่งรายจ่ายหรือใบเสร็จ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica solo la bozza locale in coda. Questo modulo non invia spese né ricevute."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia tylko lokalny szkic w kolejce. Ten formularz nie wysyła wydatku ani paragonu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya mengubah draf baris gilir setempat. Borang ini tidak menghantar perbelanjaan atau resit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het lokale wachtrijconcept wordt gewijzigd. Dit formulier verstuurt geen uitgaven of bonnen."
          }
        }
      }
    },
    "登入狀態已變更。請關閉此草稿並重新開啟。": {
      "comment": "native.expenseEditorQueuedView.sessionChanged. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入狀態已變更。請關閉此草稿並重新開啟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in state has changed. Close this draft and reopen it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン状態が変わりました。この下書きを閉じてから開き直してください。"
