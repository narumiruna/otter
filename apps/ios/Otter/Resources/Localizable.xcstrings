        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Freigabelink ist ungültig, abgelaufen oder widerrufen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết chia sẻ không hợp lệ, đã hết hạn hoặc bị thu hồi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım bağlantısı geçersiz, süresi dolmuş veya iptal edilmiş."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi wasto, nag-expire o nabawi ang nakabahaging link."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์แชร์ไม่ถูกต้อง หมดอายุ หรือถูกเพิกถอน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link di condivisione non è valido, è scaduto o è stato revocato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link udostępniania jest nieprawidłowy, wygasł lub został unieważniony."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan perkongsian tidak sah, tamat tempoh atau telah dibatalkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De deellink is ongeldig, verlopen of ingetrokken."
          }
        }
      }
    },
