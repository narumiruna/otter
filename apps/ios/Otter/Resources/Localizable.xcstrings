    "請輸入 1 至 120 字的支出說明。": {
      "comment": "native.expenseEditorState.descriptionValidation. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入 1 至 120 字的支出說明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an expense description of 1 to 120 characters."
          }
        },
        "ja": {
