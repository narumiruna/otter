            "state": "translated",
            "value": "El servidor ha confirmado que no se ha registrado; corrige el borrador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a confirmé l’absence d’enregistrement ; corrigez le brouillon"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor confirmou que não foi registrado; corrija o rascunho"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server telah mengonfirmasi belum dicatat; perbaiki draf"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat bestätigt, dass nichts verbucht wurde. Korrigiere den Entwurf."
