        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved option is currently unavailable. The original settings will remain until you explicitly save a new option or disconnect that provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの選択肢は現在使用できません。新しい選択肢を明示的に保存するか、そのプロバイダーとの接続を解除するまで、元の設定は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 옵션을 현재 사용할 수 없습니다. 새 옵션을 명시적으로 저장하거나 해당 공급자의 연결을 해제할 때까지 기존 설정이 유지됩니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया विकल्प अभी उपलब्ध नहीं है। पुरानी सेटिंग तब तक रहेगी जब तक आप स्पष्ट रूप से नया विकल्प नहीं सहेजते या उस प्रदाता का कनेक्शन नहीं हटाते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción guardada no está disponible actualmente. Se conservará la configuración original hasta que guardes expresamente una nueva opción o desconectes ese proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’option enregistrée est actuellement indisponible. Les paramètres d’origine seront conservés jusqu’à ce que vous enregistriez explicitement une nouvelle option ou déconnectiez ce fournisseur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A opção salva não está disponível no momento. A configuração original será mantida até que você salve explicitamente uma nova opção ou desconecte esse provedor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsi tersimpan saat ini tidak tersedia. Pengaturan lama dipertahankan sampai Anda secara eksplisit menyimpan opsi baru atau memutuskan koneksi penyedia tersebut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Auswahl ist derzeit nicht verfügbar. Die bisherigen Einstellungen bleiben erhalten, bis du ausdrücklich eine neue Auswahl speicherst oder die Verbindung zu diesem Anbieter trennst."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn đã lưu hiện không khả dụng. Cài đặt cũ sẽ được giữ cho đến khi bạn chủ động lưu tùy chọn mới hoặc ngắt kết nối nhà cung cấp đó."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı seçenek şu anda kullanılamıyor. Açıkça yeni bir seçenek kaydetmediğiniz veya bu sağlayıcının bağlantısını kaldırmadığınız sürece mevcut ayar korunur."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi magagamit sa ngayon ang naka-save na pagpipilian. Mananatili ang dating setting hanggang tahasan kang mag-save ng bagong pagpipilian o idiskonekta ang provider na iyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกที่บันทึกไว้ยังใช้ไม่ได้ในขณะนี้ การตั้งค่าเดิมจะคงอยู่จนกว่าคุณจะบันทึกตัวเลือกใหม่อย่างชัดเจนหรือยกเลิกการเชื่อมต่อผู้ให้บริการนั้น"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opzione salvata non è attualmente disponibile. Le impostazioni esistenti restano finché non salvi esplicitamente una nuova opzione o scolleghi il fornitore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisana opcja jest teraz niedostępna. Dotychczasowe ustawienie pozostanie zachowane, dopóki nie zapiszesz jawnie nowej opcji lub nie odłączysz tego dostawcy."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan tersimpan kini tidak tersedia. Tetapan asal dikekalkan sehingga anda menyimpan pilihan baharu secara nyata atau memutuskan sambungan penyedia tersebut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen optie is momenteel niet beschikbaar. De bestaande instellingen blijven behouden totdat je uitdrukkelijk een nieuwe optie opslaat of de verbinding met deze aanbieder verbreekt."
          }
        }
      }
    },
    "請先連線供應商，再選擇模型。": {
