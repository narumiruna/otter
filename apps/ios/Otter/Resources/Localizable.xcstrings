    "列印全部參與者、餘額、建議結算、支出及可取得的付款紀錄。內容會自動分頁，長名稱會換行。": {
      "comment": "native.printSettlementView.paginationNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列印全部參與者、餘額、建議結算、支出及可取得的付款紀錄。內容會自動分頁，長名稱會換行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Print all participants, balances, settlement suggestions, expenses, and available payment records. Content is paginated automatically, and long names wrap to the next line."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての参加者、残高、精算案、支出、取得可能な支払い記録を印刷します。内容は自動で改ページされ、長い名前は折り返されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 참여자, 잔액, 정산 제안, 지출 및 조회 가능한 결제 기록을 인쇄합니다. 내용은 자동으로 페이지가 나뉘며 긴 이름은 줄 바꿈됩니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी सहभागी, शेष, सुझाए गए निपटान, खर्च और उपलब्ध भुगतान रिकॉर्ड प्रिंट करें। सामग्री अपने आप पृष्ठों में बँटेगी और लंबे नाम अगली पंक्ति में जाएँगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime todos los participantes, saldos, sugerencias de liquidación, gastos y registros de pagos disponibles. El contenido se divide en páginas automáticamente y los nombres largos ocupan varias líneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime tous les participants, soldes, suggestions de règlement, dépenses et enregistrements de paiement disponibles. Le contenu est réparti automatiquement sur plusieurs pages et les noms longs passent à la ligne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime todos os participantes, saldos, sugestões de acerto, despesas e registros de pagamentos disponíveis. O conteúdo é dividido automaticamente em páginas, e nomes longos ocupam várias linhas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetak semua peserta, saldo, saran penyelesaian, pengeluaran, dan catatan pembayaran yang tersedia. Konten dibagi ke halaman secara otomatis, dan nama panjang dibungkus ke baris berikutnya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druckt alle Teilnehmer, Salden, Ausgleichsvorschläge, Ausgaben und verfügbaren Zahlungseinträge. Der Inhalt wird automatisch auf Seiten verteilt. Lange Namen werden umgebrochen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "In tất cả người tham gia, số dư, đề xuất quyết toán, khoản chi và bản ghi thanh toán hiện có. Nội dung tự phân trang, tên dài sẽ xuống dòng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm katılımcılar, bakiyeler, hesaplaşma önerileri, giderler ve mevcut ödeme kayıtları yazdırılır. İçerik otomatik olarak sayfalara bölünür; uzun adlar alt satıra geçer."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-print ang lahat ng kalahok, balanse, mungkahing pag-aayos, gastos at makukuhang tala ng bayad. Awtomatikong hahatiin sa mga pahina ang nilalaman at ililipat sa bagong linya ang mahahabang pangalan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ผู้ร่วมรายจ่าย ยอดคงเหลือ คำแนะนำการชำระยอด รายจ่าย และบันทึกการชำระเงินที่มีทั้งหมด เนื้อหาจะแบ่งหน้าโดยอัตโนมัติและชื่อยาวจะขึ้นบรรทัดใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stampa tutti i partecipanti, saldi, suggerimenti di saldo, spese e pagamenti registrati disponibili. Le pagine vengono create automaticamente e i nomi lunghi vanno a capo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukuje wszystkich uczestników, salda, sugestie rozliczenia, wydatki i dostępne zapisy płatności. Treść jest automatycznie dzielona na strony, a długie nazwy są zawijane."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetak semua peserta, baki, cadangan penyelesaian, perbelanjaan dan rekod pembayaran yang tersedia. Kandungan dibahagikan kepada halaman secara automatik, dan nama panjang dibalut ke baris seterusnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukt alle deelnemers, saldi, verrekenvoorstellen, uitgaven en beschikbare betalingsregistraties af. Pagina's worden automatisch ingedeeld. Lange namen lopen door op een nieuwe regel."
          }
        }
      }
    },
    "此分享未提供付款明細，不會列印隱藏資料。": {
      "comment": "native.printSettlementView.hiddenPayments. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分享未提供付款明細，不會列印隱藏資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shared view does not provide payment details. Hidden data will not be printed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この共有では支払いの明細が提供されていません。非公開のデータは印刷しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 공유에는 결제 내역이 제공되지 않았습니다. 숨겨진 데이터는 인쇄하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस साझाकरण में भुगतान का विवरण नहीं दिया गया; छिपा डेटा प्रिंट नहीं होगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este acceso compartido no incluye detalles de pagos; los datos ocultos no se imprimirán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce partage ne fournit pas les détails des paiements ; les données masquées ne seront pas imprimées."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este compartilhamento não fornece detalhes dos pagamentos; os dados ocultos não serão impressos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbagi ini tidak memberikan rincian pembayaran; data tersembunyi tidak akan dicetak."
          }
        },
        "de": {
          "stringUnit": {
