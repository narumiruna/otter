    "還原會變更目前支出。請比較目前內容與目標快照，再明確確認。": {
      "comment": "native.expenseHistoryView.restoreNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原會變更目前支出。請比較目前內容與目標快照，再明確確認。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring will change the current expense. Compare the current content with the target snapshot, then explicitly confirm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元すると現在の支出が変更されます。現在の内容と復元先のスナップショットを比較してから、明示的に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원하면 현재 지출이 변경됩니다. 현재 내용과 대상 스냅샷을 비교한 후 명시적으로 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापस लाने से वर्तमान खर्च बदलेगा। वर्तमान सामग्री की लक्ष्य स्नैपशॉट से तुलना करें, फिर स्पष्ट पुष्टि करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración modificará el gasto actual. Compara el contenido actual con la instantánea de destino y confírmalo expresamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration modifiera la dépense actuelle. Comparez le contenu actuel à l’instantané cible, puis confirmez explicitement."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração modificará a despesa atual. Compare o conteúdo atual com o registro de destino e confirme explicitamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan akan mengubah pengeluaran saat ini. Bandingkan konten saat ini dengan rekaman tujuan, lalu konfirmasikan secara eksplisit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellung ändert die aktuelle Ausgabe. Vergleiche den aktuellen Inhalt mit der Zielmomentaufnahme und bestätige dann ausdrücklich."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục sẽ thay đổi khoản chi hiện tại. Hãy so sánh nội dung hiện tại với bản chụp đích, rồi chủ động xác nhận."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme mevcut gideri değiştirir. Mevcut içeriği hedef anlık görüntüyle karşılaştırın ve açıkça onaylayın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mababago ng pagpapanumbalik ang kasalukuyang gastos. Ihambing ang kasalukuyang nilalaman sa target na snapshot, saka tahasang kumpirmahin."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกู้คืนจะเปลี่ยนรายจ่ายปัจจุบัน โปรดเปรียบเทียบข้อมูลปัจจุบันกับภาพรวมเป้าหมาย แล้วจึงยืนยันอย่างชัดเจน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino modifica la spesa attuale. Confronta i contenuti attuali con l'istantanea di destinazione, poi conferma esplicitamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócenie zmieni bieżący wydatek. Porównaj obecną treść z docelowym zapisem stanu, a następnie jawnie potwierdź."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan akan mengubah perbelanjaan semasa. Bandingkan kandungan semasa dengan petikan sasaran, kemudian sahkan secara nyata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstellen wijzigt de huidige uitgave. Vergelijk de huidige inhoud met de doelmomentopname en bevestig daarna uitdrukkelijk."
          }
        }
      }
    },
    "尚未取得可還原的目前版本。請重新載入還原檢查。": {
      "comment": "native.expenseHistoryView.missingCurrentVersion. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未取得可還原的目前版本。請重新載入還原檢查。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current version needed for restoration has not been obtained. Reload the restoration review."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元に必要な現在のバージョンをまだ取得できていません。復元前の確認を再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원에 필요한 현재 버전을 아직 가져오지 못했습니다. 복원 검토를 다시 불러오세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापस लाने योग्य वर्तमान संस्करण अभी नहीं मिला। वापसी की जाँच दोबारा लोड करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha obtenido la versión actual necesaria para restaurar. Vuelve a cargar la revisión de restauración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version actuelle nécessaire à la restauration n’a pas encore été obtenue. Rechargez la vérification de restauration."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão atual necessária para restaurar ainda não foi obtida. Recarregue a revisão de restauração."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi saat ini yang dapat dipulihkan belum diperoleh. Muat ulang pemeriksaan pemulihan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine aktuelle Version für die Wiederherstellung liegt noch nicht vor. Lade die Wiederherstellungsprüfung erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa lấy được phiên bản hiện tại có thể khôi phục. Hãy tải lại phần kiểm tra khôi phục."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme için mevcut sürüm henüz alınmadı. Geri yükleme kontrolünü yeniden yükleyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa nakuha ang kasalukuyang bersyong maaaring ibalik. I-load muli ang pagsusuri sa pagpapanumbalik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้รับเวอร์ชันปัจจุบันที่กู้คืนได้ โปรดโหลดการตรวจสอบการกู้คืนใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora disponibile una versione attuale per il ripristino. Ricarica il controllo del ripristino."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie pobrano jeszcze bieżącej wersji potrzebnej do przywrócenia. Wczytaj ponownie kontrolę przywracania."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi semasa yang boleh dipulihkan belum diperoleh. Muat semula semakan pemulihan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog geen huidige versie beschikbaar voor herstel. Laad de herstelcontrole opnieuw."
          }
        }
      }
    },
