    "請選取參與者以修改名稱、結算代表人或合併資料。": {
      "comment": "native.peopleView.selectionHelp. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選取參與者以修改名稱、結算代表人或合併資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a participant to change their name or settlement representative, or to merge data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者を選択して、名前や精算代表者の変更、データの統合を行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여자를 선택하여 이름이나 정산 대표자를 변경하거나 데이터를 병합하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम या निपटान प्रतिनिधि बदलने या डेटा मिलाने के लिए सहभागी चुनें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un participante para cambiar su nombre o representante de liquidación, o fusionar sus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un participant pour modifier son nom ou son représentant de règlement, ou pour fusionner ses données."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um participante para alterar o nome ou o representante de acerto, ou para mesclar os dados."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih peserta untuk mengubah nama, perwakilan penyelesaian, atau menggabungkan data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Teilnehmer, um den Namen oder Abrechnungsvertreter zu ändern oder Daten zusammenzuführen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn người tham gia để sửa tên, người đại diện quyết toán hoặc gộp dữ liệu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adını veya hesaplaşma temsilcisini değiştirmek ya da verilerini birleştirmek için bir katılımcı seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng kalahok upang baguhin ang pangalan, kinatawan sa pag-aayos ng bayarin, o pagsamahin ang datos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดเลือกผู้ร่วมรายจ่ายเพื่อเปลี่ยนชื่อ ตัวแทนชำระยอด หรือรวมข้อมูล"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un partecipante per modificare nome o rappresentante per il saldo, oppure unire i dati."
          }
        },
        "pl": {
