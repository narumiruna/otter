        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ xác nhận chưa ghi sổ, hãy sửa bản nháp"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu kayda geçmediğini doğruladı; taslağı düzeltin"
          }
        },
        "fil": {
          "stringUnit": {
