      }
    },
    "參與者用於分攤支出，不會取得帳號存取權。邀請帳號請使用「存取與分享」。": {
      "comment": "native.peopleView.accessNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參與者用於分攤支出，不會取得帳號存取權。邀請帳號請使用「存取與分享」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participants are used to split expenses and do not receive account access. Use “Access and sharing” to invite accounts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者は支出の分担に使用され、アカウントのアクセス権は付与されません。アカウントの招待には「アクセスと共有」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여자는 지출 분담에 사용되며 계정 접근 권한을 얻지 않습니다. 계정을 초대하려면 ‘접근 및 공유’를 사용하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहभागी खर्च बाँटने के लिए हैं; उन्हें खाते की पहुँच नहीं मिलती। खाते आमंत्रित करने के लिए “पहुँच और साझाकरण” इस्तेमाल करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los participantes sirven para repartir gastos; no obtienen acceso de cuenta. Para invitar cuentas, usa «Acceso y uso compartido»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les participants servent au partage des dépenses et ne reçoivent pas d’accès de compte. Pour inviter des comptes, utilisez « Accès et partage »."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os participantes são usados no rateio de despesas e não recebem acesso de conta. Para convidar contas, use “Acesso e compartilhamento”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peserta digunakan untuk membagi pengeluaran dan tidak memperoleh hak akses akun. Untuk mengundang akun, gunakan “Akses dan berbagi”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilnehmer dienen der Ausgabenaufteilung und erhalten keinen Kontozugriff. Verwende „Zugriff und Freigabe“, um Konten einzuladen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người tham gia dùng để chia khoản chi, không nhận quyền truy cập tài khoản. Để mời tài khoản, hãy dùng “Truy cập và chia sẻ”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılımcılar gider paylaşımı içindir; hesap erişim hakkı almazlar. Hesap davet etmek için “Erişim ve paylaşım” bölümünü kullanın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga kalahok ay para sa paghahati ng gastos, hindi sila nagkakaroon ng pag-access sa account. Gamitin ang “Pag-access at pagbabahagi” para mag-imbita ng mga account."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ร่วมรายจ่ายใช้สำหรับแบ่งรายจ่าย ไม่ได้รับสิทธิ์เข้าถึงของบัญชี หากต้องการเชิญบัญชี ให้ใช้ “การเข้าถึงและการแชร์”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I partecipanti servono a dividere le spese e non ottengono accesso tramite account. Per invitare account usa «Accesso e condivisione»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uczestnicy służą do podziału wydatków i nie otrzymują dostępu konta. Do zapraszania kont użyj sekcji „Dostęp i udostępnianie”."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peserta digunakan untuk berkongsi perbelanjaan dan tidak mendapat hak akses akaun. Untuk menjemput akaun, gunakan “Akses dan perkongsian”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deelnemers worden gebruikt om uitgaven te verdelen en krijgen geen accounttoegang. Gebruik ‘Toegang en delen’ om accounts uit te nodigen."
          }
        }
      }
    },
    "群組已封存，無法變更參與者。": {
      "comment": "native.peopleView.archivedNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組已封存，無法變更參與者。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group is archived. Participants cannot be changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
