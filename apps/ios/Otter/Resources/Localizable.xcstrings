          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflitto di permessi, gruppo o dati. Richiesta originale conservata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konflikt uprawnień, grupy lub danych. Zachowano pierwotne żądanie"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
