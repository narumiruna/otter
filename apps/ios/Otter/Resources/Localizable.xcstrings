          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter uniquement la dépense à la file hors ligne"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas adicionar despesa à fila offline"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tambahkan pengeluaran ke antrean luring"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe nur zur Offline-Warteschlange hinzufügen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thêm khoản chi vào hàng đợi ngoại tuyến"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gideri yalnızca çevrimdışı kuyruğa ekle"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idagdag lamang ang gastos sa offline na pila"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มรายจ่ายเข้าคิวออฟไลน์เท่านั้น"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la spesa solo alla coda offline"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj wydatek tylko do kolejki offline"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tambah perbelanjaan ke baris gilir luar talian"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgave alleen in offlinewachtrij plaatsen"
          }
        }
      }
    },
    "離線佇列不儲存照片。請先移除所選照片。加入佇列後，不會在此表單再次新增。": {
      "comment": "native.expenseEditorView.queuePhotoNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線佇列不儲存照片。請先移除所選照片。加入佇列後，不會在此表單再次新增。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offline queue does not store photos. Remove the selected photo first. Once queued, the expense will not be added again from this form."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインキューには写真を保存しません。先に選択した写真を削除してください。キューへの追加後、このフォームで再度追加することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 대기열에는 사진을 저장하지 않습니다. 먼저 선택한 사진을 제거하세요. 대기열에 추가한 후에는 이 양식에서 다시 추가하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन कतार तस्वीरें नहीं सहेजती। पहले चुनी गई तस्वीर हटाएँ। कतार में जोड़ने के बाद इस फ़ॉर्म से दोबारा नहीं जोड़ा जाएगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cola sin conexión no guarda fotos. Elimina primero la foto seleccionada. Una vez añadido a la cola, no se volverá a añadir desde este formulario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La file hors ligne ne conserve pas les photos. Retirez d’abord la photo sélectionnée. Une fois la dépense mise en file, ce formulaire ne l’ajoutera pas à nouveau."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A fila offline não salva fotos. Remova primeiro a foto selecionada. Após adicionar à fila, a despesa não será adicionada novamente neste formulário."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrean luring tidak menyimpan foto. Hapus foto yang dipilih terlebih dahulu. Setelah ditambahkan ke antrean, formulir ini tidak akan menambahkan lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Offline-Warteschlange speichert keine Fotos. Entferne zuerst das ausgewählte Foto. Nach dem Einreihen wird die Ausgabe in diesem Formular nicht erneut hinzugefügt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàng đợi ngoại tuyến không lưu ảnh. Hãy xóa ảnh đã chọn trước. Sau khi thêm vào hàng đợi, biểu mẫu này sẽ không thêm lần nữa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı kuyruk fotoğraf saklamaz. Önce seçilen fotoğrafı kaldırın. Kuyruğa eklendikten sonra bu formdan yeniden eklenmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nagse-save ng larawan ang offline na pila. Alisin muna ang napiling larawan. Pagkapila, hindi na ito idaragdag muli sa form na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คิวออฟไลน์ไม่บันทึกรูปภาพ โปรดนำรูปที่เลือกออกก่อน หลังเข้าคิวแล้ว แบบฟอร์มนี้จะไม่เพิ่มซ้ำ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La coda offline non salva foto. Rimuovi prima la foto selezionata. Una volta aggiunta alla coda, la spesa non verrà aggiunta di nuovo da questo modulo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejka offline nie przechowuje zdjęć. Najpierw usuń wybrane zdjęcie. Po dodaniu do kolejki ten formularz nie doda wydatku ponownie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baris gilir luar talian tidak menyimpan foto. Alih keluar foto yang dipilih dahulu. Selepas ditambah ke baris gilir, borang ini tidak akan menambah lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De offlinewachtrij slaat geen foto's op. Verwijder eerst de geselecteerde foto. Na toevoeging aan de wachtrij wordt de uitgave niet opnieuw via dit formulier toegevoegd."
          }
        }
      }
    },
