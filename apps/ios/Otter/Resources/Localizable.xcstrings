    "這筆支出已被修改。請保留草稿，重新載入並確認最新內容後再操作。": {
      "comment": "native.clientAuthentication.versionConflict. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆支出已被修改。請保留草稿，重新載入並確認最新內容後再操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This expense has been changed. Keep your draft, reload, and confirm the latest content before continuing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この支出は変更されています。下書きを保持し、再読み込みして最新の内容を確認してから操作してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지출은 이미 수정되었습니다. 초안을 유지하고 다시 불러와 최신 내용을 확인한 후 작업하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह खर्च बदल दिया गया है। ड्राफ़्ट रखें, दोबारा लोड करें और नवीनतम सामग्री जाँचकर फिर कार्रवाई करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este gasto se ha modificado. Conserva el borrador, vuelve a cargar y comprueba el contenido más reciente antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette dépense a été modifiée. Conservez le brouillon, rechargez et vérifiez le contenu le plus récent avant de continuer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta despesa foi modificada. Mantenha o rascunho, recarregue e confira o conteúdo mais recente antes de continuar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran ini telah diubah. Pertahankan draf, muat ulang, dan konfirmasikan konten terbaru sebelum melakukan operasi lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ausgabe wurde geändert. Behalte den Entwurf, lade erneut und prüfe den aktuellen Inhalt, bevor du fortfährst."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoản chi này đã được sửa. Hãy giữ bản nháp, tải lại và xác nhận nội dung mới nhất trước khi thao tác."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gider değiştirildi. Taslağı koruyun, yeniden yükleyin ve işlem yapmadan önce en güncel içeriği kontrol edin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabago na ang gastos na ito. Panatilihin ang draft, i-load muli at tiyakin ang pinakabagong nilalaman bago kumilos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายจ่ายนี้ถูกแก้ไขแล้ว โปรดเก็บฉบับร่างไว้ โหลดใหม่และยืนยันข้อมูลล่าสุดก่อนดำเนินการ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa spesa è stata modificata. Conserva la bozza, ricarica e verifica i contenuti aggiornati prima di procedere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wydatek został zmieniony. Zachowaj szkic, wczytaj ponownie i sprawdź najnowszą treść przed dalszą operacją."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbelanjaan ini telah diubah. Kekalkan draf, muat semula dan sahkan kandungan terkini sebelum melakukan operasi lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze uitgave is gewijzigd. Behoud het concept, laad opnieuw en controleer de nieuwste inhoud voordat je doorgaat."
          }
        }
      }
    },
    "此裝置資料的帳號或群組識別無效。": {
      "comment": "native.expenseQueue.invalidContext. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置資料的帳號或群組識別無效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account or group ID in this device's data is invalid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのデータに含まれるアカウントまたはグループのIDが無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 데이터의 계정 또는 그룹 ID가 유효하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस के डेटा में खाते या समूह की पहचान अमान्य है।"
          }
        },
        "es": {
