            "state": "translated",
            "value": "Te herstellen inhoud"
          }
        }
      }
    },
    "舊收據圖片不會還原。還原支出後，需重新上傳收據。": {
      "comment": "native.expenseHistoryView.oldReceiptNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊收據圖片不會還原。還原支出後，需重新上傳收據。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old receipt images will not be restored. Upload the receipt again after restoring the expense."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い領収書の画像は復元されません。支出の復元後、領収書を再度アップロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 영수증 이미지는 복원되지 않습니다. 지출을 복원한 후 영수증을 다시 업로드해야 합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुरानी रसीद की तस्वीर वापस नहीं आएगी। खर्च वापस लाने के बाद रसीद फिर अपलोड करनी होगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes de recibos anteriores no se restaurarán. Tendrás que volver a subir el recibo después de restaurar el gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciennes images de reçus ne seront pas restaurées. Vous devrez envoyer à nouveau le reçu après avoir restauré la dépense."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens antigas dos recibos não serão restauradas. Será necessário enviar o recibo novamente após restaurar a despesa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar tanda terima lama tidak akan dipulihkan. Setelah memulihkan pengeluaran, Anda perlu mengunggah ulang tanda terima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Belegbilder werden nicht wiederhergestellt. Lade den Beleg nach der Wiederherstellung der Ausgabe erneut hoch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh biên lai cũ sẽ không được khôi phục. Sau khi khôi phục khoản chi, cần tải lại biên lai lên."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski makbuz görseli geri yüklenmez. Gideri geri yükledikten sonra makbuzu yeniden yüklemeniz gerekir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ibabalik ang lumang larawan ng resibo. Kailangang i-upload muli ang resibo matapos ibalik ang gastos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปใบเสร็จเดิมจะไม่ถูกกู้คืน หลังจากกู้คืนรายจ่ายต้องอัปโหลดใบเสร็จใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vecchie immagini delle ricevute non verranno ripristinate. Dopo il ripristino della spesa dovrai caricare di nuovo la ricevuta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stary obraz paragonu nie zostanie przywrócony. Po przywróceniu wydatku trzeba ponownie przesłać paragon."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej resit lama tidak akan dipulihkan. Selepas memulihkan perbelanjaan, anda perlu memuat naik semula resit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oude bonafbeeldingen worden niet hersteld. Upload de bon opnieuw nadat de uitgave is hersteld."
          }
        }
      }
    },
    "會保留目前收據，不會還原此快照的舊收據圖片。": {
      "comment": "native.expenseHistoryView.keepCurrentReceiptNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會保留目前收據，不會還原此快照的舊收據圖片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current receipt will be retained. The old receipt image in this snapshot will not be restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の領収書を保持します。このスナップショットの古い領収書画像は復元しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 영수증을 유지하며 이 스냅샷의 이전 영수증 이미지는 복원하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान रसीद रहेगी; इस स्नैपशॉट की पुरानी रसीद की तस्वीर वापस नहीं आएगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservará el recibo actual; no se restaurará la imagen del recibo anterior de esta instantánea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reçu actuel sera conservé ; l’ancienne image de reçu de cet instantané ne sera pas restaurée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O recibo atual será mantido; a imagem antiga do recibo deste registro não será restaurada."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda terima saat ini dipertahankan; gambar tanda terima lama dalam rekaman ini tidak dipulihkan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Beleg bleibt erhalten. Das alte Belegbild dieser Momentaufnahme wird nicht wiederhergestellt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ giữ biên lai hiện tại, không khôi phục ảnh biên lai cũ trong bản chụp này."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut makbuz korunur; bu anlık görüntüdeki eski makbuz görseli geri yüklenmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pananatilihin ang kasalukuyang resibo; hindi ibabalik ang lumang larawan ng resibo sa snapshot na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะเก็บใบเสร็จปัจจุบันไว้ ไม่กู้คืนรูปใบเสร็จเดิมของภาพรวมนี้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricevuta attuale verrà mantenuta. La vecchia immagine di questa istantanea non verrà ripristinata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżący paragon zostanie zachowany. Stary obraz paragonu z tego zapisu stanu nie zostanie przywrócony."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Resit semasa dikekalkan; imej resit lama dalam petikan ini tidak dipulihkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige bon blijft behouden. De oude bonafbeelding uit deze momentopname wordt niet hersteld."
          }
        }
      }
    },
    "目標快照的付款人或分攤成員已不存在。不能還原；請先修正群組成員。": {
      "comment": "native.expenseHistoryView.missingParticipantNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標快照的付款人或分攤成員已不存在。不能還原；請先修正群組成員。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payer or a split participant in the target snapshot no longer exists. Restoration is not allowed. Correct the group members first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元先のスナップショットの支払者または分担者がすでに存在しません。復元できません。先にグループのメンバーを修正してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 스냅샷의 결제자 또는 분담 구성원이 더 이상 존재하지 않습니다. 복원할 수 없으므로 먼저 그룹 구성원을 수정하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य स्नैपशॉट का भुगतानकर्ता या हिस्सेदार अब मौजूद नहीं है। वापस नहीं ला सकते; पहले समूह के सदस्य सुधारें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pagador o un miembro del reparto de la instantánea de destino ya no existe. No se puede restaurar; corrige primero los miembros del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le payeur ou un membre du partage de l’instantané cible n’existe plus. La restauration est impossible ; corrigez d’abord les membres du groupe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagador ou um membro do rateio do registro de destino não existe mais. Não é possível restaurar; corrija primeiro os membros do grupo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayar atau anggota pembagian dalam rekaman tujuan tidak lagi ada. Tidak dapat memulihkan; perbaiki anggota grup terlebih dahulu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zahler oder ein Teilnehmer der Aufteilung in der Zielmomentaufnahme ist nicht mehr vorhanden. Wiederherstellung nicht möglich. Korrigiere zuerst die Gruppenmitglieder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người trả hoặc thành viên chia khoản chi trong bản chụp đích không còn tồn tại. Không thể khôi phục; hãy sửa thành viên nhóm trước."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef anlık görüntüdeki ödeyen veya paylaşan üyeler artık mevcut değil. Geri yüklenemez; önce grup üyelerini düzeltin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala na ang nagbayad o kabahagi sa target na snapshot. Hindi maibabalik; ayusin muna ang mga miyembro ng grupo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้จ่ายหรือผู้ร่วมแบ่งในภาพรวมเป้าหมายไม่มีอยู่แล้ว จึงกู้คืนไม่ได้ โปรดแก้ไขสมาชิกกลุ่มก่อน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagatore o un partecipante alla divisione dell'istantanea di destinazione non esiste più. Ripristino impossibile. Correggi prima i membri del gruppo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatnik lub członkowie podziału z docelowego zapisu stanu już nie istnieją. Nie można przywrócić wydatku. Najpierw popraw członków grupy."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayar atau ahli perkongsian dalam petikan sasaran tidak lagi wujud. Tidak boleh pulihkan; betulkan ahli kumpulan dahulu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betaler of een deelnemer aan de verdeling uit de doelmomentopname bestaat niet meer. Herstellen is niet mogelijk. Corrigeer eerst de groepsleden."
          }
        }
      }
    },
    "支出又有變更。已重新載入最新內容。請重新比較，確認後才能還原。": {
      "comment": "native.expenseHistoryView.concurrentChange. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出又有變更。已重新載入最新內容。請重新比較，確認後才能還原。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expense changed again. The latest content has been reloaded. Compare it again and confirm before restoring."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出が再び変更されました。最新の内容を再読み込みしました。再度比較して確認してから復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출이 다시 변경되었습니다. 최신 내용을 다시 불러왔습니다. 다시 비교하고 확인해야 복원할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च फिर बदल गया है। नवीनतम सामग्री फिर लोड की गई है। दोबारा तुलना करें; पुष्टि के बाद ही वापस ला सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto ha vuelto a cambiar. Se ha cargado el contenido más reciente. Compara de nuevo y confirma antes de restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dépense a encore changé. Le contenu le plus récent a été rechargé. Comparez à nouveau et confirmez avant de restaurer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A despesa mudou novamente. O conteúdo mais recente foi recarregado. Compare novamente e confirme antes de restaurar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran berubah lagi. Konten terbaru telah dimuat ulang. Bandingkan lagi dan konfirmasikan sebelum memulihkan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe wurde erneut geändert. Der aktuelle Inhalt wurde neu geladen. Vergleiche erneut und bestätige, bevor du wiederherstellst."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoản chi lại có thay đổi. Đã tải lại nội dung mới nhất. Hãy so sánh lại và xác nhận trước khi khôi phục."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gider yeniden değişti. En güncel içerik yeniden yüklendi. Geri yüklemeden önce yeniden karşılaştırıp onaylayın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago muli ang gastos. Na-load na ang pinakabagong nilalaman. Ihambing muli at kumpirmahin bago maibalik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายจ่ายมีการเปลี่ยนแปลงอีกแล้ว โหลดข้อมูลล่าสุดแล้ว โปรดเปรียบเทียบใหม่และยืนยันก่อนกู้คืน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La spesa è cambiata di nuovo. I contenuti aggiornati sono stati ricaricati. Confrontali di nuovo e conferma prima di ripristinare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatek znów się zmienił. Wczytano najnowszą treść. Porównaj ją ponownie i potwierdź przed przywróceniem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbelanjaan berubah lagi. Kandungan terkini telah dimuat semula. Bandingkan semula dan sahkan sebelum memulihkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgave is opnieuw gewijzigd. De nieuwste inhoud is opnieuw geladen. Vergelijk opnieuw en bevestig voordat je herstelt."
          }
        }
      }
    },
    "已比較最新內容": {
      "comment": "native.expenseHistoryView.compared. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已比較最新內容"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest content compared"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の内容を比較済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 내용 비교 완료"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीनतम सामग्री से तुलना की गई"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He comparado el contenido más reciente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai comparé le contenu le plus récent"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já comparei o conteúdo mais recente"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah membandingkan konten terbaru"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuellen Inhalt verglichen"
          }
        },
        "vi": {
