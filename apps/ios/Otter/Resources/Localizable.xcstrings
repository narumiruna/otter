    },
    "請先完成付款。此操作只記錄已付款，不會進行實際轉帳。": {
      "comment": "native.paymentEditorView.noTransferNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先完成付款。此操作只記錄已付款，不會進行實際轉帳。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the payment first. This operation only records a completed payment and does not make an actual transfer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に支払いを完了してください。この操作は完了した支払いを記録するだけで、実際の送金は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 결제를 완료하세요. 이 작업은 완료된 결제만 기록하며 실제 이체는 하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले भुगतान पूरा करें। यह कार्रवाई केवल किया गया भुगतान दर्ज करती है; वास्तविक धन हस्तांतरण नहीं करती।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realiza primero el pago. Esta operación solo registra un pago realizado; no efectúa una transferencia real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuez d’abord le paiement. Cette opération enregistre uniquement un paiement effectué et n’exécute aucun virement réel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Realize primeiro o pagamento. Esta operação apenas registra um pagamento realizado; não faz uma transferência real."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan pembayaran terlebih dahulu. Operasi ini hanya mencatat pembayaran selesai, tanpa melakukan transfer sebenarnya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe zuerst die Zahlung aus. Dieser Vorgang erfasst nur eine erfolgte Zahlung und führt keine tatsächliche Überweisung aus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hoàn tất thanh toán trước. Thao tác này chỉ ghi nhận đã thanh toán, không thực hiện chuyển khoản thực tế."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce ödemeyi tamamlayın. Bu işlem yalnızca yapılan ödemeyi kaydeder; gerçek banka transferi yapmaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpletuhin muna ang bayad. Itinatala lamang nito na nabayaran na; wala itong aktuwal na paglilipat ng pera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดชำระเงินให้เสร็จก่อน การดำเนินการนี้บันทึกว่าชำระแล้วเท่านั้น ไม่โอนเงินจริง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa prima il pagamento. Questa operazione registra solo un pagamento effettuato e non esegue trasferimenti reali."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dokonaj płatności. Ta operacja tylko zapisuje dokonaną płatność i nie wykonuje rzeczywistego przelewu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan pembayaran dahulu. Operasi ini hanya merekodkan pembayaran selesai, tanpa membuat pindahan sebenar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi eerst de betaling. Dit registreert alleen een voltooide betaling en voert geen werkelijke overboeking uit."
          }
        }
      }
    },
