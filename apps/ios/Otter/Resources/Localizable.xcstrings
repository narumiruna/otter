    "%@ 已付給 %@ %@\n付款日期：%@\n此操作不會進行實際轉帳。": {
      "comment": "native.paymentEditorView.paymentConfirmation. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已付給 %2$@ %3$@\n付款日期：%4$@\n此操作不會進行實際轉帳。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ paid %2$@ %3$@\nPayment date: %4$@\nThis operation does not make an actual transfer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が%2$@に%3$@を支払い済み\n支払日：%4$@\nこの操作は実際の送金を行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ → %2$@ 결제 완료: %3$@\n결제 날짜: %4$@\n이 작업은 실제 이체를 하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ने %2$@ को %3$@ का भुगतान किया है\nभुगतान की तारीख: %4$@\nयह कार्रवाई वास्तविक धन हस्तांतरण नहीं करेगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha pagado %3$@ a %2$@\nFecha del pago: %4$@\nEsta operación no efectúa una transferencia real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a payé %3$@ à %2$@\nDate du paiement : %4$@\nCette opération n’exécute aucun virement réel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pagou %3$@ a %2$@\nData do pagamento: %4$@\nEsta operação não faz uma transferência real."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ telah membayar %3$@ kepada %2$@\nTanggal pembayaran: %4$@\nOperasi ini tidak melakukan transfer sebenarnya."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat %3$@ an %2$@ bezahlt.\nZahlungsdatum: %4$@\nDieser Vorgang führt keine tatsächliche Überweisung aus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã trả %3$@ cho %2$@\nNgày thanh toán: %4$@\nThao tác này không thực hiện chuyển khoản thực tế."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarafından %2$@ kişisine %3$@ ödendi\nÖdeme tarihi: %4$@\nBu işlem gerçek banka transferi yapmaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbayad na si %1$@ kay %2$@ ng %3$@\nPetsa ng bayad: %4$@\nWalang aktuwal na paglilipat ng pera ang pagkilos na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ชำระให้ %2$@ แล้ว %3$@\nวันที่ชำระ: %4$@\nการดำเนินการนี้จะไม่โอนเงินจริง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha pagato %3$@ a %2$@.\nData del pagamento: %4$@\nQuesta operazione non esegue trasferimenti reali."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zapłacił(a) na rzecz %2$@ kwotę %3$@\nData płatności: %4$@\nTa operacja nie wykonuje rzeczywistego przelewu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ telah membayar %3$@ kepada %2$@\nTarikh pembayaran: %4$@\nOperasi ini tidak membuat pindahan sebenar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft %3$@ aan %2$@ betaald.\nBetalingsdatum: %4$@\nDit voert geen werkelijke overboeking uit."
          }
        }
      }
    },
    "群組資料已變更，未套用過期回應。請重新載入以確認付款紀錄。": {
      "comment": "native.paymentEditorView.staleResponse. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組資料已變更，未套用過期回應。請重新載入以確認付款紀錄。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group data changed. The outdated response was not applied. Reload to confirm payment records."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループのデータが変更されたため、古い応答は適用していません。再読み込みして支払いの記録を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 데이터가 변경되어 오래된 응답을 적용하지 않았습니다. 다시 불러와 결제 기록을 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह का डेटा बदल गया है; पुराना उत्तर लागू नहीं किया गया। भुगतान रिकॉर्ड की पुष्टि के लिए दोबारा लोड करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos del grupo han cambiado; no se ha aplicado la respuesta obsoleta. Vuelve a cargar para comprobar los registros de pagos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données du groupe ont changé ; la réponse périmée n’a pas été appliquée. Rechargez pour vérifier les enregistrements de paiement."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do grupo mudaram; a resposta desatualizada não foi aplicada. Recarregue para conferir os registros de pagamentos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data grup telah berubah; respons kedaluwarsa tidak diterapkan. Muat ulang untuk mengonfirmasi catatan pembayaran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppendaten haben sich geändert. Die veraltete Antwort wurde nicht angewendet. Lade erneut, um die Zahlungseinträge zu prüfen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu nhóm đã thay đổi, chưa áp dụng phản hồi cũ. Hãy tải lại để xác nhận bản ghi thanh toán."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup verileri değişti; güncel olmayan yanıt uygulanmadı. Ödeme kayıtlarını doğrulamak için yeniden yükleyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang datos ng grupo; hindi inilapat ang lumang tugon. I-load muli upang tiyakin ang tala ng bayad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลกลุ่มเปลี่ยนแล้ว ไม่ได้นำคำตอบเก่ามาใช้ โปรดโหลดใหม่เพื่อยืนยันบันทึกการชำระเงิน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati del gruppo sono cambiati. La risposta scaduta non è stata applicata. Ricarica per verificare i pagamenti registrati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane grupy uległy zmianie. Nie zastosowano nieaktualnej odpowiedzi. Wczytaj ponownie, aby sprawdzić zapisy płatności."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data kumpulan telah berubah; respons lapuk tidak digunakan. Muat semula untuk mengesahkan rekod pembayaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De groepsgegevens zijn gewijzigd. Het verouderde antwoord is niet toegepast. Laad opnieuw om de betalingsregistraties te controleren."
          }
        }
      }
    },
