            "value": "Valores predeterminados locales borrados; el formulario actual no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs locales par défaut effacées ; le formulaire actuel reste inchangé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores padrão locais apagados; o formulário atual não mudou."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai bawaan lokal telah dihapus; formulir saat ini tidak berubah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Vorgaben gelöscht. Das aktuelle Formular bleibt unverändert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa giá trị mặc định cục bộ; biểu mẫu hiện tại không thay đổi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel varsayılanlar temizlendi; mevcut form değişmedi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-clear ang mga lokal na default; hindi nagbago ang kasalukuyang form."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างค่าเริ่มต้นในอุปกรณ์แล้ว แบบฟอร์มปัจจุบันไม่เปลี่ยน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori predefiniti locali cancellati. Il modulo attuale non cambia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto lokalne wartości domyślne. Bieżący formularz pozostaje bez zmian."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai lalai setempat telah dikosongkan; borang semasa tidak berubah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale standaardwaarden gewist. Het huidige formulier blijft ongewijzigd."
          }
        }
      }
    },
    "已儲存幣別及分攤預設值。未儲存金額、付款人、日期、說明、標籤或照片。": {
      "comment": "native.expenseEditorState.defaultsSaved. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存幣別及分攤預設值。未儲存金額、付款人、日期、說明、標籤或照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currency and split defaults saved. Amount, payer, date, description, tags, and photos were not saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨と分担の既定値を保存しました。金額、支払者、日付、説明、タグ、写真は保存していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화와 분담 기본값을 저장했습니다. 금액, 결제자, 날짜, 설명, 태그, 사진은 저장하지 않았습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुद्रा और बाँटने के डिफ़ॉल्ट सहेजे गए। राशि, भुगतानकर्ता, तारीख, विवरण, टैग या तस्वीर नहीं सहेजी गई।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han guardado los valores predeterminados de moneda y reparto. No se han guardado el importe, el pagador, la fecha, la descripción, las etiquetas ni las fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs par défaut de devise et de partage sont enregistrées. Le montant, le payeur, la date, la description, les étiquettes et les photos ne sont pas enregistrés."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores padrão de moeda e rateio foram salvos. Não foram salvos valor, pagador, data, descrição, etiquetas ou fotos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mata uang dan nilai bawaan pembagian telah disimpan. Jumlah, pembayar, tanggal, deskripsi, tag, dan foto tidak disimpan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Währungs- und Aufteilungsvorgaben gespeichert. Betrag, Zahler, Datum, Beschreibung, Tags und Fotos wurden nicht gespeichert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu tiền tệ và mặc định chia. Không lưu số tiền, người trả, ngày, mô tả, nhãn hoặc ảnh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para birimi ve paylaşım varsayılanları kaydedildi. Tutar, ödeyen, tarih, açıklama, etiketler veya fotoğraflar kaydedilmedi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-save ang mga default sa salapi at paghahati. Hindi na-save ang halaga, nagbayad, petsa, paglalarawan, mga tag o larawan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกค่าเริ่มต้นของสกุลเงินและการแบ่งแล้ว ไม่ได้บันทึกจำนวนเงิน ผู้จ่าย วันที่ คำอธิบาย แท็ก หรือรูปภาพ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta e divisione predefinite salvate. Importo, pagatore, data, descrizione, etichette e foto non sono stati salvati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano domyślną walutę i podział. Nie zapisano kwoty, płatnika, daty, opisu, etykiet ani zdjęć."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mata wang dan nilai lalai perkongsian telah disimpan. Amaun, pembayar, tarikh, keterangan, tag dan foto tidak disimpan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaardwaarden voor valuta en verdeling opgeslagen. Bedrag, betaler, datum, beschrijving, labels en foto's zijn niet opgeslagen."
          }
        }
      }
    },
    "另一項支出操作仍在處理中。": {
