            "value": "ตัวอย่างยอดคงเหลือ (ปัจจุบัน → หลังเปลี่ยน)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima dei saldi (attuali → dopo la modifica)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podgląd sald (obecnie → po zmianie)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton baki (semasa → selepas perubahan)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldovoorbeeld (huidig → na wijziging)"
          }
        }
      }
    },
    "付款明細不可用，無法準確預覽結算餘額。": {
      "comment": "native.groupSettingsView.missingPayments. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款明細不可用，無法準確預覽結算餘額。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment details are unavailable, so settlement balances cannot be previewed accurately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いの明細を取得できないため、精算残高を正確にプレビューできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 내역을 사용할 수 없어 정산 잔액을 정확하게 미리 볼 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान का विवरण उपलब्ध नहीं है; निपटान शेष का सटीक पूर्वावलोकन नहीं कर सकते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles de pagos no están disponibles; no se pueden previsualizar con precisión los saldos de liquidación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails des paiements sont indisponibles ; impossible de prévisualiser précisément les soldes de règlement."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os detalhes dos pagamentos estão indisponíveis; não é possível mostrar uma prévia precisa dos saldos de acerto."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rincian pembayaran tidak tersedia; saldo penyelesaian tidak dapat dipratinjau secara akurat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungsdetails sind nicht verfügbar. Eine genaue Vorschau der Abrechnungssalden ist nicht möglich."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có chi tiết thanh toán, không thể xem trước chính xác số dư quyết toán."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme ayrıntıları kullanılamıyor; hesaplaşma bakiyesi doğru şekilde önizlenemiyor."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang mga detalye ng bayad; hindi maipapakita nang tumpak ang paunang balanse ng pag-aayos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายละเอียดการชำระเงิน จึงแสดงตัวอย่างยอดคงเหลือเพื่อชำระอย่างแม่นยำไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dettagli dei pagamenti non disponibili. Impossibile mostrare un'anteprima accurata dei saldi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szczegóły płatności są niedostępne. Nie można dokładnie wyświetlić podglądu sald rozliczenia."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butiran pembayaran tidak tersedia; baki penyelesaian tidak dapat dipratonton dengan tepat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalingsdetails ontbreken. Een nauwkeurig voorbeeld van verrekeningssaldi is niet mogelijk."
          }
        }
      }
    },
