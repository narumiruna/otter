    "Visa 換算金額超出範圍。": {
      "comment": "native.backupPreview.visaAmountOutOfRange. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa 換算金額超出範圍。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Visa converted amount is out of range."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa の換算後の金額が範囲外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa 환산 금액이 허용 범위를 벗어났습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa से बदली गई राशि अनुमत सीमा से बाहर है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe convertido con Visa está fuera del intervalo permitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant converti avec Visa dépasse la plage autorisée."
          }
        },
        "pt": {
