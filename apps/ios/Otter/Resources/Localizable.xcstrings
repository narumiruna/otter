            "state": "translated",
            "value": "เซิร์ฟเวอร์ยืนยันว่ายังไม่ได้ลงบัญชี โปรดแก้ไขฉบับร่าง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha confermato che la spesa non è stata contabilizzata. Correggi la bozza."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer potwierdził brak księgowania. Popraw szkic"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan telah mengesahkan ia belum direkodkan; betulkan draf"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft bevestigd dat niets is geboekt. Corrigeer het concept."
          }
        }
      }
    },
    "權限、群組或資料衝突；保留原請求": {
      "comment": "native.expenseQueueView.conflict. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限、群組或資料衝突；保留原請求"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access, group, or data conflict; original request retained"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限、グループ、またはデータの競合。元のリクエストを保持"
