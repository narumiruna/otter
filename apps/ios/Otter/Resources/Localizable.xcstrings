    "將新增 %lld 筆支出並重新計算餘額。伺服器會驗證全部資料；任一列有錯誤就不會寫入。": {
      "comment": "native.tripDataToolsView.importNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將新增 %#@rows@ 筆支出並重新計算餘額。伺服器會驗證全部資料；任一列有錯誤就不會寫入。"
          },
          "substitutions": {
            "rows": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will add %#@rows@ and recalculate balances. The server validates all data. If any row has an error, nothing will be written."
          },
          "substitutions": {
            "rows": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld expense"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld expenses"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@rows@を追加し、残高を再計算します。サーバーがすべてのデータを検証します。1行でもエラーがあれば、何も書き込みません。"
          },
          "substitutions": {
            "rows": {
              "argNum": 1,
              "formatSpecifier": "lld",
