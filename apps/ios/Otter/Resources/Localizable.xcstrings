          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupa jest zarchiwizowana. Można odczytać historię, ale nie można przywracać danych."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
