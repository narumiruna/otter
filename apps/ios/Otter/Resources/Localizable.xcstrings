    "無法存取裝置 Keychain（%d）。請解鎖裝置後再試。": {
      "comment": "native.sessionStore.keychainError. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取裝置 Keychain（%1$d）。請解鎖裝置後再試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot access the device Keychain (%1$d). Unlock the device and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのKeychainにアクセスできません（%1$d）。デバイスのロックを解除してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 Keychain에 접근할 수 없습니다(%1$d). 기기 잠금을 해제한 후 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस के Keychain तक पहुँच नहीं हो सकी (%1$d)। डिवाइस अनलॉक करके फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al Keychain del dispositivo (%1$d). Desbloquea el dispositivo y reinténtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’accéder au Keychain de l’appareil (%1$d). Déverrouillez l’appareil, puis réessayez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o Keychain do dispositivo (%1$d). Desbloqueie o dispositivo e tente novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengakses Keychain perangkat (%1$d). Buka kunci perangkat, lalu coba lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf die Keychain des Geräts nicht möglich (%1$d). Entsperre das Gerät und versuche es erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập Keychain của thiết bị (%1$d). Hãy mở khóa thiết bị rồi thử lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazın Keychain alanına erişilemiyor (%1$d). Cihazın kilidini açıp yeniden deneyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-access ang Keychain ng device (%1$d). I-unlock ang device at subukan muli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึง Keychain ของอุปกรณ์ไม่ได้ (%1$d) โปรดปลดล็อกอุปกรณ์แล้วลองอีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile accedere al Keychain del dispositivo (%1$d). Sblocca il dispositivo e riprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uzyskać dostępu do Keychain urządzenia (%1$d). Odblokuj urządzenie i spróbuj ponownie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengakses Keychain peranti (%1$d). Buka kunci peranti dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot de Keychain van het apparaat (%1$d). Ontgrendel het apparaat en probeer opnieuw."
          }
        }
      }
    },
