    "使用此 token 的裝置將無法繼續存取帳號。此操作不能復原。": {
      "comment": "native.tokenSettingsView.revokeNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此 token 的裝置將無法繼續存取帳號。此操作不能復原。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices using this token will no longer be able to access the account. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトークンを使用するデバイスはアカウントにアクセスできなくなります。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 토큰을 사용하는 기기는 더 이상 계정에 접근할 수 없습니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस टोकन का उपयोग करने वाले डिवाइस खाते तक पहुँच जारी नहीं रख सकेंगे। यह कार्रवाई वापस नहीं ली जा सकती।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos que usan este token ya no podrán acceder a la cuenta. Esta operación no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils utilisant ce jeton ne pourront plus accéder au compte. Cette opération est irréversible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dispositivos que usam este token não poderão mais acessar a conta. Esta operação não pode ser desfeita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat yang menggunakan token ini tidak dapat lagi mengakses akun. Operasi ini tidak dapat dibatalkan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte, die diesen Token verwenden, können nicht mehr auf das Konto zugreifen. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị dùng token này sẽ không thể tiếp tục truy cập tài khoản. Không thể hoàn tác thao tác này."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu token değerini kullanan cihazlar artık hesaba erişemez. Bu işlem geri alınamaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na maa-access ng mga device na gumagamit sa token na ito ang account. Hindi maibabalik ang pagkilos na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์ที่ใช้โทเคนนี้จะเข้าถึงบัญชีต่อไม่ได้ การดำเนินการนี้ย้อนกลับไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi che usano questo token non potranno più accedere all'account. L'operazione non può essere annullata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenia używające tego tokenu utracą dostęp do konta. Tej operacji nie można cofnąć."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti yang menggunakan token ini tidak lagi boleh mengakses akaun. Operasi ini tidak boleh dibuat asal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaten die dit token gebruiken, hebben geen toegang meer tot het account. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "無法安全產生 token。請稍後再試。": {
      "comment": "native.tokenSettingsView.generationError. Application-owned text.",
      "extractionState": "manual",
