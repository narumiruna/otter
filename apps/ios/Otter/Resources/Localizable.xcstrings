    "未保存匯率快照，換算可能受群組匯率影響。": {
      "comment": "native.groupSettingsView.missingSnapshot. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存匯率快照，換算可能受群組匯率影響。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No exchange rate snapshot was saved. Conversion may be affected by group rates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "為替レートのスナップショットが保存されていないため、換算はグループの為替レートの影響を受ける場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 환율 스냅샷이 없어 환산이 그룹 환율의 영향을 받을 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विनिमय दर स्नैपशॉट नहीं सहेजा गया; मुद्रा बदलने की गणना समूह की दर से प्रभावित हो सकती है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha guardado una instantánea del tipo de cambio; los tipos de cambio del grupo pueden afectar a la conversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun instantané du taux de change n’est enregistré ; les taux du groupe peuvent influer sur la conversion."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum registro de taxa de câmbio foi salvo; as taxas do grupo podem afetar a conversão."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman kurs tidak disimpan; konversi dapat dipengaruhi kurs grup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Wechselkurs-Momentaufnahme gespeichert. Gruppenkurse können die Umrechnung beeinflussen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa lưu bản chụp tỷ giá, quy đổi có thể chịu ảnh hưởng của tỷ giá nhóm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur anlık görüntüsü kaydedilmemiş; dönüşüm grup kurundan etkilenebilir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang naka-save na snapshot ng palitan; maaaring maapektuhan ng palitan ng grupo ang conversion."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้บันทึกภาพรวมอัตราแลกเปลี่ยน การแปลงอาจได้รับผลจากอัตราแลกเปลี่ยนกลุ่ม"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna istantanea del cambio salvata. La conversione potrebbe dipendere dai cambi del gruppo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano kursu. Na przeliczenie mogą wpływać kursy grupy."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petikan kadar tukaran tidak disimpan; penukaran mungkin dipengaruhi kadar tukaran kumpulan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen wisselkoersmomentopname opgeslagen. Groepskoersen kunnen de omrekening beïnvloeden."
          }
        }
      }
    },
