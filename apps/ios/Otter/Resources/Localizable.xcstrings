    "名稱最多 80 個字。Token 在建立後 90 天到期。": {
      "comment": "native.tokenSettingsView.nameExpiryRules. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱最多 80 個字。Token 在建立後 90 天到期。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names can contain up to 80 characters. Tokens expire 90 days after creation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は80文字以内にしてください。トークンは作成から90日後に期限切れになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 최대 80자입니다. 토큰은 생성 후 90일이 지나면 만료됩니다."
          }
        },
        "hi": {
