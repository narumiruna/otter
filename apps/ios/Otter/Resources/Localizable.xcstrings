    "任何持有連結者可編輯": {
      "comment": "native.accessSettingsView.anyoneEdit. Application-owned text. Exact Web contract: anyoneEditLink.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持有連結即可編輯"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with the link can edit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを持つ人が編集可能"
          }
        },
        "ko": {
          "stringUnit": {
