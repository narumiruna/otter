    "已嘗試送出，結果可能不明；重試不會改動操作 ID": {
      "comment": "native.expenseQueueView.attempted. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已嘗試送出，結果可能不明；重試不會改動操作 ID"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submission attempted; result may be unknown. Retrying will not change the operation ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信試行済み、結果が不明な可能性があります。再試行で操作IDは変更しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송을 시도했으나 결과가 불확실할 수 있음. 재시도해도 작업 ID는 변경되지 않음"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने की कोशिश की गई, परिणाम अज्ञात हो सकता है; फिर कोशिश करने पर कार्रवाई ID नहीं बदलेगा"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha intentado enviar y el resultado puede ser desconocido; el reintento no cambiará el ID de operación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoi tenté, résultat peut-être inconnu ; une nouvelle tentative ne changera pas l’identifiant d’opération"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envio tentado, resultado possivelmente desconhecido; tentar novamente não altera o ID da operação"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiriman telah dicoba, hasil mungkin tidak diketahui; percobaan ulang tidak mengubah ID operasi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden versucht, Ergebnis möglicherweise unbekannt. Erneutes Versuchen ändert die Vorgangs-ID nicht."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thử gửi, kết quả có thể chưa rõ; thử lại không đổi ID thao tác"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderim denendi, sonuç belirsiz olabilir; yeniden denemede işlem ID değeri değişmez"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinubukang ipadala, maaaring hindi tiyak ang resulta; hindi babaguhin ng muling pagsubok ang ID ng pagkilos"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองส่งแล้ว ผลอาจไม่ชัดเจน การลองใหม่จะไม่เปลี่ยน ID การดำเนินการ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invio tentato, esito forse sconosciuto. Riprovare non cambia l'ID operazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podjęto próbę wysłania, wynik może być nieznany. Ponowienie nie zmieni ID operacji"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghantaran telah dicuba, hasil mungkin tidak diketahui; percubaan semula tidak mengubah ID operasi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzenden geprobeerd, resultaat mogelijk onbekend. Opnieuw proberen wijzigt de bewerkings-ID niet."
          }
        }
      }
    },
    "伺服器已確認未記帳，請修正草稿": {
      "comment": "native.expenseQueueView.invalid. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器已確認未記帳，請修正草稿"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server confirmed nothing was recorded. Correct the draft"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記帳されていないことをサーバーが確認済みです。下書きを修正してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
