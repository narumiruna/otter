    "金額必須大於零、不可超過建議金額，且須符合幣別的小數位數。": {
      "comment": "native.paymentEditorView.amountValidation. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金額必須大於零、不可超過建議金額，且須符合幣別的小數位數。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The amount must be greater than zero, not exceed the suggested amount, and use the currency's allowed decimal places."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額はゼロより大きく、推奨額以下で、通貨の小数点以下の桁数に従う必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액은 0보다 크고 권장 금액 이하여야 하며 해당 통화의 소수 자릿수를 따라야 합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राशि शून्य से अधिक होनी चाहिए, सुझाई गई राशि से अधिक नहीं होनी चाहिए और मुद्रा के दशमलव अंकों के अनुसार होनी चाहिए।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe debe ser mayor que cero, no superar el importe sugerido y respetar el número de decimales de la moneda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant doit être supérieur à zéro, ne pas dépasser le montant suggéré et respecter le nombre de décimales de la devise."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor deve ser maior que zero, não ultrapassar o valor sugerido e respeitar o número de casas decimais da moeda."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah harus lebih dari nol, tidak melebihi jumlah yang disarankan, dan sesuai dengan jumlah tempat desimal mata uang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrag muss größer als null sein, darf den vorgeschlagenen Betrag nicht überschreiten und muss die Dezimalstellen der Währung einhalten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tiền phải lớn hơn không, không vượt số tiền đề xuất và đúng số chữ số thập phân của tiền tệ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutar sıfırdan büyük olmalı, önerilen tutarı aşmamalı ve para biriminin ondalık basamak sayısına uymalıdır."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat higit sa zero, hindi lalampas sa iminungkahing halaga, at tugma sa bilang ng decimal ng salapi ang halaga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเงินต้องมากกว่าศูนย์ ไม่เกินยอดที่แนะนำ และมีจำนวนตำแหน่งทศนิยมตรงตามสกุลเงิน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importo deve essere maggiore di zero, non superare l'importo suggerito e rispettare le cifre decimali della valuta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota musi być większa od zera, nie może przekraczać sugerowanej kwoty i musi mieć liczbę miejsc dziesiętnych zgodną z walutą."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaun mesti melebihi sifar, tidak melebihi amaun yang dicadangkan dan mengikut bilangan tempat perpuluhan mata wang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bedrag moet groter zijn dan nul, mag het voorgestelde bedrag niet overschrijden en moet het aantal decimalen van de valuta volgen."
          }
        }
      }
    },
