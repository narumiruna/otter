        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi perbelanjaan lain masih diproses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere uitgavenbewerking wordt nog verwerkt."
          }
        }
      }
    },
    "支出已儲存，但回應缺少 createdExpenseId 或目前版本。請檢查群組；不會再新增一次。": {
      "comment": "native.expenseEditorState.savedMissingIdentity. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出已儲存，但回應缺少 createdExpenseId 或目前版本。請檢查群組；不會再新增一次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expense was saved, but the response is missing createdExpenseId or the current version. Check the group. The expense will not be added again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出は保存されましたが、応答にcreatedExpenseIdまたは現在のバージョンがありません。グループを確認してください。再度追加することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출은 저장되었지만 응답에 createdExpenseId 또는 현재 버전이 없습니다. 그룹을 확인하세요. 다시 추가하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च सहेजा गया, लेकिन उत्तर में createdExpenseId या वर्तमान संस्करण नहीं है। समूह जाँचें; दोबारा नहीं जोड़ा जाएगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto se ha guardado, pero la respuesta no incluye createdExpenseId o la versión actual. Comprueba el grupo; no se añadirá de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dépense est enregistrée, mais la réponse ne contient pas createdExpenseId ou la version actuelle. Vérifiez le groupe ; la dépense ne sera pas ajoutée une seconde fois."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A despesa foi salva, mas a resposta não contém createdExpenseId ou a versão atual. Confira o grupo; a despesa não será adicionada novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran telah disimpan, tetapi respons tidak memiliki createdExpenseId atau versi saat ini. Periksa grup; pengeluaran tidak akan ditambahkan lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe gespeichert, aber der Antwort fehlt createdExpenseId oder die aktuelle Version. Prüfe die Gruppe. Die Ausgabe wird nicht erneut hinzugefügt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu khoản chi, nhưng phản hồi thiếu createdExpenseId hoặc phiên bản hiện tại. Hãy kiểm tra nhóm; sẽ không thêm lần nữa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gider kaydedildi ancak yanıtta createdExpenseId veya mevcut sürüm eksik. Grubu kontrol edin; yeniden eklenmeyecek."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-save ang gastos, pero walang createdExpenseId o kasalukuyang bersyon sa tugon. Suriin ang grupo; hindi ito idaragdag muli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรายจ่ายแล้ว แต่คำตอบไม่มี createdExpenseId หรือเวอร์ชันปัจจุบัน โปรดตรวจสอบกลุ่ม จะไม่เพิ่มซ้ำอีก"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesa salvata, ma nella risposta manca createdExpenseId o la versione attuale. Controlla il gruppo. La spesa non verrà aggiunta di nuovo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatek zapisano, ale w odpowiedzi brakuje createdExpenseId lub bieżącej wersji. Sprawdź grupę. Wydatek nie zostanie dodany ponownie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbelanjaan telah disimpan, tetapi respons tiada createdExpenseId atau versi semasa. Semak kumpulan; perbelanjaan tidak akan ditambah lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgave opgeslagen, maar createdExpenseId of de huidige versie ontbreekt in het antwoord. Controleer de groep. De uitgave wordt niet opnieuw toegevoegd."
          }
        }
      }
    },
    "版本已變更或缺少有效版本。草稿與照片仍保留。請比較最新內容並明確確認，再儲存。": {
      "comment": "native.expenseEditorState.conflict. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本已變更或缺少有效版本。草稿與照片仍保留。請比較最新內容並明確確認，再儲存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The version changed or a valid version is missing. Your draft and photos are retained. Compare the latest content and explicitly confirm it before saving again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンが変更されたか、有効なバージョンがありません。下書きと写真は保持されています。最新の内容を比較して明示的に確認してから、再度保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전이 변경되었거나 유효한 버전이 없습니다. 초안과 사진은 유지됩니다. 최신 내용과 비교하고 명시적으로 확인한 후 다시 저장하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण बदल गया है या मान्य संस्करण नहीं है। ड्राफ़्ट और तस्वीर रखे गए हैं। नवीनतम सामग्री की तुलना करके स्पष्ट पुष्टि करें, फिर सहेजें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión ha cambiado o falta una versión válida. Se conservan el borrador y las fotos. Compara el contenido más reciente y confírmalo expresamente antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version a changé ou aucune version valide n’est disponible. Le brouillon et les photos sont conservés. Comparez le contenu le plus récent et confirmez-le explicitement avant d’enregistrer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão mudou ou não há uma versão válida. O rascunho e as fotos foram mantidos. Compare o conteúdo mais recente e confirme explicitamente antes de salvar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi telah berubah atau versi valid tidak tersedia. Draf dan foto tetap disimpan. Bandingkan konten terbaru dan konfirmasikan secara eksplisit sebelum menyimpan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Version hat sich geändert oder eine gültige Version fehlt. Entwurf und Fotos bleiben erhalten. Vergleiche den aktuellen Inhalt und bestätige ausdrücklich, bevor du speicherst."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản đã thay đổi hoặc thiếu phiên bản hợp lệ. Bản nháp và ảnh vẫn được giữ. Hãy so sánh nội dung mới nhất và chủ động xác nhận trước khi lưu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm değişti veya geçerli sürüm eksik. Taslak ve fotoğraflar korunuyor. En güncel içerikle karşılaştırıp açıkça onayladıktan sonra kaydedin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang bersyon o walang wastong bersyon. Nananatili ang draft at larawan. Ihambing ang pinakabagong nilalaman at tahasang kumpirmahin bago mag-save."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันเปลี่ยนแล้วหรือไม่มีเวอร์ชันที่ใช้ได้ ฉบับร่างและรูปภาพยังอยู่ โปรดเปรียบเทียบกับข้อมูลล่าสุดและยืนยันอย่างชัดเจนก่อนบันทึก"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione è cambiata o manca una versione valida. Bozza e foto sono conservate. Confronta i contenuti aggiornati e conferma esplicitamente prima di salvare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja uległa zmianie lub brakuje poprawnej wersji. Szkic i zdjęcia zostały zachowane. Porównaj najnowszą treść i jawnie ją potwierdź przed zapisaniem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi telah berubah atau versi sah tiada. Draf dan foto dikekalkan. Bandingkan kandungan terkini dan sahkan secara nyata sebelum menyimpan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versie is gewijzigd of een geldige versie ontbreekt. Het concept en de foto's blijven behouden. Vergelijk de nieuwste inhoud en bevestig uitdrukkelijk voordat je opslaat."
          }
        }
      }
    },
    "無法載入最新內容。請重試載入；草稿仍保留。\n": {
      "comment": "native.expenseEditorState.reloadFailed. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入最新內容。請重試載入；草稿仍保留。\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot load the latest content. Retry loading. Your draft is retained.\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の内容を読み込めません。読み込みを再試行してください。下書きは保持されています。\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 내용을 불러올 수 없습니다. 불러오기를 다시 시도하세요. 초안은 유지됩니다.\n"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीनतम सामग्री लोड नहीं हो सकी। फिर लोड करें; ड्राफ़्ट रखा गया है।\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el contenido más reciente. Reintenta la carga; el borrador se conserva.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le contenu le plus récent. Réessayez le chargement ; le brouillon est conservé.\n"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o conteúdo mais recente. Tente carregar novamente; o rascunho foi mantido.\n"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuat konten terbaru. Coba muat lagi; draf tetap disimpan.\n"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Inhalt konnte nicht geladen werden. Versuche das Laden erneut. Der Entwurf bleibt erhalten.\n"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải nội dung mới nhất. Hãy thử tải lại; bản nháp vẫn được giữ.\n"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En güncel içerik yüklenemedi. Yüklemeyi yeniden deneyin; taslak korunuyor.\n"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mai-load ang pinakabagong nilalaman. Subukang i-load muli; nananatili ang draft.\n"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดข้อมูลล่าสุดไม่ได้ โปรดลองโหลดอีกครั้ง ฉบับร่างยังอยู่\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i contenuti aggiornati. Riprova a caricare. La bozza è conservata.\n"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wczytać najnowszej treści. Ponów wczytywanie. Szkic jest zachowany.\n"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuatkan kandungan terkini. Cuba muatkan lagi; draf dikekalkan.\n"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de nieuwste inhoud niet laden. Probeer opnieuw te laden. Het concept blijft behouden.\n"
          }
        }
      }
    },
    "新增結果不明。伺服器可能已建立支出。請先檢查最新群組，避免重複新增。": {
      "comment": "native.expenseEditorState.unknownCreate. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增結果不明。伺服器可能已建立支出。請先檢查最新群組，避免重複新增。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The creation result is unknown. The server may have created the expense. Check the latest group first to avoid adding a duplicate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加結果は不明です。サーバーで支出が作成された可能性があります。重複追加を避けるため、先に最新のグループを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 결과를 알 수 없습니다. 서버에서 지출을 이미 만들었을 수 있습니다. 중복 추가를 피하려면 먼저 최신 그룹을 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ने का परिणाम अज्ञात है। सर्वर खर्च बना चुका हो सकता है। दोहरा खर्च जोड़ने से बचने के लिए पहले नवीनतम समूह जाँचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desconoce el resultado de la creación. El servidor puede haber creado el gasto. Comprueba primero el grupo actualizado para evitar duplicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la création est inconnu. Le serveur a peut-être créé la dépense. Vérifiez d’abord le groupe à jour pour éviter un doublon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da criação é desconhecido. O servidor pode ter criado a despesa. Confira primeiro o grupo atualizado para evitar duplicatas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil penambahan tidak diketahui. Server mungkin telah membuat pengeluaran. Periksa grup terbaru terlebih dahulu untuk mencegah duplikasi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis der Erstellung ist unbekannt. Der Server hat die Ausgabe möglicherweise bereits erstellt. Prüfe zuerst die aktuelle Gruppe, um doppelte Ausgaben zu vermeiden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không rõ kết quả thêm. Máy chủ có thể đã tạo khoản chi. Hãy kiểm tra nhóm mới nhất trước để tránh thêm trùng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekleme sonucu bilinmiyor. Sunucu gideri oluşturmuş olabilir. Yinelenen kayıt oluşturmamak için önce güncel grubu kontrol edin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tiyak ang resulta ng pagdagdag. Maaaring nagawa na ng server ang gastos. Suriin muna ang pinakabagong grupo upang maiwasan ang doble."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ทราบผลการเพิ่ม เซิร์ฟเวอร์อาจสร้างรายจ่ายแล้ว โปรดตรวจสอบกลุ่มล่าสุดก่อนเพื่อป้องกันการเพิ่มซ้ำ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esito della creazione è sconosciuto. Il server potrebbe aver già creato la spesa. Controlla prima il gruppo aggiornato per evitare duplicati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik dodania jest nieznany. Serwer mógł już utworzyć wydatek. Najpierw sprawdź aktualną grupę, aby uniknąć podwójnego dodania."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil penambahan tidak diketahui. Pelayan mungkin telah mencipta perbelanjaan. Semak kumpulan terkini dahulu untuk mengelakkan pendua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resultaat van het aanmaken is onbekend. De server heeft de uitgave mogelijk al gemaakt. Controleer eerst de nieuwste groep om dubbele uitgaven te voorkomen."
          }
        }
      }
    },
    "支出已儲存；收據尚未完成。重試只會處理收據。\n": {
      "comment": "native.expenseEditorState.receiptPending. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出已儲存；收據尚未完成。重試只會處理收據。\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expense is saved; the receipt is not complete. Retrying will process only the receipt.\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出は保存されましたが、領収書の処理は未完了です。再試行では領収書のみを処理します。\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출은 저장되었지만 영수증 처리는 아직 완료되지 않았습니다. 다시 시도하면 영수증만 처리합니다.\n"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च सहेजा गया; रसीद का काम अधूरा है। फिर कोशिश करने पर केवल रसीद पर काम होगा।\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto se ha guardado; el recibo aún está pendiente. El reintento solo procesará el recibo.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dépense est enregistrée ; le traitement du reçu n’est pas encore terminé. Une nouvelle tentative traitera uniquement le reçu.\n"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A despesa foi salva; o recibo ainda está pendente. Uma nova tentativa processará apenas o recibo.\n"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran telah disimpan; tanda terima belum selesai. Percobaan ulang hanya memproses tanda terima.\n"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe gespeichert. Der Beleg ist noch nicht fertig verarbeitet. Ein erneuter Versuch verarbeitet nur den Beleg.\n"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu khoản chi; biên lai chưa hoàn tất. Thử lại chỉ xử lý biên lai.\n"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gider kaydedildi; makbuz işlemi henüz tamamlanmadı. Yeniden deneme yalnızca makbuzu işler.\n"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-save ang gastos; hindi pa tapos ang resibo. Resibo lamang ang ipoproseso kapag sinubukan muli.\n"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรายจ่ายแล้ว แต่ใบเสร็จยังไม่เสร็จ การลองใหม่จะจัดการเฉพาะใบเสร็จ\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesa salvata; la ricevuta non è ancora completata. Un nuovo tentativo elaborerà solo la ricevuta.\n"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatek zapisano. Obsługa paragonu nie jest jeszcze zakończona. Ponowienie dotyczy tylko paragonu.\n"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbelanjaan telah disimpan; resit belum selesai. Percubaan semula hanya memproses resit.\n"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgave opgeslagen; de bon is nog niet voltooid. Opnieuw proberen verwerkt alleen de bon.\n"
          }
        }
      }
    },
    "這筆支出已不存在，不能以目前草稿覆寫。請關閉並檢查群組。": {
      "comment": "native.expenseEditorState.expenseMissing. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆支出已不存在，不能以目前草稿覆寫。請關閉並檢查群組。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This expense no longer exists and cannot be overwritten with the current draft. Close the form and check the group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この支出はすでに存在しないため、現在の下書きで上書きできません。閉じてグループを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지출은 더 이상 존재하지 않아 현재 초안으로 덮어쓸 수 없습니다. 닫은 후 그룹을 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह खर्च अब मौजूद नहीं है; वर्तमान ड्राफ़्ट से इसके ऊपर नहीं लिख सकते। बंद करके समूह जाँचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este gasto ya no existe y no se puede sobrescribir con el borrador actual. Cierra y comprueba el grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette dépense n’existe plus et ne peut pas être écrasée par le brouillon actuel. Fermez et vérifiez le groupe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta despesa não existe mais e não pode ser sobrescrita pelo rascunho atual. Feche e confira o grupo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran ini tidak lagi ada dan tidak dapat ditimpa dengan draf saat ini. Tutup dan periksa grup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ausgabe ist nicht mehr vorhanden und kann nicht mit dem aktuellen Entwurf überschrieben werden. Schließe das Formular und prüfe die Gruppe."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoản chi này không còn tồn tại, không thể ghi đè bằng bản nháp hiện tại. Hãy đóng và kiểm tra nhóm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gider artık mevcut değil; mevcut taslakla üzerine yazılamaz. Kapatıp grubu kontrol edin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala na ang gastos na ito at hindi ito maaaring patungan ng kasalukuyang draft. Isara at suriin ang grupo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายจ่ายนี้ไม่มีอยู่แล้ว จึงเขียนทับด้วยฉบับร่างปัจจุบันไม่ได้ โปรดปิดและตรวจสอบกลุ่ม"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa spesa non esiste più e non può essere sovrascritta con la bozza attuale. Chiudi e controlla il gruppo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wydatek już nie istnieje. Nie można go nadpisać bieżącym szkicem. Zamknij formularz i sprawdź grupę."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbelanjaan ini tidak lagi wujud dan tidak boleh ditulis ganti dengan draf semasa. Tutup dan semak kumpulan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze uitgave bestaat niet meer en kan niet met het huidige concept worden overschreven. Sluit het formulier en controleer de groep."
          }
        }
      }
    },
    "已確認最新版本。請再按儲存以提交保留的草稿。": {
      "comment": "native.expenseEditorState.versionConfirmed. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已確認最新版本。請再按儲存以提交保留的草稿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest version confirmed. Press Save again to submit the retained draft."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新バージョンを確認しました。保存をもう一度押して、保持された下書きを送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 버전을 확인했습니다. 저장을 다시 눌러 유지된 초안을 제출하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीनतम संस्करण की पुष्टि हुई। रखे गए ड्राफ़्ट को भेजने के लिए फिर सहेजें दबाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión más reciente confirmada. Pulsa Guardar de nuevo para enviar el borrador conservado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version la plus récente est confirmée. Appuyez à nouveau sur Enregistrer pour envoyer le brouillon conservé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão mais recente foi confirmada. Toque em Salvar novamente para enviar o rascunho mantido."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi terbaru telah dikonfirmasi. Tekan Simpan lagi untuk mengirim draf yang dipertahankan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Version bestätigt. Tippe erneut auf Speichern, um den beibehaltenen Entwurf zu senden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xác nhận phiên bản mới nhất. Hãy nhấn Lưu lần nữa để gửi bản nháp được giữ lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En güncel sürüm onaylandı. Korunan taslağı göndermek için Kaydet düğmesine yeniden basın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakumpirma ang pinakabagong bersyon. Pindutin muli ang I-save upang isumite ang pinanatiling draft."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันเวอร์ชันล่าสุดแล้ว โปรดกดบันทึกอีกครั้งเพื่อส่งฉบับร่างที่เก็บไว้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Versione aggiornata confermata. Premi di nuovo Salva per inviare la bozza conservata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdzono najnowszą wersję. Naciśnij ponownie Zapisz, aby wysłać zachowany szkic."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi terkini telah disahkan. Tekan Simpan lagi untuk menghantar draf yang dikekalkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwste versie bevestigd. Druk opnieuw op Opslaan om het bewaarde concept te versturen."
          }
        }
      }
    },
    "無法載入目前收據。\n": {
      "comment": "native.expenseEditorState.receiptLoadFailed. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入目前收據。\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot load the current receipt.\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の領収書を読み込めません。\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 영수증을 불러올 수 없습니다.\n"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान रसीद लोड नहीं हो सकी।\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el recibo actual.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le reçu actuel.\n"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o recibo atual.\n"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuat tanda terima saat ini.\n"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Beleg konnte nicht geladen werden.\n"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải biên lai hiện tại.\n"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut makbuz yüklenemedi.\n"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mai-load ang kasalukuyang resibo.\n"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดใบเสร็จปัจจุบันไม่ได้\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare la ricevuta attuale.\n"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wczytać bieżącego paragonu.\n"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuatkan resit semasa.\n"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de huidige bon niet laden.\n"
          }
        }
      }
    },
    "登入狀態已變更。請關閉此表單，重新開啟。": {
      "comment": "native.expenseEditorView.sessionChanged. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入狀態已變更。請關閉此表單，重新開啟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in state has changed. Close this form and reopen it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン状態が変わりました。このフォームを閉じて開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 상태가 변경되었습니다. 이 양식을 닫았다가 다시 여세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन की स्थिति बदल गई है। यह फ़ॉर्म बंद करके फिर खोलें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado de inicio de sesión ha cambiado. Cierra este formulario y vuelve a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état de connexion a changé. Fermez ce formulaire, puis rouvrez-le."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado de login mudou. Feche este formulário e abra novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status masuk telah berubah. Tutup formulir ini, lalu buka kembali."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anmeldestatus hat sich geändert. Schließe dieses Formular und öffne es erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái đăng nhập đã thay đổi. Hãy đóng biểu mẫu này rồi mở lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş durumu değişti. Bu formu kapatıp yeniden açın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang katayuan ng pag-sign in. Isara ang form na ito at buksan muli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะการลงชื่อเข้าใช้เปลี่ยนแล้ว โปรดปิดแบบฟอร์มนี้แล้วเปิดใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato di accesso è cambiato. Chiudi e riapri questo modulo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan logowania uległ zmianie. Zamknij ten formularz i otwórz go ponownie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Status log masuk telah berubah. Tutup borang ini dan buka semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmeldstatus is gewijzigd. Sluit dit formulier en open het opnieuw."
          }
        }
      }
    },
    "目前群組或登入權限不允許修改支出。封存群組不能修改。": {
      "comment": "native.expenseEditorView.permissionDenied. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前群組或登入權限不允許修改支出。封存群組不能修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current group or sign-in permissions do not allow expense changes. Archived groups cannot be changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のグループまたはログイン権限では支出を変更できません。アーカイブ済みのグループは変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 그룹 또는 로그인 권한으로 지출을 수정할 수 없습니다. 보관된 그룹은 수정할 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान समूह या साइन इन के अधिकार खर्च बदलने की अनुमति नहीं देते। संग्रहित समूह नहीं बदल सकते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo actual o los permisos de inicio de sesión no permiten modificar gastos. Los grupos archivados no se pueden modificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe actuel ou les droits de connexion ne permettent pas de modifier les dépenses. Un groupe archivé ne peut pas être modifié."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O grupo atual ou as permissões de login não permitem modificar despesas. Grupos arquivados não podem ser modificados."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup atau izin masuk saat ini tidak mengizinkan perubahan pengeluaran. Grup yang diarsipkan tidak dapat diubah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Gruppe oder die Anmeldeberechtigungen erlauben keine Ausgabenänderungen. Archivierte Gruppen können nicht geändert werden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm hoặc quyền đăng nhập hiện tại không cho phép sửa khoản chi. Không thể sửa nhóm đã lưu trữ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut grup veya giriş yetkileri giderlerin değiştirilmesine izin vermiyor. Arşivlenmiş gruplar değiştirilemez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pinapayagan ng kasalukuyang grupo o karapatan sa pag-sign in ang pagbabago ng gastos. Hindi mababago ang naka-archive na grupo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลุ่มหรือสิทธิ์การลงชื่อเข้าใช้ปัจจุบันไม่อนุญาตให้แก้ไขรายจ่าย กลุ่มที่เก็บเข้าคลังแก้ไขไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo attuale o i permessi di accesso non consentono di modificare le spese. I gruppi archiviati non possono essere modificati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżąca grupa lub uprawnienia logowania nie pozwalają zmieniać wydatków. Nie można zmieniać zarchiwizowanych grup."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpulan atau kebenaran log masuk semasa tidak membenarkan perubahan perbelanjaan. Kumpulan yang diarkibkan tidak boleh diubah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige groep of aanmeldrechten staan geen uitgavenwijzigingen toe. Gearchiveerde groepen kunnen niet worden gewijzigd."
          }
        }
      }
    },
    "支出已儲存。表單已鎖定，接下來只處理收據，不會再新增支出。": {
      "comment": "native.expenseEditorView.savedLocked. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出已儲存。表單已鎖定，接下來只處理收據，不會再新增支出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expense is saved. The form is locked. Only the receipt will be processed next; no additional expense will be created."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出は保存されました。フォームはロックされています。以降は領収書のみを処理し、支出を再度追加することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출을 저장했습니다. 양식이 잠겼습니다. 이후에는 영수증만 처리하며 지출을 다시 추가하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च सहेजा गया। फ़ॉर्म लॉक है; अब केवल रसीद पर काम होगा, खर्च दोबारा नहीं जोड़ा जाएगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasto guardado. El formulario está bloqueado; a continuación solo se procesará el recibo y no se volverá a añadir el gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dépense est enregistrée. Le formulaire est verrouillé ; seul le reçu sera traité ensuite, sans ajouter à nouveau la dépense."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A despesa foi salva. O formulário foi bloqueado; somente o recibo será processado a seguir, sem adicionar a despesa novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran telah disimpan. Formulir dikunci; hanya tanda terima yang akan diproses, tanpa menambahkan pengeluaran lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe gespeichert. Das Formular ist gesperrt. Ab jetzt wird nur der Beleg verarbeitet, keine weitere Ausgabe erstellt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu khoản chi. Biểu mẫu đã khóa; tiếp theo chỉ xử lý biên lai, không thêm khoản chi nữa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gider kaydedildi. Form kilitlendi; bundan sonra yalnızca makbuz işlenir, yeni gider eklenmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-save ang gastos. Naka-lock na ang form; resibo lamang ang susunod na ipoproseso at hindi na magdadagdag ng gastos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรายจ่ายแล้ว แบบฟอร์มถูกล็อก ต่อจากนี้จะจัดการเฉพาะใบเสร็จและจะไม่เพิ่มรายจ่ายอีก"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesa salvata. Il modulo è bloccato. Ora verrà elaborata solo la ricevuta, senza creare un'altra spesa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatek zapisano. Formularz jest zablokowany. Dalsze operacje dotyczą tylko paragonu i nie dodadzą nowego wydatku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbelanjaan telah disimpan. Borang dikunci; hanya resit akan diproses selepas ini, tanpa menambah perbelanjaan lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgave opgeslagen. Het formulier is vergrendeld. Nu wordt alleen de bon verwerkt; er wordt geen nieuwe uitgave gemaakt."
          }
        }
      }
    },
    "保留支出，稍後處理收據": {
      "comment": "native.expenseEditorView.keepExpense. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留支出，稍後處理收據"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep expense and handle receipt later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出を保持し、領収書は後で処理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출 유지 후 영수증은 나중에 처리"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च रखें, रसीद बाद में पूरी करें"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar gasto y gestionar el recibo más tarde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver la dépense et traiter le reçu plus tard"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter despesa e tratar recibo depois"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan pengeluaran, urus tanda terima nanti"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe behalten, Beleg später bearbeiten"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ khoản chi, xử lý biên lai sau"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gideri koru, makbuzu sonra işle"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Panatilihin ang gastos, asikasuhin ang resibo mamaya"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บรายจ่ายไว้ จัดการใบเสร็จภายหลัง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la spesa, gestisci la ricevuta più tardi"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj wydatek, zajmij się paragonem później"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekalkan perbelanjaan, urus resit kemudian"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgave behouden, bon later verwerken"
          }
        }
      }
    },
    "支出已建立，但回應缺少新支出識別碼。請關閉表單，從群組開啟已建立的支出後再上傳收據；此表單不會再次新增。": {
      "comment": "native.expenseEditorView.missingCreatedID. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出已建立，但回應缺少新支出識別碼。請關閉表單，從群組開啟已建立的支出後再上傳收據；此表單不會再次新增。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expense was created, but its new ID is missing from the response. Close the form, open the created expense from the group, then upload the receipt. This form will not add it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出は作成されましたが、応答に新しい支出IDがありません。フォームを閉じ、グループから作成済みの支出を開いて領収書をアップロードしてください。このフォームで再度追加することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출은 생성되었지만 응답에 새 지출 ID가 없습니다. 양식을 닫고 그룹에서 생성된 지출을 연 다음 영수증을 업로드하세요. 이 양식에서는 다시 추가하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च बन गया, लेकिन उत्तर में नए खर्च का ID नहीं है। फ़ॉर्म बंद करें, समूह से बनाया गया खर्च खोलें, फिर रसीद अपलोड करें; यह फ़ॉर्म दोबारा खर्च नहीं जोड़ेगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto se ha creado, pero la respuesta no incluye el ID del nuevo gasto. Cierra el formulario y abre el gasto creado desde el grupo para subir el recibo; este formulario no volverá a añadirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dépense est créée, mais la réponse ne contient pas son nouvel identifiant. Fermez le formulaire et ouvrez la dépense créée depuis le groupe pour envoyer le reçu ; ce formulaire ne l’ajoutera pas à nouveau."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A despesa foi criada, mas a resposta não contém o identificador da nova despesa. Feche o formulário e abra a despesa criada pelo grupo para enviar o recibo; este formulário não a adicionará novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran telah dibuat, tetapi respons tidak memiliki ID pengeluaran baru. Tutup formulir, buka pengeluaran yang telah dibuat dari grup, lalu unggah tanda terima; formulir ini tidak akan menambahkan lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe wurde erstellt, aber ihre neue ID fehlt in der Antwort. Schließe das Formular und öffne die erstellte Ausgabe in der Gruppe, um den Beleg hochzuladen. Dieses Formular erstellt sie nicht erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạo khoản chi, nhưng phản hồi thiếu ID khoản chi mới. Hãy đóng biểu mẫu, mở khoản chi đã tạo từ nhóm rồi tải biên lai lên; biểu mẫu này sẽ không thêm lần nữa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gider oluşturuldu ancak yanıtta yeni giderin kimliği eksik. Formu kapatın, gruptan oluşturulan gideri açın ve ardından makbuzu yükleyin; bu form gideri yeniden eklemeyecek."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagawa ang gastos, pero walang ID ng bagong gastos sa tugon. Isara ang form, buksan ang nagawang gastos mula sa grupo, at saka i-upload ang resibo; hindi ito idaragdag muli ng form na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างรายจ่ายแล้ว แต่คำตอบไม่มี ID รายจ่ายใหม่ โปรดปิดแบบฟอร์ม เปิดรายจ่ายที่สร้างจากกลุ่ม แล้วค่อยอัปโหลดใบเสร็จ แบบฟอร์มนี้จะไม่เพิ่มซ้ำ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La spesa è stata creata, ma nella risposta manca il nuovo ID. Chiudi il modulo e apri la spesa creata dal gruppo per caricare la ricevuta. Questo modulo non la creerà di nuovo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatek utworzono, ale w odpowiedzi brakuje jego nowego identyfikatora. Zamknij formularz, otwórz utworzony wydatek z grupy i dopiero wtedy prześlij paragon. Ten formularz nie doda wydatku ponownie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbelanjaan telah dicipta, tetapi respons tiada ID perbelanjaan baharu. Tutup borang, buka perbelanjaan yang telah dicipta daripada kumpulan, kemudian muat naik resit; borang ini tidak akan menambah lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgave is gemaakt, maar de nieuwe uitgave-ID ontbreekt in het antwoord. Sluit het formulier en open de gemaakte uitgave vanuit de groep om de bon te uploaden. Dit formulier maakt de uitgave niet opnieuw."
          }
        }
      }
    },
    "僅將支出加入離線佇列": {
      "comment": "native.expenseEditorView.queueOnly. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅將支出加入離線佇列"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only add expense to offline queue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出をオフラインキューにのみ追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출을 오프라인 대기열에만 추가"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च केवल ऑफ़लाइन कतार में जोड़ें"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
