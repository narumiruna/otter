    "備註超過 160 字，請縮短後再儲存。": {
      "comment": "native.paymentEditorView.noteTooLong. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備註超過 160 字，請縮短後再儲存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note exceeds 160 characters. Shorten it before saving."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "備考が160文字を超えています。短くしてから保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
