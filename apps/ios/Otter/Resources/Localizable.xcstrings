          "stringUnit": {
            "state": "translated",
            "value": "อัตราแลกเปลี่ยนที่กำหนดเอง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tassi di cambio personalizzati"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własne kursy walut"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar pertukaran tersuai"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste wisselkoersen"
          }
        }
      }
    },
    "輸入 1 單位外幣可兌換多少 %@。留白會使用自動匯率；所有數值都必須大於零。": {
      "comment": "native.groupSettingsView.rateInputNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 1 單位外幣可兌換多少 %1$@。留白會使用自動匯率；所有數值都必須大於零。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter how much %1$@ 1 unit of foreign currency buys. Leave blank to use the automatic rate. All values must be greater than zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外貨1単位が何%1$@に換算されるか入力してください。空欄の場合は自動為替レートを使用します。すべての値はゼロより大きい必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외화 1단위를 환전할 때 받을 %1$@ 금액을 입력하세요. 비워 두면 자동 환율을 사용합니다. 모든 값은 0보다 커야 합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डालें कि विदेशी मुद्रा की 1 इकाई के बदले कितना %1$@ मिलता है। खाली छोड़ने पर स्वचालित दर लगेगी; सभी मान शून्य से अधिक होने चाहिए।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce cuántas unidades de %1$@ se obtienen por 1 unidad de moneda extranjera. Si lo dejas en blanco, se usará el tipo de cambio automático; todos los valores deben ser mayores que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le montant en %1$@ obtenu pour 1 unité de devise étrangère. Un champ vide utilise le taux automatique ; toutes les valeurs doivent être supérieures à zéro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira quanto de %1$@ é obtido por 1 unidade de moeda estrangeira. Deixe em branco para usar a taxa automática; todos os valores devem ser maiores que zero."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan berapa %1$@ yang diperoleh untuk 1 unit mata uang asing. Kosongkan untuk menggunakan kurs otomatis; semua nilai harus lebih dari nol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein, wie viel %1$@ du für 1 Einheit Fremdwährung erhältst. Ein leeres Feld verwendet den automatischen Kurs. Alle Werte müssen größer als null sein."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập số %1$@ đổi được từ 1 đơn vị ngoại tệ. Để trống để dùng tỷ giá tự động; mọi giá trị phải lớn hơn không."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 birim yabancı para karşılığında kaç %1$@ alındığını girin. Boş bırakırsanız otomatik kur kullanılır; tüm değerler sıfırdan büyük olmalıdır."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay kung magkano sa %1$@ ang katumbas ng 1 yunit ng banyagang salapi. Kapag blangko, awtomatikong palitan ang gagamitin; dapat higit sa zero ang lahat ng halaga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนจำนวน %1$@ ที่แลกได้จากเงินต่างประเทศ 1 หน่วย หากเว้นว่างจะใช้อัตราอัตโนมัติ ทุกค่าต้องมากกว่าศูนย์"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci quanti %1$@ corrispondono a 1 unità di valuta estera. Lascia vuoto per usare il cambio automatico. Tutti i valori devono essere maggiori di zero."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz, ile %1$@ można otrzymać za 1 jednostkę waluty obcej. Puste pole oznacza kurs automatyczny. Wszystkie wartości muszą być większe od zera."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan berapa %1$@ boleh ditukar bagi 1 unit mata wang asing. Biarkan kosong untuk menggunakan kadar automatik; semua nilai mesti melebihi sifar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer in hoeveel %1$@ je krijgt voor 1 eenheid buitenlandse valuta. Laat leeg voor de automatische koers. Alle waarden moeten groter zijn dan nul."
          }
        }
      }
    },
