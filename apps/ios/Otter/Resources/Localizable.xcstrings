          "stringUnit": {
            "state": "translated",
            "value": "下書きの変更を破棄しますか？元のキュー項目は削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안의 변경 사항을 버릴까요? 원래 대기열 항목은 삭제되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राफ़्ट के बदलाव छोड़ें? कतार की मूल प्रविष्टि नहीं हटेगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar los cambios del borrador? El elemento original de la cola no se eliminará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner les modifications du brouillon ? L’élément d’origine de la file ne sera pas supprimé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar alterações do rascunho? O item original da fila não será excluído."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang perubahan dalam draf? Item antrean asli tidak akan dihapus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen am Entwurf verwerfen? Der ursprüngliche Warteschlangeneintrag wird nicht gelöscht."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ thay đổi trong bản nháp? Mục hàng đợi ban đầu sẽ không bị xóa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslaktaki değişiklikler atılsın mı? Asıl kuyruk öğesi silinmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itapon ang mga pagbabago sa draft? Hindi buburahin ang orihinal na item sa pila."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทิ้งการเปลี่ยนแปลงในฉบับร่างหรือไม่? รายการเดิมในคิวจะไม่ถูกลบ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scartare le modifiche alla bozza? L'elemento originale in coda non verrà eliminato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucić zmiany w szkicu? Pierwotna pozycja kolejki nie zostanie usunięta."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang perubahan dalam draf? Item baris gilir asal tidak akan dipadamkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen in het concept verwerpen? Het oorspronkelijke wachtrij-item wordt niet verwijderd."
          }
        }
      }
    },
