    "已複製，剪貼簿內容會在 5 分鐘後到期。": {
      "comment": "native.accessSettingsView.copiedExpiry. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製，剪貼簿內容會在 5 分鐘後到期。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied. The clipboard content expires in 5 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしました。クリップボードの内容は5分後に期限切れになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사했습니다. 클립보드 내용은 5분 후 만료됩니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी किया गया। क्लिपबोर्ड की सामग्री 5 मिनट बाद समाप्त हो जाएगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado. El contenido del portapapeles caducará en 5 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié. Le contenu du presse-papiers expirera dans 5 minutes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado. O conteúdo da área de transferência expirará em 5 minutos."
          }
        },
