    "尚無支出。新增支出後即可檢視餘額與結算建議。": {
      "comment": "native.overviewView.noExpenses. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無支出。新增支出後即可檢視餘額與結算建議。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No expenses yet. Add expenses to see balances and settlement suggestions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出はまだありません。支出を追加すると残高と精算案を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 지출이 없습니다. 지출을 추가하면 잔액과 정산 제안을 볼 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई खर्च नहीं है। खर्च जोड़ने के बाद शेष और निपटान के सुझाव देख सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay gastos. Añade un gasto para ver los saldos y las sugerencias de liquidación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune dépense pour le moment. Ajoutez une dépense pour consulter les soldes et les suggestions de règlement."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há despesas. Adicione uma despesa para ver os saldos e as sugestões de acerto."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pengeluaran. Tambahkan pengeluaran untuk melihat saldo dan saran penyelesaian."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Ausgaben. Füge Ausgaben hinzu, um Salden und Ausgleichsvorschläge zu sehen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có khoản chi. Thêm khoản chi để xem số dư và đề xuất quyết toán."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz gider yok. Gider ekledikten sonra bakiyeleri ve hesaplaşma önerilerini görebilirsiniz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang gastos. Makikita ang mga balanse at mungkahi sa pag-aayos matapos magdagdag ng gastos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีรายจ่าย หลังเพิ่มรายจ่ายจะดูยอดคงเหลือและคำแนะนำการชำระยอดได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna spesa. Aggiungi una spesa per visualizzare saldi e suggerimenti di saldo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze wydatków. Po dodaniu wydatku można wyświetlić salda i sugestie rozliczenia."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada perbelanjaan. Tambah perbelanjaan untuk melihat baki dan cadangan penyelesaian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen uitgaven. Voeg een uitgave toe om saldi en verrekenvoorstellen te bekijken."
          }
        }
      }
    },
