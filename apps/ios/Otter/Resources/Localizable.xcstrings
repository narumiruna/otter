          "stringUnit": {
            "state": "translated",
            "value": "AI 설정을 불러올 수 없습니다. 네트워크를 확인한 후 다시 불러오세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI सेटिंग लोड नहीं हो सकीं। नेटवर्क जाँचकर दोबारा लोड करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la configuración de IA. Comprueba la red y vuelve a cargarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les paramètres d’IA. Vérifiez le réseau, puis rechargez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as configurações de IA. Verifique a rede e recarregue."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuat pengaturan AI. Periksa jaringan, lalu muat ulang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Einstellungen konnten nicht geladen werden. Prüfe die Netzwerkverbindung und lade erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải cài đặt AI. Hãy kiểm tra mạng rồi tải lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ayarları yüklenemedi. Ağ bağlantısını kontrol edip yeniden yükleyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mai-load ang mga setting ng AI. Suriin ang network at i-load muli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดการตั้งค่า AI ไม่ได้ โปรดตรวจสอบเครือข่ายแล้วโหลดใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le impostazioni IA. Controlla la rete e ricarica."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wczytać ustawień AI. Sprawdź połączenie sieciowe i wczytaj ponownie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuatkan tetapan AI. Semak rangkaian, kemudian muat semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan AI-instellingen niet laden. Controleer de netwerkverbinding en laad opnieuw."
          }
        }
      }
    },
    "登入未完成或回應已失效。請檢查目前提示，或取消後重試。": {
      "comment": "native.aiSettingsView.loginError. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入未完成或回應已失效。請檢查目前提示，或取消後重試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in is incomplete or the response is no longer valid. Check the current prompt, or cancel and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインが未完了か、応答が無効になっています。現在の案内を確認するか、キャンセルして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 완료되지 않았거나 응답이 더 이상 유효하지 않습니다. 현재 안내를 확인하거나 취소한 후 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन अधूरा है या उत्तर अमान्य हो गया है। वर्तमान प्रॉम्प्ट जाँचें या रद्द करके फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión no se ha completado o la respuesta ya no es válida. Revisa la solicitud actual o cancela y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n’est pas terminée ou la réponse n’est plus valide. Vérifiez la demande actuelle, ou annulez puis réessayez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O login não foi concluído ou a resposta não é mais válida. Verifique a solicitação atual ou cancele e tente novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses masuk belum selesai atau respons tidak lagi berlaku. Periksa permintaan saat ini, atau batalkan lalu coba lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist nicht abgeschlossen oder die Antwort ist nicht mehr gültig. Prüfe die aktuelle Aufforderung oder brich ab und versuche es erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập chưa hoàn tất hoặc phản hồi đã mất hiệu lực. Hãy kiểm tra lời nhắc hiện tại, hoặc hủy rồi thử lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş tamamlanmadı veya yanıtın geçerliliği sona erdi. Mevcut istemi kontrol edin ya da iptal edip yeniden deneyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi natapos ang pag-sign in o hindi na wasto ang tugon. Suriin ang kasalukuyang prompt, o kanselahin at subukan muli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้ยังไม่เสร็จหรือการตอบกลับใช้ไม่ได้แล้ว โปรดตรวจสอบพรอมต์ปัจจุบัน หรือยกเลิกแล้วลองอีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso non è completo o la risposta non è più valida. Controlla la richiesta attuale oppure annulla e riprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie nie zostało ukończone lub odpowiedź jest już nieważna. Sprawdź bieżący monit albo anuluj i spróbuj ponownie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk belum selesai atau respons tidak lagi sah. Semak gesaan semasa, atau batalkan dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmelding is niet voltooid of het antwoord is niet meer geldig. Controleer het huidige verzoek of annuleer en probeer opnieuw."
          }
        }
      }
    },
    "無法保存模型偏好。請重新載入後重試。": {
      "comment": "native.aiSettingsView.saveError. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法保存模型偏好。請重新載入後重試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot save model preferences. Reload and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの設定を保存できません。再読み込みしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 환경설정을 저장할 수 없습니다. 다시 불러온 후 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल की प्राथमिकताएँ सहेजी नहीं जा सकीं। दोबारा लोड करके फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar las preferencias del modelo. Vuelve a cargar y reinténtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les préférences du modèle. Rechargez, puis réessayez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as preferências do modelo. Recarregue e tente novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan preferensi model. Muat ulang, lalu coba lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelleinstellungen konnten nicht gespeichert werden. Lade erneut und versuche es noch einmal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu tùy chọn mô hình. Hãy tải lại rồi thử lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model tercihleri kaydedilemedi. Yeniden yükleyip tekrar deneyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-save ang mga kagustuhan sa modelo. I-load muli at subukan ulit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการตั้งค่าโมเดลไม่ได้ โปรดโหลดใหม่แล้วลองอีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le preferenze del modello. Ricarica e riprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać preferencji modelu. Wczytaj ponownie i spróbuj jeszcze raz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan keutamaan model. Muat semula dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan modelvoorkeuren niet opslaan. Laad opnieuw en probeer het nogmaals."
          }
        }
      }
    },
    "無法確認解除連線結果。請重新載入後檢查連線。": {
      "comment": "native.aiSettingsView.disconnectError. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認解除連線結果。請重新載入後檢查連線。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot confirm the disconnection result. Reload and check the connections."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続解除の結果を確認できません。再読み込みして接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 해제 결과를 확인할 수 없습니다. 다시 불러온 후 연결을 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन हटने के परिणाम की पुष्टि नहीं हो सकी। दोबारा लोड करके कनेक्शन जाँचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el resultado de la desconexión. Vuelve a cargar y comprueba la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer le résultat de la déconnexion. Rechargez, puis vérifiez la connexion."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar o resultado da desconexão. Recarregue e verifique a conexão."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengonfirmasi hasil pemutusan koneksi. Muat ulang, lalu periksa koneksi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis der Trennung konnte nicht bestätigt werden. Lade erneut und prüfe die Verbindung."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác nhận kết quả ngắt kết nối. Hãy tải lại rồi kiểm tra kết nối."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı kaldırma sonucu doğrulanamadı. Yeniden yükleyip bağlantıyı kontrol edin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi matiyak ang resulta ng pagdiskonekta. I-load muli at suriin ang koneksyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันผลการยกเลิกการเชื่อมต่อไม่ได้ โปรดโหลดใหม่แล้วตรวจสอบการเชื่อมต่อ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare l'esito della disconnessione. Ricarica e controlla la connessione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można potwierdzić wyniku odłączenia. Wczytaj ponownie i sprawdź połączenie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengesahkan hasil pemutusan sambungan. Muat semula dan semak sambungan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan het resultaat van het verbreken niet bevestigen. Laad opnieuw en controleer de verbinding."
          }
        }
      }
    },
    "登入已到期或伺服器已重新啟動。請重新開始登入。": {
      "comment": "native.aiSettingsView.loginExpired. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入已到期或伺服器已重新啟動。請重新開始登入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in expired or the server restarted. Start sign-in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン手続きの期限が切れたか、サーバーが再起動しました。ログインをやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 만료되었거나 서버가 다시 시작되었습니다. 로그인을 다시 시작하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन की अवधि समाप्त हो गई या सर्वर दोबारा शुरू हुआ है। साइन इन फिर शुरू करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión ha caducado o el servidor se ha reiniciado. Inicia sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a expiré ou le serveur a redémarré. Recommencez la connexion."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O login expirou ou o servidor foi reiniciado. Inicie o login novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses masuk telah kedaluwarsa atau server telah dimulai ulang. Mulai proses masuk lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist abgelaufen oder der Server wurde neu gestartet. Starte die Anmeldung erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập đã hết hạn hoặc máy chủ đã khởi động lại. Hãy bắt đầu đăng nhập lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişin süresi doldu veya sunucu yeniden başlatıldı. Girişi yeniden başlatın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire ang pag-sign in o nag-restart ang server. Simulan muli ang pag-sign in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้หมดอายุหรือเซิร์ฟเวอร์เริ่มใหม่แล้ว โปรดเริ่มลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso è scaduto o il server è stato riavviato. Avvia di nuovo l'accesso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie wygasło lub serwer został uruchomiony ponownie. Rozpocznij logowanie od nowa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk telah tamat tempoh atau pelayan telah dimulakan semula. Mulakan log masuk sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmelding is verlopen of de server is opnieuw gestart. Start de aanmelding opnieuw."
          }
        }
      }
    },
    "登入次數已達上限。請取消待處理的登入，或稍後重試。": {
      "comment": "native.aiSettingsView.loginLimit. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入次數已達上限。請取消待處理的登入，或稍後重試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in limit has been reached. Cancel pending sign-ins or try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン回数が上限に達しました。保留中のログインをキャンセルするか、後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 횟수가 한도에 도달했습니다. 대기 중인 로그인을 취소하거나 나중에 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन की अधिकतम सीमा पूरी हो गई है। लंबित साइन इन रद्द करें या बाद में कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha alcanzado el límite de inicios de sesión. Cancela los inicios pendientes o reinténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite de connexions est atteinte. Annulez les connexions en attente ou réessayez plus tard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de logins foi atingido. Cancele os logins pendentes ou tente novamente mais tarde."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas jumlah proses masuk telah tercapai. Batalkan proses masuk yang tertunda, atau coba lagi nanti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die maximale Anzahl an Anmeldungen ist erreicht. Brich ausstehende Anmeldungen ab oder versuche es später erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đạt giới hạn số lần đăng nhập. Hãy hủy lần đăng nhập đang chờ, hoặc thử lại sau."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş sınırına ulaşıldı. Bekleyen girişleri iptal edin veya daha sonra yeniden deneyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naabot na ang limitasyon sa pag-sign in. Kanselahin ang mga nakabinbing pag-sign in o subukan muli mamaya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถึงจำนวนการลงชื่อเข้าใช้สูงสุดแล้ว โปรดยกเลิกการลงชื่อเข้าใช้ที่รออยู่ หรือลองอีกครั้งภายหลัง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato raggiunto il limite di accessi. Annulla gli accessi in sospeso o riprova più tardi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto limit logowań. Anuluj oczekujące logowania lub spróbuj później."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Had bilangan log masuk telah dicapai. Batalkan log masuk yang tertunda, atau cuba lagi kemudian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maximumaantal aanmeldingen is bereikt. Annuleer openstaande aanmeldingen of probeer het later opnieuw."
          }
        }
      }
    },
    "伺服器目前無法建立連線。請稍後重試。": {
      "comment": "native.aiSettingsView.connectionError. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器目前無法建立連線。請稍後重試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server cannot currently establish a connection. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、サーバーで接続を確立できません。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 서버에서 연결을 설정할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर अभी कनेक्शन नहीं बना सकता। बाद में फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no puede establecer la conexión en este momento. Reinténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne peut pas établir de connexion actuellement. Réessayez plus tard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não pode estabelecer a conexão no momento. Tente novamente mais tarde."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server saat ini tidak dapat membuat koneksi. Coba lagi nanti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server kann derzeit keine Verbindung herstellen. Versuche es später erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ hiện không thể tạo kết nối. Vui lòng thử lại sau."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu şu anda bağlantı kuramıyor. Daha sonra yeniden deneyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makagawa ng koneksyon ang server sa ngayon. Subukan muli mamaya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้เซิร์ฟเวอร์สร้างการเชื่อมต่อไม่ได้ โปรดลองอีกครั้งภายหลัง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento il server non può stabilire una connessione. Riprova più tardi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie może teraz nawiązać połączenia. Spróbuj później."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan kini tidak dapat mencipta sambungan. Cuba lagi kemudian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server kan momenteel geen verbinding maken. Probeer het later opnieuw."
          }
        }
      }
    },
