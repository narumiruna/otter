        }
      }
    },
    "此草稿正在同步或提交結果不明，不能修改內容。": {
      "comment": "native.expenseQueue.editLocked. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此草稿正在同步或提交結果不明，不能修改內容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft is syncing or its submission result is unknown. Its content cannot be changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この下書きは同期中か、送信結果が不明なため、内容を変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 초안은 동기화 중이거나 제출 결과가 불확실하므로 내용을 수정할 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ड्राफ़्ट सिंक हो रहा है या भेजने का परिणाम अज्ञात है; सामग्री नहीं बदल सकते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este borrador se está sincronizando o el resultado del envío es desconocido; no se puede modificar su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce brouillon est en cours de synchronisation ou le résultat de l’envoi est inconnu ; son contenu ne peut pas être modifié."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este rascunho está sendo sincronizado ou o resultado do envio é desconhecido; não é possível modificar o conteúdo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf ini sedang disinkronkan atau hasil pengirimannya tidak diketahui; konten tidak dapat diubah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Entwurf wird synchronisiert oder das Übermittlungsergebnis ist unbekannt. Der Inhalt kann nicht geändert werden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản nháp này đang đồng bộ hoặc kết quả gửi chưa rõ, không thể sửa nội dung."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu taslak eşitleniyor veya gönderim sonucu bilinmiyor; içerik değiştirilemez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagsi-sync ang draft na ito o hindi tiyak ang resulta ng pagsusumite, kaya hindi mababago ang nilalaman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉบับร่างนี้กำลังซิงค์หรือไม่ทราบผลการส่ง จึงแก้ไขเนื้อหาไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bozza è in sincronizzazione o l'esito dell'invio è sconosciuto. Non puoi modificarne i contenuti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa synchronizacja tego szkicu lub wynik wysłania jest nieznany. Nie można zmieniać treści."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf ini sedang disegerakkan atau hasil penghantarannya tidak diketahui; kandungan tidak boleh diubah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit concept wordt gesynchroniseerd of het indieningsresultaat is onbekend. De inhoud kan niet worden gewijzigd."
          }
        }
      }
    },
    "提交結果可能不明。請先核對伺服器，再明確確認刪除本機資料。": {
      "comment": "native.expenseQueue.deletionNeedsServerCheck. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交結果可能不明。請先核對伺服器，再明確確認刪除本機資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The submission result may be unknown. Check the server first, then explicitly confirm deleting local data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信結果が不明な可能性があります。先にサーバーを確認してから、ローカルデータの削除を明示的に確定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출 결과를 알 수 없을 수 있습니다. 먼저 서버를 확인한 후 로컬 데이터 삭제를 명시적으로 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने का परिणाम अज्ञात हो सकता है। पहले सर्वर जाँचें, फिर स्थानीय डेटा हटाने की स्पष्ट पुष्टि करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado del envío puede ser desconocido. Comprueba primero el servidor y luego confirma expresamente la eliminación de los datos locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de l’envoi peut être inconnu. Vérifiez d’abord le serveur, puis confirmez explicitement la suppression des données locales."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado do envio pode ser desconhecido. Confira primeiro o servidor e depois confirme explicitamente a exclusão dos dados locais."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil pengiriman mungkin tidak diketahui. Periksa server terlebih dahulu, lalu konfirmasikan penghapusan data lokal secara eksplisit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Übermittlungsergebnis ist möglicherweise unbekannt. Prüfe zuerst den Server und bestätige dann ausdrücklich das Löschen der lokalen Daten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả gửi có thể chưa rõ. Hãy kiểm tra máy chủ trước, rồi chủ động xác nhận xóa dữ liệu cục bộ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderim sonucu belirsiz olabilir. Önce sunucuyu kontrol edin, ardından yerel verileri silmeyi açıkça onaylayın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring hindi tiyak ang resulta ng pagsusumite. Suriin muna ang server, saka tahasang kumpirmahin ang pagbura sa lokal na datos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลการส่งอาจไม่ชัดเจน โปรดตรวจสอบเซิร์ฟเวอร์ก่อน แล้วยืนยันการลบข้อมูลในอุปกรณ์อย่างชัดเจน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esito dell'invio potrebbe essere sconosciuto. Verifica prima il server, poi conferma esplicitamente l'eliminazione dei dati locali."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik wysłania może być nieznany. Najpierw sprawdź serwer, a następnie jawnie potwierdź usunięcie danych lokalnych."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil penghantaran mungkin tidak diketahui. Semak pelayan dahulu, kemudian sahkan pemadaman data setempat secara nyata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het indieningsresultaat kan onbekend zijn. Controleer eerst de server en bevestig daarna uitdrukkelijk de verwijdering van lokale gegevens."
          }
        }
      }
    },
