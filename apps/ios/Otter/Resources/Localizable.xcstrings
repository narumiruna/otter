    "確認群組變更？": {
      "comment": "native.groupSettingsView.confirmChange. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認群組變更？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm group changes?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループの変更を確定しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 변경을 확인할까요?"
          }
        },
        "hi": {
