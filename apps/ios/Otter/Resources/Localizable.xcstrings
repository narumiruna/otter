      }
    },
    "Passkey 註冊取消後，可在 5 分鐘內重試或改用密碼完成同一個 Username 的註冊。": {
      "comment": "native.rootView.passkeyRetryNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey 註冊取消後，可在 5 分鐘內重試或改用密碼完成同一個 Username 的註冊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After canceling Passkey registration, you can retry within 5 minutes or use a password to complete registration for the same Username."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkeyの登録をキャンセルした後は、5分以内に再試行するか、パスワードを使って同じUsernameの登録を完了できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey 등록을 취소한 후 5분 이내에 다시 시도하거나 비밀번호로 같은 Username의 가입을 완료할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey पंजीकरण रद्द करने के बाद 5 मिनट के भीतर फिर कोशिश कर सकते हैं या उसी Username का पंजीकरण पासवर्ड से पूरा कर सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cancelas el registro con Passkey, puedes reintentarlo en un plazo de 5 minutos o usar una contraseña para completar el registro del mismo Username."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’annulation de l’inscription par Passkey, vous pouvez réessayer dans les 5 minutes ou utiliser un mot de passe pour terminer l’inscription du même Username."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após cancelar o cadastro com Passkey, você pode tentar novamente em até 5 minutos ou usar uma senha para concluir o cadastro do mesmo Username."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah pendaftaran Passkey dibatalkan, Anda dapat mencoba lagi dalam 5 menit atau menggunakan kata sandi untuk menyelesaikan pendaftaran Username yang sama."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Abbruch der Passkey-Registrierung kannst du sie innerhalb von 5 Minuten erneut versuchen oder die Registrierung desselben Username mit einem Passwort abschließen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi hủy đăng ký Passkey, bạn có thể thử lại trong 5 phút hoặc dùng mật khẩu để hoàn tất đăng ký cùng Username."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey kaydı iptal edildikten sonra 5 dakika içinde yeniden deneyebilir veya aynı Username kaydını parolayla tamamlayabilirsiniz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag kinansela ang pagpaparehistro ng Passkey, maaaring subukan muli sa loob ng 5 minuto o gumamit ng password upang tapusin ang pagpaparehistro sa parehong Username."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังยกเลิกการสมัครด้วย Passkey คุณลองใหม่หรือใช้รหัสผ่านสมัคร Username เดิมให้เสร็จได้ภายใน 5 นาที"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver annullato la registrazione Passkey, puoi riprovare entro 5 minuti o usare una password per completare la registrazione dello stesso Username."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po anulowaniu rejestracji Passkey możesz w ciągu 5 minut ponowić próbę lub dokończyć rejestrację tego samego Username za pomocą hasła."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas pendaftaran Passkey dibatalkan, anda boleh mencuba lagi dalam 5 minit atau menggunakan kata laluan untuk menyelesaikan pendaftaran Username yang sama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na het annuleren van de Passkey-registratie kun je binnen 5 minuten opnieuw proberen of met een wachtwoord de registratie van dezelfde Username voltooien."
          }
        }
      }
    },
