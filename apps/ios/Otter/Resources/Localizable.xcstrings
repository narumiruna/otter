    "快照記錄有收據；不代表可還原舊圖片。": {
      "comment": "native.expenseEditorSnapshotDetails.receiptNotRestorable. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快照記錄有收據；不代表可還原舊圖片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The snapshot records a receipt. This does not mean the old image can be restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットに領収書の記録がありますが、古い画像を復元できるという意味ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스냅샷에 영수증이 기록되어 있어도 이전 이미지를 복원할 수 있다는 뜻은 아닙니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्नैपशॉट में रसीद दर्ज है; इसका अर्थ पुरानी तस्वीर वापस मिलना नहीं है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instantánea registra un recibo; esto no significa que se pueda restaurar la imagen anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’instantané mentionne un reçu ; cela ne signifie pas que l’ancienne image peut être restaurée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro indica um recibo; isso não significa que seja possível restaurar a imagem antiga."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman mencatat adanya tanda terima; ini tidak berarti gambar lama dapat dipulihkan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Momentaufnahme vermerkt einen Beleg. Das bedeutet nicht, dass das alte Bild wiederhergestellt werden kann."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chụp ghi nhận có biên lai; không có nghĩa là có thể khôi phục ảnh cũ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlık görüntüde makbuz kaydı var; bu, eski görselin geri yüklenebileceği anlamına gelmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May resibo sa tala ng snapshot; hindi ito nangangahulugang maibabalik ang lumang larawan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพรวม ณ เวลานั้นระบุว่ามีใบเสร็จ แต่ไม่ได้หมายความว่ากู้คืนรูปเดิมได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'istantanea indica una ricevuta, ma ciò non significa che la vecchia immagine sia ripristinabile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis stanu zawiera informację o paragonie. Nie oznacza to, że można przywrócić stary obraz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petikan merekodkan adanya resit; ini tidak bermakna imej lama boleh dipulihkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De momentopname vermeldt een bon. Dit betekent niet dat de oude afbeelding kan worden hersteld."
          }
        }
      }
    },
    "快照未記錄收據。": {
      "comment": "native.expenseEditorSnapshotDetails.noReceipt. Application-owned text.",
