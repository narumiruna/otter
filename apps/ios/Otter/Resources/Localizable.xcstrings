    "需要以帳號工作階段登入的擁有者才能變更。": {
      "comment": "native.groupSettingsView.ownerSessionRequired. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要以帳號工作階段登入的擁有者才能變更。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an owner signed in with an account session can change this."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更には、所有者がアカウントのセッションでログインする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 세션으로 로그인한 소유자만 변경할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलने के लिए खाते के सत्र से साइन इन किया हुआ स्वामी चाहिए।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el propietario que haya iniciado sesión con una sesión de cuenta puede cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le propriétaire connecté avec une session de compte peut effectuer cette modification."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o proprietário conectado com uma sessão de conta pode fazer esta alteração."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan memerlukan pemilik yang masuk melalui sesi akun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen erfordern einen über eine Kontositzung angemeldeten Eigentümer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần chủ sở hữu đăng nhập bằng phiên tài khoản để thay đổi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirmek için hesap oturumuyla giriş yapan sahip olmak gerekir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ang may-aring naka-sign in sa session ng account upang baguhin ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องเป็นเจ้าของที่ลงชื่อเข้าใช้ผ่านเซสชันบัญชีจึงจะเปลี่ยนได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per modificare serve il proprietario autenticato tramite una sessione dell'account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana wymaga właściciela zalogowanego przez sesję konta."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan memerlukan pemilik yang log masuk melalui sesi akaun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigen vereist een eigenaar die via een accountsessie is aangemeld."
          }
        }
      }
    },
