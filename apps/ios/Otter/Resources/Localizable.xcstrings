    "圖片無效，或轉換後的 JPEG 超過 5 MB。請選擇其他圖片。": {
      "comment": "native.receiptPickerView.imageSizeError. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片無效，或轉換後的 JPEG 超過 5 MB。請選擇其他圖片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is invalid, or the converted JPEG exceeds 5 MB. Select another image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像が無効か、変換後のJPEGが5 MBを超えています。別の画像を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 유효하지 않거나 변환된 JPEG가 5 MB를 초과합니다. 다른 이미지를 선택하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तस्वीर अमान्य है या बदलने के बाद JPEG 5 MB से बड़ा है। दूसरी तस्वीर चुनें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen no es válida o el JPEG convertido supera los 5 MB. Selecciona otra imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image est invalide ou le JPEG converti dépasse 5 MB. Choisissez une autre image."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem é inválida ou o JPEG convertido ultrapassa 5 MB. Selecione outra imagem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar tidak valid, atau JPEG hasil konversi melebihi 5 MB. Pilih gambar lain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild ist ungültig oder das konvertierte JPEG ist größer als 5 MB. Wähle ein anderes Bild."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh không hợp lệ hoặc JPEG sau chuyển đổi vượt 5 MB. Hãy chọn ảnh khác."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel geçersiz veya dönüştürülen JPEG 5 MB sınırını aşıyor. Başka bir görsel seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi wasto ang larawan o lampas sa 5 MB ang JPEG matapos i-convert. Pumili ng ibang larawan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพไม่ถูกต้อง หรือ JPEG หลังแปลงมีขนาดเกิน 5 MB โปรดเลือกรูปอื่น"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'immagine non è valida oppure il JPEG convertito supera 5 MB. Scegli un'altra immagine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz jest nieprawidłowy lub przekonwertowany JPEG przekracza 5 MB. Wybierz inny obraz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej tidak sah, atau JPEG selepas penukaran melebihi 5 MB. Pilih imej lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afbeelding is ongeldig of de omgezette JPEG is groter dan 5 MB. Kies een andere afbeelding."
          }
        }
      }
    },
    "此裝置無法使用相機。請從相簿選擇收據。": {
      "comment": "native.receiptPickerView.cameraUnavailable. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置無法使用相機。請從相簿選擇收據。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is unavailable on this device. Select a receipt from the photo library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではカメラを使用できません。写真ライブラリから領収書を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 카메라를 사용할 수 없습니다. 사진 보관함에서 영수증을 선택하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर कैमरा उपलब्ध नहीं है। फ़ोटो लाइब्रेरी से रसीद चुनें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible en este dispositivo. Selecciona un recibo de la fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo est indisponible sur cet appareil. Choisissez un reçu dans la photothèque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não está disponível neste dispositivo. Selecione um recibo na biblioteca de fotos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak tersedia di perangkat ini. Pilih tanda terima dari galeri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist keine Kamera verfügbar. Wähle einen Beleg aus der Fotomediathek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không dùng được camera. Hãy chọn biên lai từ thư viện ảnh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda kamera kullanılamıyor. Makbuzu fotoğraf arşivinden seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi magamit ang camera sa device na ito. Pumili ng resibo mula sa mga larawan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ใช้กล้องไม่ได้ โปรดเลือกใบเสร็จจากคลังรูปภาพ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non è disponibile su questo dispositivo. Scegli una ricevuta dalla libreria foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat jest niedostępny na tym urządzeniu. Wybierz paragon z biblioteki zdjęć."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak tersedia pada peranti ini. Pilih resit daripada galeri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera is niet beschikbaar op dit apparaat. Kies een bon uit de fotobibliotheek."
          }
        }
      }
    },
    "此版本未設定相機權限說明。請從相簿選擇收據。": {
      "comment": "native.receiptPickerView.missingPermissionDescription. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未設定相機權限說明。請從相簿選擇收據。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version has no camera permission description configured. Select a receipt from the photo library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンにはカメラ権限の説明が設定されていません。写真ライブラリから領収書を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전에는 카메라 권한 설명이 설정되어 있지 않습니다. 사진 보관함에서 영수증을 선택하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस संस्करण में कैमरा अनुमति का विवरण तय नहीं है। फ़ोटो लाइब्रेरी से रसीद चुनें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no tiene configurada la descripción del permiso de cámara. Selecciona un recibo de la fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne définit pas de description pour l’autorisation de l’appareil photo. Choisissez un reçu dans la photothèque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão não tem uma descrição de permissão de câmera configurada. Selecione um recibo na biblioteca de fotos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi ini belum mengatur deskripsi izin kamera. Pilih tanda terima dari galeri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Version fehlt die Beschreibung für die Kameraberechtigung. Wähle einen Beleg aus der Fotomediathek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản này chưa đặt mô tả quyền camera. Hãy chọn biên lai từ thư viện ảnh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürümde kamera izni açıklaması ayarlanmamış. Makbuzu fotoğraf arşivinden seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nakatakdang paliwanag sa pahintulot ng camera sa bersyong ito. Pumili ng resibo mula sa mga larawan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันนี้ไม่ได้ตั้งค่าคำอธิบายสิทธิ์กล้อง โปรดเลือกใบเสร็จจากคลังรูปภาพ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione non include la descrizione del permesso per la fotocamera. Scegli una ricevuta dalla libreria foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej wersji nie ustawiono opisu uprawnienia do aparatu. Wybierz paragon z biblioteki zdjęć."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi ini belum menetapkan keterangan kebenaran kamera. Pilih resit daripada galeri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In deze versie ontbreekt de beschrijving van de cameratoestemming. Kies een bon uit de fotobibliotheek."
          }
        }
      }
    },
    "相機權限已拒絕或受限制。可在 iOS 設定中允許相機，或改從相簿選擇。": {
      "comment": "native.receiptPickerView.permissionDenied. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機權限已拒絕或受限制。可在 iOS 設定中允許相機，或改從相簿選擇。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is denied or restricted. Allow camera access in iOS Settings, or select from the photo library instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの権限が拒否または制限されています。iOSの設定でカメラを許可するか、写真ライブラリから選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 권한이 거부되었거나 제한되었습니다. iOS 설정에서 카메라를 허용하거나 사진 보관함에서 선택하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे की अनुमति अस्वीकार या सीमित है। iOS सेटिंग में कैमरे की अनुमति दें या फ़ोटो लाइब्रेरी से चुनें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de cámara se ha denegado o está restringido. Puedes permitir el acceso en los ajustes de iOS o seleccionar una foto de la fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’appareil photo est refusé ou restreint. Vous pouvez l’autoriser dans les réglages iOS ou choisir une photo dans la photothèque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão da câmera foi negada ou está restrita. Você pode permitir o acesso nos ajustes do iOS ou selecionar uma foto na biblioteca."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin kamera ditolak atau dibatasi. Izinkan kamera di pengaturan iOS, atau pilih dari galeri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff wurde verweigert oder eingeschränkt. Erlaube ihn in den iOS-Einstellungen oder wähle ein Foto aus der Fotomediathek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền camera bị từ chối hoặc hạn chế. Bạn có thể cho phép camera trong cài đặt iOS hoặc chọn từ thư viện ảnh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera izni reddedildi veya kısıtlandı. iOS ayarlarında kameraya izin verebilir veya fotoğraf arşivinden seçim yapabilirsiniz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinanggihan o nilimitahan ang pahintulot sa camera. Maaari itong payagan sa mga setting ng iOS o pumili mula sa mga larawan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์กล้องถูกปฏิเสธหรือจำกัด คุณอนุญาตกล้องได้ในการตั้งค่า iOS หรือเลือกจากคลังรูปภาพแทน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permesso per la fotocamera è negato o limitato. Puoi consentirlo nelle impostazioni iOS oppure scegliere dalla libreria foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do aparatu został odrzucony lub ograniczony. Możesz zezwolić na aparat w ustawieniach iOS lub wybrać zdjęcie z biblioteki."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebenaran kamera ditolak atau dihadkan. Benarkan kamera dalam tetapan iOS, atau pilih daripada galeri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameratoestemming is geweigerd of beperkt. Sta de camera toe in de iOS-instellingen of kies uit de fotobibliotheek."
          }
        }
      }
    },
    "將 JSON 備份還原成新的支出群組，不覆蓋目前群組。照片與版本歷史不包含在群組備份內。": {
      "comment": "native.restoreBackupView.description. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 JSON 備份還原成新的支出群組，不覆蓋目前群組。照片與版本歷史不包含在群組備份內。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore a JSON backup as a new expense group without overwriting the current group. Photos and version history are not included in group backups."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSONバックアップを新しい支出グループとして復元します。現在のグループは上書きしません。グループのバックアップに写真とバージョン履歴は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 백업을 새 지출 그룹으로 복원하며 현재 그룹은 덮어쓰지 않습니다. 그룹 백업에는 사진과 버전 기록이 포함되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON बैकअप को नए खर्च समूह के रूप में वापस लाएँ; वर्तमान समूह के ऊपर नहीं लिखा जाएगा। समूह के बैकअप में तस्वीरें और संस्करण का इतिहास शामिल नहीं हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura una copia de seguridad JSON como un nuevo grupo de gastos, sin sobrescribir el grupo actual. Las fotos y el historial de versiones no se incluyen en la copia de seguridad del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez une sauvegarde JSON dans un nouveau groupe de dépenses, sans écraser le groupe actuel. Les photos et l’historique des versions ne sont pas inclus dans la sauvegarde du groupe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure um backup JSON como um novo grupo de despesas, sem sobrescrever o grupo atual. Fotos e histórico de versões não estão incluídos no backup do grupo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan cadangan JSON menjadi grup pengeluaran baru tanpa menimpa grup saat ini. Foto dan riwayat versi tidak tercakup dalam cadangan grup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt eine JSON-Sicherung als neue Ausgabengruppe wieder her, ohne die aktuelle Gruppe zu überschreiben. Fotos und Versionsverlauf sind nicht in Gruppensicherungen enthalten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục bản sao lưu JSON thành nhóm khoản chi mới, không ghi đè nhóm hiện tại. Ảnh và lịch sử phiên bản không nằm trong bản sao lưu nhóm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON yedeğini mevcut grubun üzerine yazmadan yeni bir gider grubu olarak geri yükler. Grup yedeği fotoğrafları ve sürüm geçmişini içermez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibalik ang JSON backup bilang bagong grupo ng gastos, nang hindi pinapatungan ang kasalukuyang grupo. Hindi kasama sa backup ng grupo ang mga larawan at kasaysayan ng bersyon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนข้อมูลสำรอง JSON เป็นกลุ่มรายจ่ายใหม่ โดยไม่เขียนทับกลุ่มปัจจุบัน ข้อมูลสำรองกลุ่มไม่รวมรูปภาพและประวัติเวอร์ชัน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina un backup JSON come nuovo gruppo di spese, senza sovrascrivere il gruppo attuale. Foto e cronologia delle versioni non sono incluse nei backup del gruppo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca kopię JSON jako nową grupę wydatków, bez nadpisywania bieżącej grupy. Kopia grupy nie zawiera zdjęć ani historii wersji."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan sandaran JSON menjadi kumpulan perbelanjaan baharu tanpa menulis ganti kumpulan semasa. Foto dan sejarah versi tidak termasuk dalam sandaran kumpulan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt een JSON-reservekopie als een nieuwe uitgavengroep, zonder de huidige groep te overschrijven. Foto's en versiegeschiedenis zijn niet opgenomen in groepsreservekopieën."
          }
        }
      }
    },
