        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list does not yet include this request. Retry the same creation request; no new secret will be generated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧にこのリクエストはまだ含まれていません。同じ作成リクエストで再試行できます。新しい秘密情報は生成しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 이 요청이 아직 없습니다. 같은 생성 요청을 다시 시도할 수 있으며 새 비밀 정보는 생성하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची में अभी यह अनुरोध शामिल नहीं है। उसी बनाने के अनुरोध से फिर कोशिश कर सकते हैं; नई गुप्त कुंजी नहीं बनेगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista aún no incluye esta solicitud. Puedes reintentar la misma solicitud de creación; no se generará una clave secreta nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste ne contient pas encore cette requête. Vous pouvez réessayer la même requête de création ; aucune nouvelle clé secrète ne sera générée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista ainda não contém esta solicitação. Você pode repetir a mesma solicitação de criação; uma nova chave secreta não será gerada."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar belum mencakup permintaan ini. Anda dapat mencoba ulang permintaan pembuatan yang sama; kunci rahasia baru tidak akan dihasilkan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste enthält diese Anfrage noch nicht. Du kannst dieselbe Erstellungsanfrage wiederholen. Es wird kein neuer Geheimschlüssel erzeugt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách chưa có yêu cầu này. Có thể thử lại cùng yêu cầu tạo; sẽ không tạo khóa bí mật mới."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste henüz bu isteği içermiyor. Aynı oluşturma isteğini yeniden deneyebilirsiniz; yeni bir gizli anahtar üretilmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pa sa listahan ang kahilingang ito. Maaaring ulitin ang parehong kahilingan sa paggawa; hindi gagawa ng bagong lihim na susi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการยังไม่มีคำขอนี้ คุณลองคำขอสร้างเดิมซ้ำได้ โดยจะไม่สร้างคีย์ลับใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco non include ancora questa richiesta. Puoi riprovare con la stessa richiesta di creazione. Non verrà generata una nuova chiave segreta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista nie zawiera jeszcze tego żądania. Możesz ponowić to samo żądanie utworzenia. Nowy sekret nie zostanie wygenerowany."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai belum merangkumi permintaan ini. Anda boleh mencuba semula permintaan penciptaan yang sama; kunci rahsia baharu tidak akan dijana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst bevat deze aanvraag nog niet. Je kunt dezelfde aanmaakaanvraag opnieuw proberen. Er wordt geen nieuwe geheime sleutel gegenereerd."
          }
        }
      }
    },
