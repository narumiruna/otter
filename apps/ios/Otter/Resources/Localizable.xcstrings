    "供應商登入連結不安全，無法開啟。請取消後重試。": {
      "comment": "native.aiSettingsView.unsafeLoginLink. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商登入連結不安全，無法開啟。請取消後重試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider sign-in link is unsafe and cannot be opened. Cancel and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーのログインリンクは安全ではないため開けません。キャンセルして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공급자 로그인 링크가 안전하지 않아 열 수 없습니다. 취소한 후 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रदाता का साइन इन लिंक सुरक्षित नहीं है और खोला नहीं जा सकता। रद्द करके फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace de inicio de sesión del proveedor no es seguro y no se puede abrir. Cancela y reinténtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien de connexion du fournisseur n’est pas sûr et ne peut pas être ouvert. Annulez, puis réessayez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O link de login do provedor não é seguro e não pode ser aberto. Cancele e tente novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan masuk penyedia tidak aman dan tidak dapat dibuka. Batalkan, lalu coba lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anmeldelink des Anbieters ist unsicher und kann nicht geöffnet werden. Brich ab und versuche es erneut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết đăng nhập nhà cung cấp không an toàn nên không thể mở. Hãy hủy rồi thử lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcının giriş bağlantısı güvenli olmadığı için açılamıyor. İptal edip yeniden deneyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ligtas ang link sa pag-sign in ng provider at hindi ito mabubuksan. Kanselahin at subukan muli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ลงชื่อเข้าใช้ของผู้ให้บริการไม่ปลอดภัย จึงเปิดไม่ได้ โปรดยกเลิกแล้วลองอีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link di accesso del fornitore non è sicuro e non può essere aperto. Annulla e riprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link logowania dostawcy jest niebezpieczny i nie można go otworzyć. Anuluj i spróbuj ponownie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan log masuk penyedia tidak selamat dan tidak dapat dibuka. Batalkan dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmeldlink van de aanbieder is onveilig en kan niet worden geopend. Annuleer en probeer opnieuw."
          }
        }
      }
    },
    "帳號存取權與支出參與者不同。新增參與者不會授予帳號權限。": {
      "comment": "native.accessSettingsView.accessVsParticipants. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號存取權與支出參與者不同。新增參與者不會授予帳號權限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account access and expense participants are separate. Adding a participant does not grant account permissions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのアクセス権と支出の参加者は別です。参加者を追加しても、アカウントに権限は付与されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 접근 권한과 지출 참여자는 별개입니다. 참여자를 추가해도 계정 권한은 부여되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते का पहुँच अधिकार और खर्च के सहभागी अलग हैं। सहभागी जोड़ने से खाते को अधिकार नहीं मिलते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de las cuentas es distinto de la participación en los gastos. Añadir un participante no otorga permisos a ninguna cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les droits d’accès des comptes sont distincts de la participation aux dépenses. Ajouter un participant n’accorde aucun droit à un compte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso das contas é diferente da participação nas despesas. Adicionar um participante não concede permissões a uma conta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hak akses akun berbeda dari peserta pengeluaran. Menambahkan peserta tidak memberi izin akun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontozugriff und Ausgabenteilnehmer sind nicht dasselbe. Das Hinzufügen von Teilnehmern gewährt keine Kontoberechtigungen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập tài khoản khác với người tham gia khoản chi. Thêm người tham gia không cấp quyền cho tài khoản."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap erişim hakları ile gider katılımcıları farklıdır. Katılımcı eklemek hesaba yetki vermez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magkaiba ang karapatan sa pag-access ng account at ang mga kalahok sa gastos. Hindi nagbibigay ng karapatan sa account ang pagdagdag ng kalahok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์เข้าถึงของบัญชีกับผู้ร่วมรายจ่ายเป็นคนละส่วนกัน การเพิ่มผู้ร่วมรายจ่ายไม่ได้ให้สิทธิ์แก่บัญชี"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso dell'account è distinto dai partecipanti alle spese. Aggiungere un partecipante non concede permessi all'account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienia dostępu konta i uczestnicy wydatków to różne rzeczy. Dodanie uczestnika nie nadaje uprawnień kontu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hak akses akaun berbeza daripada peserta perbelanjaan. Menambah peserta tidak memberikan kebenaran akaun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounttoegang staat los van deelnemers aan uitgaven. Een deelnemer toevoegen verleent geen accountrechten."
          }
        }
      }
    },
    "只有以帳號工作階段登入的擁有者可管理協作者與分享連結。API token 不可執行此操作。": {
      "comment": "native.accessSettingsView.ownerSessionRequired. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有以帳號工作階段登入的擁有者可管理協作者與分享連結。API token 不可執行此操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an owner signed in with an account session can manage collaborators and shared links. An API token cannot perform this operation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共同編集者と共有リンクを管理できるのは、アカウントのセッションでログインした所有者のみです。API tokenではこの操作はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 세션으로 로그인한 소유자만 공동 작업자와 공유 링크를 관리할 수 있습니다. API token으로는 이 작업을 할 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल खाते के सत्र से साइन इन किया हुआ स्वामी सहयोगियों और साझा लिंक का प्रबंधन कर सकता है। API token से यह कार्रवाई नहीं की जा सकती।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el propietario que haya iniciado sesión con una sesión de cuenta puede gestionar colaboradores y enlaces compartidos. Un API token no permite realizar esta operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le propriétaire connecté avec une session de compte peut gérer les collaborateurs et les liens de partage. Un API token ne permet pas cette opération."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o proprietário conectado com uma sessão de conta pode gerenciar colaboradores e links de compartilhamento. Um API token não permite esta operação."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pemilik yang masuk melalui sesi akun dapat mengelola kolaborator dan tautan berbagi. API token tidak dapat melakukan operasi ini."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Eigentümer, die über eine Kontositzung angemeldet sind, können Mitwirkende und Freigabelinks verwalten. Ein API token kann diesen Vorgang nicht ausführen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ chủ sở hữu đăng nhập bằng phiên tài khoản mới có thể quản lý cộng tác viên và liên kết chia sẻ. API token không thể thực hiện thao tác này."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca hesap oturumuyla giriş yapan sahip, ortak çalışanları ve paylaşım bağlantılarını yönetebilir. API token ile bu işlem yapılamaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanging may-ari na naka-sign in sa isang session ng account ang maaaring mamahala ng mga katuwang at nakabahaging link. Hindi ito magagawa gamit ang API token."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเจ้าของที่ลงชื่อเข้าใช้ผ่านเซสชันบัญชีเท่านั้นที่จัดการผู้ร่วมงานและลิงก์แชร์ได้ ใช้ API token ทำรายการนี้ไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il proprietario autenticato tramite una sessione dell'account può gestire collaboratori e link di condivisione. Un API token non può eseguire questa operazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko właściciel zalogowany przez sesję konta może zarządzać współpracownikami i linkami udostępniania. API token nie pozwala na tę operację."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pemilik yang log masuk melalui sesi akaun boleh mengurus kolaborator dan pautan perkongsian. API token tidak boleh melakukan operasi ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de eigenaar die via een accountsessie is aangemeld, kan medewerkers en deellinks beheren. Dit kan niet met een API token."
          }
        }
      }
    },
    "群組已封存。仍可管理存取權，但不能編輯日常資料。": {
      "comment": "native.accessSettingsView.archivedNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組已封存。仍可管理存取權，但不能編輯日常資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group is archived. You can still manage access, but cannot edit everyday data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループはアーカイブ済みです。アクセス権は引き続き管理できますが、日常のデータは編集できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 그룹입니다. 접근 권한은 계속 관리할 수 있지만 일상 데이터는 편집할 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह संग्रहित है। पहुँच अधिकारों का प्रबंधन अब भी कर सकते हैं, लेकिन रोज़मर्रा का डेटा संपादित नहीं कर सकते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo está archivado. Aún puedes gestionar el acceso, pero no editar los datos cotidianos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe est archivé. Vous pouvez toujours gérer l’accès, mais pas modifier les données courantes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O grupo foi arquivado. Ainda é possível gerenciar o acesso, mas não editar os dados cotidianos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup telah diarsipkan. Hak akses masih dapat dikelola, tetapi data sehari-hari tidak dapat diedit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe ist archiviert. Zugriffsrechte können weiterhin verwaltet werden, Alltagsdaten jedoch nicht bearbeitet werden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm đã được lưu trữ. Bạn vẫn có thể quản lý quyền truy cập, nhưng không thể chỉnh sửa dữ liệu hằng ngày."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup arşivlendi. Erişim hakları hâlâ yönetilebilir ancak günlük veriler düzenlenemez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-archive ang grupo. Maaari pa ring pamahalaan ang pag-access, pero hindi maaaring baguhin ang pang-araw-araw na datos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บกลุ่มเข้าคลังแล้ว ยังจัดการสิทธิ์เข้าถึงได้ แต่แก้ไขข้อมูลประจำวันไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo è archiviato. Puoi ancora gestire l'accesso, ma non modificare i dati ordinari."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupa jest zarchiwizowana. Nadal można zarządzać dostępem, ale nie można edytować bieżących danych."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpulan telah diarkibkan. Hak akses masih boleh diurus, tetapi data harian tidak boleh diedit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De groep is gearchiveerd. Je kunt toegang nog beheren, maar gewone gegevens niet bewerken."
          }
        }
      }
    },
