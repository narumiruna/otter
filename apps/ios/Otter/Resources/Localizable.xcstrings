            "value": "Tên tối đa 80 ký tự. Token hết hạn sau 90 ngày kể từ khi tạo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad en fazla 80 karakter olabilir. Token, oluşturulduktan 90 gün sonra sona erer."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanggang 80 karakter ang pangalan. Mag-e-expire ang token 90 araw matapos gawin."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อยาวได้ไม่เกิน 80 ตัวอักษร โทเคนหมดอายุหลังสร้าง 90 วัน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
