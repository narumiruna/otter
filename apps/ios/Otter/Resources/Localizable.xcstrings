            "value": "El identificador de cuenta o grupo de los datos de este dispositivo no es válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant de compte ou de groupe des données de cet appareil est invalide."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O identificador de conta ou grupo dos dados deste dispositivo é inválido."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitas akun atau grup dalam data perangkat ini tidak valid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konto- oder Gruppen-ID der Daten auf diesem Gerät ist ungültig."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định danh tài khoản hoặc nhóm trong dữ liệu thiết bị này không hợp lệ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki verilerin hesap veya grup kimliği geçersiz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi wasto ang pagkakakilanlan ng account o grupo sa datos ng device na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลระบุบัญชีหรือกลุ่มในข้อมูลของอุปกรณ์นี้ไม่ถูกต้อง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ID dell'account o del gruppo nei dati di questo dispositivo non è valido."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Identyfikator konta lub grupy w danych tego urządzenia jest nieprawidłowy."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Identiti akaun atau kumpulan dalam data peranti ini tidak sah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De account- of groeps-ID in de gegevens op dit apparaat is ongeldig."
          }
        }
      }
    },
    "本機資料格式較新（版本 %lld）。請更新 App；不會清除資料或同步。": {
      "comment": "native.expenseQueue.unsupportedVersion. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機資料格式較新（版本 %1$lld）。請更新 App；不會清除資料或同步。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local data uses a newer format (version %1$lld). Update the app. Data will not be cleared or synced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルデータは新しい形式（バージョン%1$lld）です。アプリを更新してください。データの消去や同期は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 데이터가 더 새로운 형식입니다(버전 %1$lld). 앱을 업데이트하세요. 데이터를 지우거나 동기화하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय डेटा का प्रारूप नया है (संस्करण %1$lld)। ऐप अपडेट करें; डेटा हटाया या सिंक नहीं किया जाएगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato de los datos locales es más reciente (versión %1$lld). Actualiza la aplicación; no se borrarán ni sincronizarán los datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format des données locales est plus récent (version %1$lld). Mettez l’application à jour ; les données ne seront ni effacées ni synchronisées."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato dos dados locais é mais recente (versão %1$lld). Atualize o aplicativo; os dados não serão apagados nem sincronizados."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format data lokal lebih baru (versi %1$lld). Perbarui aplikasi; data tidak akan dihapus atau disinkronkan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Datenformat ist neuer (Version %1$lld). Aktualisiere die App. Daten werden weder gelöscht noch synchronisiert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định dạng dữ liệu cục bộ mới hơn (phiên bản %1$lld). Hãy cập nhật ứng dụng; sẽ không xóa dữ liệu hoặc đồng bộ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel veri biçimi daha yeni (sürüm %1$lld). Uygulamayı güncelleyin; veriler temizlenmez veya eşitlenmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas bago ang format ng lokal na datos (bersyon %1$lld). I-update ang app; hindi iki-clear o isi-sync ang datos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบข้อมูลในอุปกรณ์เป็นรุ่นใหม่กว่า (เวอร์ชัน %1$lld) โปรดอัปเดตแอป จะไม่ลบข้อมูลหรือซิงค์"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato dei dati locali è più recente (versione %1$lld). Aggiorna l'app. I dati non verranno cancellati né sincronizzati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalny format danych jest nowszy (wersja %1$lld). Zaktualizuj aplikację. Dane nie zostaną usunięte ani zsynchronizowane."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Format data setempat lebih baharu (versi %1$lld). Kemas kini aplikasi; data tidak akan dikosongkan atau disegerakkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lokale gegevensformaat is nieuwer (versie %1$lld). Werk de app bij. Gegevens worden niet gewist of gesynchroniseerd."
          }
        }
      }
    },
    "本機草稿資料無法驗證，已停止讀取與同步，未刪除原檔。": {
      "comment": "native.expenseQueue.corruptData. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機草稿資料無法驗證，已停止讀取與同步，未刪除原檔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local draft data could not be validated. Reading and sync have stopped. The original file was not deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの下書きデータを検証できないため、読み取りと同期を停止しました。元のファイルは削除していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 초안 데이터를 검증할 수 없어 읽기와 동기화를 중지했습니다. 원본 파일은 삭제하지 않았습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय ड्राफ़्ट डेटा का सत्यापन नहीं हो सका। पढ़ना और सिंक रोक दिया गया; मूल फ़ाइल नहीं हटाई गई।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden verificar los datos del borrador local. Se han detenido la lectura y la sincronización; el archivo original no se ha eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données du brouillon local ne peuvent pas être vérifiées. La lecture et la synchronisation sont arrêtées ; le fichier d’origine n’a pas été supprimé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar os dados do rascunho local. A leitura e a sincronização foram interrompidas; o arquivo original não foi excluído."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data draf lokal tidak dapat diverifikasi. Pembacaan dan sinkronisasi dihentikan; berkas asli tidak dihapus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Entwurfsdaten konnten nicht geprüft werden. Lesen und Synchronisierung wurden gestoppt. Die ursprüngliche Datei wurde nicht gelöscht."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác thực dữ liệu bản nháp cục bộ. Đã dừng đọc và đồng bộ, chưa xóa tệp gốc."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel taslak verileri doğrulanamadı. Okuma ve eşitleme durduruldu; orijinal dosya silinmedi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mapatunayan ang lokal na datos ng draft. Itinigil ang pagbasa at pag-sync; hindi binura ang orihinal na file."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบความถูกต้องของข้อมูลฉบับร่างในอุปกรณ์ไม่ได้ หยุดอ่านและซิงค์แล้ว โดยไม่ได้ลบไฟล์เดิม"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare i dati delle bozze locali. Lettura e sincronizzazione sono state fermate. Il file originale non è stato eliminato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zweryfikować lokalnych danych szkiców. Odczyt i synchronizacja zostały zatrzymane. Nie usunięto pierwotnego pliku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data draf setempat tidak dapat disahkan. Pembacaan dan penyegerakan dihentikan; fail asal tidak dipadamkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan lokale conceptgegevens niet controleren. Lezen en synchroniseren zijn gestopt. Het oorspronkelijke bestand is niet verwijderd."
          }
        }
      }
    },
    "此本機草稿已被移除，請重新載入。": {
      "comment": "native.expenseQueue.notFound. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此本機草稿已被移除，請重新載入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local draft has been removed. Reload."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカルの下書きは削除されています。再読み込みしてください。"
