    "在瀏覽器開啟供應商登入頁": {
      "comment": "native.aiSettingsView.openProviderLogin. Application-owned text. Exact Web contract: aiOpenSignIn.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟登入頁面"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open sign-in page"
          }
        },
        "ja": {
          "stringUnit": {
