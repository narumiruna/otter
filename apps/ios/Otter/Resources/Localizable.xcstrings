          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen met de link kan bewerken"
          }
        }
      }
    },
    "任何持有連結者可檢視群組，但不能修改資料。部分付款與管理資料不會公開。": {
      "comment": "native.accessSettingsView.readOnlyNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何持有連結者可檢視群組，但不能修改資料。部分付款與管理資料不會公開。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with the link can view the group, but cannot change data. Some payment and administrative data will not be made public."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを持つ人は誰でもグループを閲覧できますが、データは変更できません。支払いと管理に関する一部のデータは公開されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 가진 사람은 누구나 그룹을 볼 수 있지만 데이터는 변경할 수 없습니다. 일부 결제 및 관리 데이터는 공개되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक रखने वाला कोई भी व्यक्ति समूह देख सकता है, लेकिन डेटा बदल नहीं सकता। भुगतान और प्रबंधन के कुछ डेटा सार्वजनिक नहीं होंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que tenga el enlace puede ver el grupo, pero no modificar los datos. Algunos datos de pagos y administración no se harán públicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne disposant du lien peut consulter le groupe, mais pas modifier les données. Certaines données de paiement et de gestion ne sont pas publiques."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com o link pode visualizar o grupo, mas não modificar os dados. Alguns dados de pagamento e administração não serão públicos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun yang memiliki tautan dapat melihat grup, tetapi tidak dapat mengubah data. Sebagian data pembayaran dan administrasi tidak akan dipublikasikan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder mit dem Link kann die Gruppe ansehen, aber keine Daten ändern. Bestimmte Zahlungs- und Verwaltungsdaten werden nicht veröffentlicht."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ ai có liên kết đều có thể xem nhóm, nhưng không thể thay đổi dữ liệu. Một số dữ liệu thanh toán và quản trị sẽ không được công khai."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıya sahip herkes grubu görebilir ancak verileri değiştiremez. Bazı ödeme ve yönetim verileri herkese açık değildir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinumang may hawak ng link ay makakatingin sa grupo, pero hindi makakabago ng datos. Hindi ilalantad ang ilang datos sa pagbabayad at pamamahala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนที่มีลิงก์ดูกลุ่มได้ แต่แก้ไขข้อมูลไม่ได้ ข้อมูลการชำระเงินและการจัดการบางส่วนจะไม่เปิดเผย"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque possieda il link può visualizzare il gruppo, ma non modificare i dati. Alcuni dati di pagamento e gestione non sono pubblici."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy posiadacz linku może wyświetlać grupę, ale nie może zmieniać danych. Część danych płatniczych i administracyjnych nie jest publiczna."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa yang mempunyai pautan boleh melihat kumpulan, tetapi tidak boleh mengubah data. Sesetengah data pembayaran dan pentadbiran tidak akan didedahkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen met de link kan de groep bekijken, maar geen gegevens wijzigen. Sommige betalings- en beheergegevens zijn niet openbaar."
          }
        }
      }
    },
    "持有連結者登入後會加入群組，取得編輯者權限。撤銷連結不會移除已加入的帳號。": {
      "comment": "native.accessSettingsView.signedInEditNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持有連結者登入後會加入群組，取得編輯者權限。撤銷連結不會移除已加入的帳號。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with the link will join the group with editor access after signing in. Revoking the link does not remove accounts that already joined."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを持つ人はログイン後にグループに参加し、編集者の権限を取得します。リンクを取り消しても、参加済みのアカウントは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 가진 사람은 로그인 후 그룹에 참여하여 편집자 권한을 얻습니다. 링크를 취소해도 이미 참여한 계정은 제거되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक रखने वाले साइन इन करने पर समूह से जुड़ेंगे और संपादक के अधिकार पाएँगे। लिंक रद्द करने से जुड़ चुके खाते नहीं हटेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien tenga el enlace se unirá al grupo con permisos de editor tras iniciar sesión. Revocar el enlace no eliminará las cuentas que ya se hayan unido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes disposant du lien rejoignent le groupe avec les droits d’éditeur après connexion. Révoquer le lien ne supprime pas les comptes qui ont déjà rejoint le groupe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem tiver o link entrará no grupo com permissões de editor após fazer login. Revogar o link não remove as contas que já entraram."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemegang tautan akan bergabung dengan grup setelah masuk dan memperoleh izin penyunting. Mencabut tautan tidak menghapus akun yang telah bergabung."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer den Link besitzt, tritt nach der Anmeldung der Gruppe bei und erhält Bearbeitungsrechte. Das Widerrufen des Links entfernt keine bereits beigetretenen Konten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người giữ liên kết sẽ tham gia nhóm sau khi đăng nhập và nhận quyền chỉnh sửa. Thu hồi liên kết không xóa tài khoản đã tham gia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıya sahip kişiler giriş yaptıktan sonra gruba katılır ve düzenleyici yetkisi alır. Bağlantıyı iptal etmek katılmış hesapları kaldırmaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasali sa grupo at magkakaroon ng karapatang mag-edit ang may hawak ng link kapag nag-sign in. Hindi aalisin ng pagbawi sa link ang mga account na sumali na."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ที่มีลิงก์จะเข้าร่วมกลุ่มและได้รับสิทธิ์ผู้แก้ไขเมื่อลงชื่อเข้าใช้ การเพิกถอนลิงก์จะไม่นำบัญชีที่เข้าร่วมแล้วออก"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi possiede il link entra nel gruppo dopo l'accesso e ottiene i permessi di editor. Revocare il link non rimuove gli account già entrati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiadacz linku po zalogowaniu dołączy do grupy z uprawnieniami edytora. Unieważnienie linku nie usuwa kont, które już dołączyły."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemegang pautan akan menyertai kumpulan selepas log masuk dan mendapat kebenaran penyunting. Membatalkan pautan tidak mengalih keluar akaun yang telah menyertai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie de link heeft, treedt na aanmelding toe tot de groep en krijgt bewerkersrechten. Het intrekken van de link verwijdert geen accounts die al zijn toegetreden."
          }
        }
      }
    },
    "任何持有連結者不必登入即可修改日常資料，包括支出與參與者。不能管理存取權或執行擁有者操作。請確認您接受此風險。": {
      "comment": "native.accessSettingsView.anyoneEditNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何持有連結者不必登入即可修改日常資料，包括支出與參與者。不能管理存取權或執行擁有者操作。請確認您接受此風險。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with the link can change everyday data, including expenses and participants, without signing in. They cannot manage access or perform owner operations. Confirm that you accept this risk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを持つ人は誰でも、ログインせずに支出や参加者などの日常のデータを変更できます。アクセス権の管理や所有者専用の操作はできません。このリスクを受け入れることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 가진 사람은 누구나 로그인 없이 지출과 참여자를 포함한 일상 데이터를 변경할 수 있습니다. 접근 권한 관리나 소유자 전용 작업은 할 수 없습니다. 이 위험을 수락하는지 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक रखने वाला कोई भी व्यक्ति बिना साइन इन किए रोज़मर्रा का डेटा, खर्च और सहभागी बदल सकता है। वह पहुँच अधिकारों का प्रबंधन या स्वामी की कार्रवाइयाँ नहीं कर सकता। पुष्टि करें कि आप यह जोखिम स्वीकार करते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que tenga el enlace puede modificar los datos cotidianos, incluidos gastos y participantes, sin iniciar sesión. No podrá gestionar el acceso ni realizar operaciones del propietario. Confirma que aceptas este riesgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne disposant du lien peut modifier les données courantes, dont les dépenses et les participants, sans se connecter. Elle ne peut pas gérer l’accès ni effectuer les opérations du propriétaire. Confirmez que vous acceptez ce risque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com o link pode modificar os dados cotidianos, incluindo despesas e participantes, sem fazer login. Não poderá gerenciar o acesso nem realizar operações do proprietário. Confirme que aceita este risco."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun yang memiliki tautan dapat mengubah data sehari-hari, termasuk pengeluaran dan peserta, tanpa masuk. Mereka tidak dapat mengelola hak akses atau melakukan operasi pemilik. Pastikan Anda menerima risiko ini."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder mit dem Link kann ohne Anmeldung Alltagsdaten einschließlich Ausgaben und Teilnehmer ändern. Zugriffsrechte können nicht verwaltet und Eigentümeraktionen nicht ausgeführt werden. Bestätige, dass du dieses Risiko akzeptierst."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ ai có liên kết đều có thể thay đổi dữ liệu hằng ngày, gồm khoản chi và người tham gia, mà không cần đăng nhập. Họ không thể quản lý quyền truy cập hoặc thực hiện thao tác của chủ sở hữu. Hãy xác nhận bạn chấp nhận rủi ro này."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıya sahip herkes giriş yapmadan giderler ve katılımcılar dahil günlük verileri değiştirebilir. Erişim haklarını yönetemez veya sahibe özel işlemleri yapamaz. Bu riski kabul ettiğinizden emin olun."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinumang may hawak ng link ay maaaring baguhin ang pang-araw-araw na datos, kabilang ang gastos at mga kalahok, kahit hindi naka-sign in. Hindi sila maaaring mamahala ng pag-access o magsagawa ng mga pagkilos ng may-ari. Tiyaking tinatanggap mo ang panganib na ito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนที่มีลิงก์แก้ไขข้อมูลประจำวัน รวมถึงรายจ่ายและผู้ร่วมรายจ่ายได้โดยไม่ต้องลงชื่อเข้าใช้ แต่จัดการสิทธิ์เข้าถึงหรือทำรายการที่สงวนไว้สำหรับเจ้าของไม่ได้ โปรดยืนยันว่าคุณยอมรับความเสี่ยงนี้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque possieda il link può modificare i dati ordinari, comprese spese e partecipanti, senza accedere. Non può gestire l'accesso né eseguire operazioni riservate al proprietario. Conferma di accettare questo rischio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy posiadacz linku może bez logowania zmieniać bieżące dane, w tym wydatki i uczestników. Nie może zarządzać dostępem ani wykonywać operacji właściciela. Upewnij się, że akceptujesz to ryzyko."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa yang mempunyai pautan boleh mengubah data harian, termasuk perbelanjaan dan peserta, tanpa log masuk. Mereka tidak boleh mengurus hak akses atau melakukan operasi pemilik. Pastikan anda menerima risiko ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen met de link kan zonder aanmelding gewone gegevens wijzigen, waaronder uitgaven en deelnemers. Ze kunnen geen toegang beheren of eigenaarsbewerkingen uitvoeren. Bevestig dat je dit risico aanvaardt."
          }
        }
      }
    },
