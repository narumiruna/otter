    "缺少支出版本，請重新載入後再試。": {
      "comment": "native.apiError.missingVersion. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少支出版本，請重新載入後再試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expense version is missing. Reload and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出のバージョンがありません。再読み込みしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출 버전이 없습니다. 다시 불러온 후 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च का संस्करण नहीं है। दोबारा लोड करके फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la versión del gasto. Vuelve a cargar y reinténtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de la dépense est manquante. Rechargez, puis réessayez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão da despesa está ausente. Recarregue e tente novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi pengeluaran tidak tersedia. Muat ulang, lalu coba lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabenversion fehlt. Lade erneut und versuche es noch einmal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiếu phiên bản khoản chi, hãy tải lại rồi thử lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gider sürümü eksik. Yeniden yükleyip tekrar deneyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala ang bersyon ng gastos. I-load muli at subukan ulit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเวอร์ชันรายจ่าย โปรดโหลดใหม่แล้วลองอีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca la versione della spesa. Ricarica e riprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje wersji wydatku. Wczytaj ponownie i spróbuj jeszcze raz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi perbelanjaan tiada. Muat semula dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgavenversie ontbreekt. Laad opnieuw en probeer nogmaals."
          }
        }
      }
    },
    "登入已到期、撤銷或無效，請重新登入。": {
      "comment": "native.apiError.unauthorized. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入已到期、撤銷或無效，請重新登入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in has expired, been revoked, or is invalid. Sign in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインが期限切れ、取り消し済み、または無効です。再度ログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 만료되었거나 취소되었거나 유효하지 않습니다. 다시 로그인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन समाप्त, रद्द या अमान्य है। फिर साइन इन करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión ha caducado, se ha revocado o no es válida. Inicia sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session a expiré, a été révoquée ou est invalide. Reconnectez-vous."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão expirou, foi revogada ou é inválida. Entre novamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi masuk telah kedaluwarsa, dicabut, atau tidak valid. Masuk lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist abgelaufen, widerrufen oder ungültig. Melde dich erneut an."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập đã hết hạn, bị thu hồi hoặc không hợp lệ, hãy đăng nhập lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişin süresi doldu, iptal edildi veya geçersiz. Yeniden giriş yapın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire, nabawi o hindi wasto ang pag-sign in. Mag-sign in muli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้หมดอายุ ถูกเพิกถอน หรือไม่ถูกต้อง โปรดลงชื่อเข้าใช้ใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso è scaduto, revocato o non valido. Accedi di nuovo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie wygasło, zostało unieważnione lub jest nieprawidłowe. Zaloguj się ponownie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk telah tamat tempoh, dibatalkan atau tidak sah. Sila log masuk semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmelding is verlopen, ingetrokken of ongeldig. Meld je opnieuw aan."
          }
        }
      }
    },
    "伺服器回傳的資料無法讀取，請確認網址與伺服器版本。": {
      "comment": "native.apiError.invalidResponse. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器回傳的資料無法讀取，請確認網址與伺服器版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read the data returned by the server. Check the URL and server version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから返されたデータを読み取れません。URLとサーバーのバージョンを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 반환한 데이터를 읽을 수 없습니다. URL과 서버 버전을 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर से मिला डेटा पढ़ा नहीं जा सकता। URL और सर्वर का संस्करण जाँचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden leer los datos devueltos por el servidor. Comprueba la URL y la versión del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données renvoyées par le serveur sont illisibles. Vérifiez l’URL et la version du serveur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os dados retornados pelo servidor. Confira a URL e a versão do servidor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data yang dikembalikan server tidak dapat dibaca. Periksa URL dan versi server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vom Server gelieferten Daten können nicht gelesen werden. Prüfe URL und Serverversion."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc dữ liệu máy chủ trả về, hãy kiểm tra URL và phiên bản máy chủ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunun döndürdüğü veriler okunamıyor. URL adresini ve sunucu sürümünü kontrol edin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa ang datos na ibinalik ng server. Suriin ang URL at bersyon ng server."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านข้อมูลที่เซิร์ฟเวอร์ส่งกลับไม่ได้ โปรดตรวจสอบ URL และเวอร์ชันเซิร์ฟเวอร์"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere i dati restituiti dal server. Controlla URL e versione del server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać danych zwróconych przez serwer. Sprawdź adres i wersję serwera."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data yang dikembalikan pelayan tidak dapat dibaca. Semak URL dan versi pelayan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de gegevens van de server niet lezen. Controleer de URL en serverversie."
          }
        }
      }
    },
    "此操作需要完整帳號登入，不能使用 API token 或分享憑證。": {
      "comment": "native.apiError.accountSessionRequired. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作需要完整帳號登入，不能使用 API token 或分享憑證。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation requires a full account sign-in. API token and shared credentials cannot be used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作には完全なアカウントログインが必要です。API tokenや共有用の認証情報は使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업에는 전체 계정 로그인이 필요합니다. API token이나 공유 자격 증명은 사용할 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कार्रवाई के लिए पूरे खाते का साइन इन चाहिए; API token या साझाकरण प्रमाण इस्तेमाल नहीं कर सकते।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta operación requiere un inicio de sesión completo con una cuenta; no se puede usar un API token ni credenciales de acceso compartido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette opération nécessite une connexion complète à un compte ; un API token ou des identifiants de partage ne peuvent pas être utilisés."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta operação exige login completo com uma conta; não é possível usar API token ou credenciais de compartilhamento."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi ini memerlukan masuk akun penuh; API token atau kredensial berbagi tidak dapat digunakan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Vorgang erfordert eine vollständige Kontoanmeldung. API token oder Freigabezugangsdaten können nicht verwendet werden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này yêu cầu đăng nhập tài khoản đầy đủ, không thể dùng API token hoặc thông tin xác thực chia sẻ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem tam hesap girişi gerektirir; API token veya paylaşım kimlik bilgileri kullanılamaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng buong pag-sign in sa account para rito; hindi magagamit ang API token o kredensyal ng pagbabahagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้ต้องลงชื่อเข้าใช้ด้วยบัญชีเต็มรูปแบบ ใช้ API token หรือข้อมูลรับรองการแชร์ไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione richiede l'accesso completo con un account. Non puoi usare un API token o credenziali di condivisione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta operacja wymaga pełnego zalogowania na konto. Nie można użyć API token ani danych dostępowych udostępniania."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi ini memerlukan log masuk akaun penuh; API token atau kelayakan perkongsian tidak boleh digunakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit vereist volledige accountaanmelding. Je kunt geen API token of deeltoegangsgegevens gebruiken."
          }
        }
      }
    },
    "請選擇不超過 5 MB 的 JPEG、PNG 或 WebP 收據圖片。": {
      "comment": "native.apiError.invalidReceipt. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇不超過 5 MB 的 JPEG、PNG 或 WebP 收據圖片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a JPEG, PNG, or WebP receipt image no larger than 5 MB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5 MB以下のJPEG、PNG、WebP形式の領収書画像を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5 MB 이하의 JPEG, PNG 또는 WebP 영수증 이미지를 선택하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 MB से बड़ी न होने वाली JPEG, PNG या WebP रसीद की तस्वीर चुनें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una imagen de recibo JPEG, PNG o WebP de un máximo de 5 MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une image de reçu JPEG, PNG ou WebP de 5 MB maximum."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma imagem de recibo JPEG, PNG ou WebP de até 5 MB."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gambar tanda terima JPEG, PNG, atau WebP yang tidak melebihi 5 MB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Belegbild im Format JPEG, PNG oder WebP mit höchstens 5 MB."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn ảnh biên lai JPEG, PNG hoặc WebP không quá 5 MB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 MB sınırını aşmayan bir JPEG, PNG veya WebP makbuz görseli seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng larawan ng resibo na JPEG, PNG o WebP na hindi lalampas sa 5 MB."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดเลือกรูปใบเสร็จ JPEG, PNG หรือ WebP ขนาดไม่เกิน 5 MB"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un'immagine della ricevuta JPEG, PNG o WebP non superiore a 5 MB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz obraz paragonu JPEG, PNG lub WebP o rozmiarze nie większym niż 5 MB."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih imej resit JPEG, PNG atau WebP yang tidak melebihi 5 MB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een bonafbeelding in JPEG, PNG of WebP van maximaal 5 MB."
          }
        }
      }
    },
    "%@\n如需修改，請群組擁有者在網頁開啟「API 修改權限」。": {
      "comment": "native.apiError.apiWritesBlocked. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n如需修改，請群組擁有者在網頁開啟「API 修改權限」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nTo make changes, ask the group owner to enable “API write permission” on the web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n変更するには、グループの所有者にウェブで「API変更権限」を有効にしてもらってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n수정하려면 그룹 소유자에게 웹에서 ‘API 수정 권한’을 활성화해 달라고 요청하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nबदलाव के लिए समूह के स्वामी से वेब पर “API बदलाव अधिकार” चालू करने को कहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nPara modificar los datos, pide al propietario del grupo que active «Permisos de modificación por API» en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nPour modifier les données, demandez au propriétaire du groupe d’activer les « Droits de modification par API » sur le site web."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nPara modificar os dados, peça ao proprietário do grupo para ativar as “Permissões de modificação por API” na web."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nUntuk mengubah data, minta pemilik grup mengaktifkan “Izin perubahan API” di situs web."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nBitte den Gruppeneigentümer, auf der Website „API-Änderungsrechte“ zu aktivieren, wenn Änderungen erforderlich sind."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nĐể sửa dữ liệu, hãy nhờ chủ sở hữu nhóm bật “Quyền sửa qua API” trên trang web."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nDeğişiklik yapmak için grup sahibinden web sayfasında “API değiştirme yetkisi” seçeneğini açmasını isteyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nUpang makapagbago, ipabukas sa may-ari ng grupo ang “Karapatang magbago gamit ang API” sa web."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nหากต้องการแก้ไข ให้เจ้าของกลุ่มเปิด “สิทธิ์แก้ไขผ่าน API” บนเว็บ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nPer modificare, chiedi al proprietario del gruppo di attivare «Permessi di modifica API» sul sito web."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nAby wprowadzać zmiany, poproś właściciela grupy o włączenie „Uprawnienia do zmian przez API” na stronie internetowej."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nUntuk mengubah data, minta pemilik kumpulan mendayakan “Kebenaran perubahan API” pada laman web."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nVraag de groepseigenaar om ‘API-wijzigingsrechten’ op de website in te schakelen als je wilt wijzigen."
          }
        }
      }
    },
    "這筆支出已被修改。請重新載入，確認最新內容後再操作。": {
      "comment": "native.apiError.versionConflict. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆支出已被修改。請重新載入，確認最新內容後再操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This expense has been changed. Reload and check the latest content before continuing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この支出は変更されています。再読み込みし、最新の内容を確認してから操作してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지출은 이미 수정되었습니다. 다시 불러와 최신 내용을 확인한 후 작업하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह खर्च बदल दिया गया है। दोबारा लोड करें, नवीनतम सामग्री जाँचें, फिर कार्रवाई करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este gasto se ha modificado. Vuelve a cargar y comprueba el contenido más reciente antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette dépense a été modifiée. Rechargez et vérifiez le contenu le plus récent avant de continuer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta despesa foi modificada. Recarregue e confira o conteúdo mais recente antes de continuar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran ini telah diubah. Muat ulang dan konfirmasikan konten terbaru sebelum melakukan operasi lagi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ausgabe wurde geändert. Lade erneut und prüfe den aktuellen Inhalt, bevor du fortfährst."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoản chi này đã được sửa. Hãy tải lại và xác nhận nội dung mới nhất trước khi thao tác."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gider değiştirildi. Yeniden yükleyin ve işlem yapmadan önce en güncel içeriği kontrol edin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabago na ang gastos na ito. I-load muli at tiyakin ang pinakabagong nilalaman bago kumilos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายจ่ายนี้ถูกแก้ไขแล้ว โปรดโหลดใหม่และยืนยันข้อมูลล่าสุดก่อนดำเนินการ"
