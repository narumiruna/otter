    "重新載入": {
      "comment": "web.reload. Application-owned text. Exact Web contract: reload.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新載入"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로고침"
          }
        },
