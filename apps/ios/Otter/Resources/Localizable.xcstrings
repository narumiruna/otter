        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz co najmniej jednego członka do podziału kosztu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sekurang-kurangnya seorang ahli perkongsian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies minstens één deelnemer aan de verdeling."
          }
        }
      }
    },
    "佇列中的日期無效。請選擇有效支出日期。": {
      "comment": "native.expenseEditorState.dateValidation. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佇列中的日期無效。請選擇有效支出日期。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The queued date is invalid. Select a valid expense date."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュー内の日付は無効です。有効な支出日を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열의 날짜가 유효하지 않습니다. 유효한 지출 날짜를 선택하세요."
          }
