          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey kullanılamıyor. Associated Domains ve sunucu ayarlarını kontrol edin veya başka bir giriş yöntemi kullanın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi magamit ang Passkey. Suriin ang Associated Domains at mga setting ng server, o gumamit ng ibang paraan ng pag-sign in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ Passkey ไม่ได้ โปรดตรวจสอบ Associated Domains และการตั้งค่าเซิร์ฟเวอร์ หรือใช้วิธีลงชื่อเข้าใช้อื่น"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey non disponibile. Controlla Associated Domains e le impostazioni del server oppure usa un altro metodo di accesso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można użyć Passkey. Sprawdź Associated Domains i ustawienia serwera lub użyj innej metody logowania."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
