        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 읽을 수 없습니다. 다른 사진을 선택하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तस्वीर पढ़ी नहीं जा सकी। दूसरी तस्वीर चुनें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer la imagen. Selecciona otra foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’image. Choisissez une autre photo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a imagem. Selecione outra foto."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membaca gambar. Pilih foto lain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild konnte nicht gelesen werden. Wähle ein anderes Foto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc ảnh. Hãy chọn ảnh khác."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel okunamıyor. Başka bir fotoğraf seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa ang larawan. Pumili ng iba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านรูปภาพไม่ได้ โปรดเลือกรูปอื่น"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l'immagine. Scegli un'altra foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać obrazu. Wybierz inne zdjęcie."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membaca imej. Pilih foto lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan afbeelding niet lezen. Kies een andere foto."
          }
        }
      }
    },
