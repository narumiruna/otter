          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiền tệ cơ sở"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel para birimi"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Batayang salapi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สกุลเงินหลัก"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta di base"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waluta bazowa"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mata wang asas"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Basisvaluta"
          }
        }
      }
    },
    "變更基本幣別會清除群組自訂匯率。既有支出的匯率快照會保留；需要時再換算至新的基本幣別。": {
      "comment": "native.groupSettingsView.baseCurrencyNotice. Application-owned text.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更基本幣別會清除群組自訂匯率。既有支出的匯率快照會保留；需要時再換算至新的基本幣別。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the base currency clears the group's custom exchange rates. Existing expense rate snapshots are retained and converted to the new base currency when needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本通貨を変更すると、グループのカスタム為替レートは消去されます。既存の支出の為替レートのスナップショットは保持され、必要に応じて新しい基本通貨に換算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준 통화를 변경하면 그룹의 사용자 지정 환율이 지워집니다. 기존 지출의 환율 스냅샷은 유지되며 필요한 경우 새 기준 통화로 환산합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल मुद्रा बदलने से समूह की कस्टम विनिमय दरें हटेंगी। मौजूदा खर्चों के दर स्नैपशॉट रहेंगे; ज़रूरत होने पर नई मूल मुद्रा में बदले जाएँगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la moneda base borrará los tipos de cambio personalizados del grupo. Se conservarán las instantáneas de tipos de cambio de los gastos existentes; se convertirán a la nueva moneda base cuando sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer la devise de base effacera les taux de change personnalisés du groupe. Les instantanés de taux des dépenses existantes seront conservés ; ils seront convertis dans la nouvelle devise de base si nécessaire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a moeda base apagará as taxas de câmbio personalizadas do grupo. Os registros de taxas das despesas existentes serão mantidos; a conversão para a nova moeda base ocorrerá quando necessário."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah mata uang dasar akan menghapus kurs khusus grup. Rekaman kurs pengeluaran yang sudah ada dipertahankan; konversi ke mata uang dasar baru dilakukan saat diperlukan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ändern der Basiswährung werden benutzerdefinierte Gruppenkurse gelöscht. Wechselkurs-Momentaufnahmen vorhandener Ausgaben bleiben erhalten und werden bei Bedarf in die neue Basiswährung umgerechnet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi tiền tệ cơ sở sẽ xóa tỷ giá tùy chỉnh của nhóm. Bản chụp tỷ giá của khoản chi hiện có sẽ được giữ; khi cần sẽ quy đổi sang tiền tệ cơ sở mới."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel para birimini değiştirmek grubun özel kurlarını temizler. Mevcut giderlerin kur anlık görüntüleri korunur; gerektiğinde yeni temel para birimine çevrilir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maki-clear ng pagbabago sa batayang salapi ang pasadyang palitan ng grupo. Pananatilihin ang mga snapshot ng palitan sa umiiral na gastos; iko-convert sa bagong batayang salapi kung kailangan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนสกุลเงินหลักจะล้างอัตราแลกเปลี่ยนที่กำหนดเองของกลุ่ม ภาพรวมอัตราแลกเปลี่ยนของรายจ่ายเดิมจะคงอยู่ และจะแปลงเป็นสกุลเงินหลักใหม่เมื่อจำเป็น"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare la valuta di base cancella i cambi personalizzati del gruppo. Le istantanee dei cambi delle spese esistenti restano e vengono convertite nella nuova valuta di base quando necessario."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana waluty bazowej usunie własne kursy grupy. Zapisy kursów istniejących wydatków zostaną zachowane. W razie potrzeby kwoty zostaną przeliczone na nową walutę bazową."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah mata wang asas akan mengosongkan kadar tukaran tersuai kumpulan. Petikan kadar tukaran perbelanjaan sedia ada dikekalkan; penukaran kepada mata wang asas baharu dilakukan apabila perlu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigen van de basisvaluta wist de aangepaste groepskoersen. Wisselkoersmomentopnamen van bestaande uitgaven blijven behouden en worden indien nodig naar de nieuwe basisvaluta omgerekend."
          }
        }
      }
    },
