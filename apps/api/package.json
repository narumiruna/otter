{
  "name": "@narumitw/otter-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace @narumitw/otter-contracts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && cp -R db dist/db",
    "dev": "tsx watch --include ../../packages/core/dist --include ../../packages/contracts/dist src/server.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "pretypecheck": "npm run build --workspace @narumitw/otter-contracts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "pretest": "npm run build --workspace @narumitw/otter-contracts",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@narumitw/otter-contracts": "0.1.0",
    "@narumitw/otter-core": "0.1.0",
    "@simplewebauthn/server": "^14.0.2",
    "hono": "^4.13.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
