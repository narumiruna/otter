{
  "name": "@narumitw/otter-cli",
  "version": "0.2.0",
  "private": false,
  "description": "Non-interactive CLI for managing Otter travel and shared expenses",
  "type": "module",
  "bin": {
    "otter": "dist/otter.cjs"
  },
  "files": [
    "dist/otter.cjs"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace @narumitw/otter-contracts",
    "build": "esbuild src/main.ts --bundle --format=cjs --log-level=warning --outfile=dist/otter.cjs --platform=node --target=node20",
    "predev": "npm run build --workspace @narumitw/otter-contracts",
    "dev": "tsx src/main.ts",
    "pretypecheck": "npm run build --workspace @narumitw/otter-contracts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build --workspace @narumitw/otter-contracts",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/otter.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/narumiruna/otter#readme",
  "bugs": "https://github.com/narumiruna/otter/issues",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@narumitw/otter-contracts": "0.1.0",
    "@narumitw/otter-core": "0.1.0",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.28.2",
    "proper-lockfile": "^4.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
