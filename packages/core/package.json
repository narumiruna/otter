{
  "name": "@narumitw/otter-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./backup": {
      "types": "./dist/backup.d.ts",
      "import": "./dist/backup.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "import": "./dist/date.js"
    },
    "./expense-metadata": {
      "types": "./dist/expense-metadata.d.ts",
      "import": "./dist/expense-metadata.js"
    },
    "./expense-splits": {
      "types": "./dist/expense-splits.d.ts",
      "import": "./dist/expense-splits.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js"
    },
    "./settlement": {
      "types": "./dist/settlement.d.ts",
      "import": "./dist/settlement.js"
    },
    "./username": {
      "types": "./dist/username.d.ts",
      "import": "./dist/username.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
